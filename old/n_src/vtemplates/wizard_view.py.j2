appbuilder.add_view(
    {{ table_name|capitalize }}WizardView,
    "{{ table_name|capitalize }} Wizard",
    icon="{{ config.get('icon', 'fa-magic') }}",
    category="Wizards",
    category_icon="fa-tasks"
)
