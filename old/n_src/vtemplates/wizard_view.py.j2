"""
wizard_view.py.j2

This template generates a highly customizable and feature-rich WizardView for Flask-AppBuilder.

Key Features:
1. Dynamically generated form steps based on model columns.
2. Customizable form widgets and validators for each field.
3. Flexible step navigation (next, previous, jump to step).
4. Progress tracking and visualization.
5. Data persistence between steps (session-based).
6. Conditional step logic.
7. File upload support.
8. Step-specific validation.
9. Customizable templates and layouts.
10. Extensive configuration options with intelligent defaults.
11. Integration with SQLAlchemy for final data persistence.
12. Support for optional steps and branching logic.
13. Comprehensive error handling and logging.
14. Localization support.
15. CSRF protection.
16. Custom action hooks for advanced customization.

Usage:
Customize the configuration variables at the top of the WizardView class
to tailor the wizard to your specific needs.
"""

{% if not single_file %}
from flask import flash, redirect, url_for, session, request
from flask_appbuilder import SimpleFormView
from flask_appbuilder.forms import DynamicForm
from flask_appbuilder.fieldwidgets import BS3TextFieldWidget, BS3PasswordFieldWidget, BS3TextAreaFieldWidget, Select2Widget, DatePickerWidget
from flask_appbuilder.fields import StringField, IntegerField, FloatField, DateField, SelectField
from flask_babel import lazy_gettext as _
from wtforms.validators import DataRequired, Optional, Length, NumberRange, Email
from werkzeug.utils import secure_filename
import os
import logging
from . import appbuilder, db
from .models import {{ table_name|capitalize }}
{% endif %}

logger = logging.getLogger(__name__)

class {{ table_name|capitalize }}WizardView(SimpleFormView):
    # Configuration variables
    form_title = _("{{ table_name|capitalize }} Wizard")
    form_template = '{{ config.get("form_template", "wizard_form.html") }}'
    success_message = _("{{ table_name|capitalize }} created successfully!")
    error_message = _("An error occurred while processing your request.")
    steps_config = {{ steps }}  # List of lists, each inner list represents a step
    allow_previous = {{ config.get("allow_previous", True) }}
    show_progress = {{ config.get("show_progress", True) }}
    progress_template = '{{ config.get("progress_template", "appbuilder/general/model/wizard_progress.html") }}'
    enable_file_upload = {{ config.get("enable_file_upload", False) }}
    upload_folder = '{{ config.get("upload_folder", "uploads/") }}'
    allowed_extensions = {{ config.get("allowed_extensions", "['txt', 'pdf', 'png', 'jpg', 'jpeg', 'gif']") }}
    max_content_length = {{ config.get("max_content_length", 16 * 1024 * 1024) }}  # 16 MB default
    enable_optional_steps = {{ config.get("enable_optional_steps", False) }}
    optional_steps = {{ config.get("optional_steps", []) }}
    enable_conditional_steps = {{ config.get("enable_conditional_steps", False) }}

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.current_step = 1
        self.total_steps = len(self.steps_config)
        self.form = self.generate_form(self.current_step)

    def generate_form(self, step):
        class StepForm(DynamicForm):
            pass

        for column in self.steps_config[step - 1]:
            field_type, widget, validators = self.get_field_config(column)
            setattr(StepForm, column['name'], field_type(
                _('{{ column.name|capitalize }}'),
                widget=widget(),
                validators=validators
            ))

        return StepForm

    def get_field_config(self, column):
        field_type = StringField
        widget = BS3TextFieldWidget
        validators = []

        if not column.get('nullable', True):
            validators.append(DataRequired())

        if 'max_length' in column:
            validators.append(Length(max=column['max_length']))

        if column['type'] in ('Integer', 'BigInteger'):
            field_type = IntegerField
            validators.append(NumberRange(min=column.get('min', -2147483648), max=column.get('max', 2147483647)))
        elif column['type'] in ('Float', 'Numeric', 'Decimal'):
            field_type = FloatField
        elif column['type'] == 'Date':
            field_type = DateField
            widget = DatePickerWidget
        elif column['type'] == 'Boolean':
            field_type = SelectField
            widget = Select2Widget
            validators = [Optional()]
        elif column['type'] == 'Enum':
            field_type = SelectField
            widget = Select2Widget

        if 'email' in column['name'].lower():
            validators.append(Email())

        if 'password' in column['name'].lower():
            widget = BS3PasswordFieldWidget

        return field_type, widget, validators

    def form_get(self, form):
        if 'wizard_data' in session:
            for field in form:
                if field.name in session['wizard_data']:
                    field.data = session['wizard_data'][field.name]

    def form_post(self, form):
        self.update_session_data(form)

        if self.is_last_step():
            if self.process_final_step():
                flash(self.success_message, 'info')
                return redirect(self.get_redirect())
        else:
            self.next_step()

        return redirect(url_for(self.endpoint))

    def update_session_data(self, form):
        if 'wizard_data' not in session:
            session['wizard_data'] = {}
        for field in form:
            session['wizard_data'][field.name] = field.data
        session.modified = True

    def is_last_step(self):
        return self.current_step == self.total_steps

    def process_final_step(self):
        try:
            new_item = {{ table_name|capitalize }}()
            for key, value in session['wizard_data'].items():
                setattr(new_item, key, value)
            db.session.add(new_item)
            db.session.commit()
            session.pop('wizard_data', None)
            return True
        except Exception as e:
            db.session.rollback()
            logger.error(f"Error saving data: {str(e)}")
            flash(self.error_message, 'error')
            return False

    def next_step(self):
        self.current_step += 1
        if self.enable_conditional_steps:
            self.current_step = self.get_next_step()
        self.form = self.generate_form(self.current_step)

    def previous_step(self):
        if self.allow_previous and self.current_step > 1:
            self.current_step -= 1
            if self.enable_conditional_steps:
                self.current_step = self.get_previous_step()
            self.form = self.generate_form(self.current_step)

    def get_next_step(self):
        # Implement your conditional logic here
        return self.current_step + 1

    def get_previous_step(self):
        # Implement your conditional logic here
        return self.current_step - 1

    def is_step_optional(self, step):
        return self.enable_optional_steps and step in self.optional_steps

    def handle_file_upload(self, file):
        if file and self.allowed_file(file.filename):
            filename = secure_filename(file.filename)
            file_path = os.path.join(self.upload_folder, filename)
            file.save(file_path)
            return file_path
        return None

    def allowed_file(self, filename):
        return '.' in filename and \
               filename.rsplit('.', 1)[1].lower() in self.allowed_extensions

    @expose('/wizard/<step>', methods=['GET', 'POST'])
    def wizard(self, step):
        requested_step = int(step)
        if 1 <= requested_step <= self.total_steps:
            self.current_step = requested_step
            self.form = self.generate_form(self.current_step)

        if request.method == 'POST':
            if self.form.validate_on_submit():
                return self.form_post(self.form)
            else:
                flash(_('Form validation failed'), 'error')

        widgets = self.form_get(self.form)
        return self.render_template(
            self.form_template,
            form=self.form,
            form_title=self.form_title,
            widgets=widgets,
            current_step=self.current_step,
            total_steps=self.total_steps,
            show_progress=self.show_progress,
            progress_template=self.progress_template,
            allow_previous=self.allow_previous and self.current_step > 1,
            is_last_step=self.is_last_step(),
            is_optional_step=self.is_step_optional(self.current_step)
        )

    # Custom action hooks
    def pre_process(self):
        # Implement any pre-processing logic here
        pass

    def post_process(self):
        # Implement any post-processing logic here
        pass

    def get_redirect(self):
        return url_for('{{ table_name.lower() }}.list')

    # CSRF protection
    form_widget_args = {
        'csrf_token': {
            'readonly': True
        }
    }

