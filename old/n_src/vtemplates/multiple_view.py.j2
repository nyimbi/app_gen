from flask import url_for, request
from flask_appbuilder import MultipleView
from flask_appbuilder.models.sqla.interface import SQLAInterface
from flask_appbuilder.widgets import MultipleViewWidget
from flask_babel import lazy_gettext as _
from . import appbuilder
from .models import {{ table_name|capitalize }}
{% for related_view in related_views %}
from .{{ related_view.lower() }} import {{ related_view }}
{% endfor %}
{% endif %}

class Custom{{ table_name|capitalize }}MultipleViewWidget(MultipleViewWidget):
    """
    Custom widget for {{ table_name|capitalize }} MultipleView
    """
    template = 'custom_multiple_view.html'

class {{ table_name|capitalize }}MultipleView(MultipleView):
    """
    This MultipleView combines the {{ table_name|capitalize }} view with its related views.
    """

    # Define the views to be included in this MultipleView
    views = [
        ("{{ table_name|capitalize }}", {{ table_name|capitalize }}ModelView),
        {% for related_view in related_views %}
        ("{{ related_view.split('ModelView')[0] }}", {{ related_view }}),
        {% endfor %}
    ]

    # Configuration for the MultipleView
    route_base = "/{{ table_name.lower() }}_multiple"
    list_title = _("{{ table_name|capitalize }} Multiple View")
    show_title = _("{{ table_name|capitalize }} Details")
    add_title = _("Add {{ table_name|capitalize }}")
    edit_title = _("Edit {{ table_name|capitalize }}")

    # Define the tabs for each view
    tabs = [
        ("{{ table_name|capitalize }}", "{{ table_name|lower }}"),
        {% for related_view in related_views %}
        ("{{ related_view.split('ModelView')[0] }}", "{{ related_view.split('ModelView')[0].lower() }}"),
        {% endfor %}
    ]

    # Default view to show when accessing this MultipleView
    default_view = "{{ table_name|lower }}"

    # Custom CSS classes for the tabs
    tab_css_classes = {
        "{{ table_name|lower }}": "primary",
        {% for related_view in related_views %}
        "{{ related_view.split('ModelView')[0].lower() }}": "info",
        {% endfor %}
    }

    # Search across all included views
    search_columns = {
        "{{ table_name|lower }}": ["name", "description"],
        {% for related_view in related_views %}
        "{{ related_view.split('ModelView')[0].lower() }}": ["name"],
        {% endfor %}
    }

    # Custom titles for each view
    view_titles = {
        "{{ table_name|lower }}": _("{{ table_name|capitalize }} Information"),
        {% for related_view in related_views %}
        "{{ related_view.split('ModelView')[0].lower() }}": _("{{ related_view.split('ModelView')[0] }} Details"),
        {% endfor %}
    }

    # Specify which views can be added/edited/deleted from the MultipleView
    can_create = {
        "{{ table_name|lower }}": True,
        {% for related_view in related_views %}
        "{{ related_view.split('ModelView')[0].lower() }}": True,
        {% endfor %}
    }

    can_edit = {
        "{{ table_name|lower }}": True,
        {% for related_view in related_views %}
        "{{ related_view.split('ModelView')[0].lower() }}": True,
        {% endfor %}
    }

    can_delete = {
        "{{ table_name|lower }}": True,
        {% for related_view in related_views %}
        "{{ related_view.split('ModelView')[0].lower() }}": True,
        {% endfor %}
    }

    # Additional MultipleView properties
    widget = Custom{{ table_name|capitalize }}MultipleViewWidget
    nav_tab_class = "nav-tabs"
    id = "{{ table_name.lower() }}_multiple_view"
    endpoint = "{{ table_name.lower() }}_multiple"
    base_permissions = ['can_list', 'can_show', 'can_add', 'can_edit', 'can_delete']
    
    # URL parameters
    page_size = 20
    order_column = "id"
    order_direction = "asc"
    page = 1
    search = None

    # Custom handlers for specific events
    def pre_add(self, item):
        """
        Handler called before adding an item.
        """
        # Add custom logic here
        pass

    def post_add(self, item):
        """
        Handler called after adding an item.
        """
        # Add custom logic here
        pass

    def pre_update(self, item):
        """
        Handler called before updating an item.
        """
        # Add custom logic here
        pass

    def post_update(self, item):
        """
        Handler called after updating an item.
        """
        # Add custom logic here
        pass

    def pre_delete(self, item):
        """
        Handler called before deleting an item.
        """
        # Add custom logic here
        pass

    def post_delete(self, item):
        """
        Handler called after deleting an item.
        """
        # Add custom logic here
        pass

    @expose('/custom_action')
    def custom_action(self):
        """
        Custom action for this MultipleView
        """
        # Add custom logic here
        pass

    def get_redirect(self):
        """
        Override redirect method
        """
        return super({{ table_name|capitalize }}MultipleView, self).get_redirect()

    def _get_view_widget(self, **kwargs):
        """
        Override to use custom widget
        """
        return self.widget(endpoint=self.endpoint, **kwargs)

    def render_template(self, template, appbuilder, **kwargs):
        """
        Override template rendering
        """
        return super({{ table_name|capitalize }}MultipleView, self).render_template(template, appbuilder, **kwargs)

{% if not single_file %}
