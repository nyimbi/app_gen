class {{ table_name }}ReportView(ModelView):
    datamodel = SQLAInterface({{ table_name }})
    base_order = ('{{ columns[0].name }}', 'asc')
    base_filters = [['{{ columns[0].name }}', FilterStartsWith, '']]

    list_title = '{{ table_name }} Report'
    show_title = 'Report Details'
    list_widget = ListWidget(label_columns={'{{ columns[0].name }}': '{{ columns[0].name|capitalize }}'})
    show_widget = ShowWidget()

    list_columns = [{% for column in columns %}{% if not column.primary_key %}'{{ column.name }}'{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]
    search_columns = [{% for column in columns %}{% if not column.primary_key %}'{{ column.name }}'{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]

    @action("export_csv", "Export CSV", "Export all results to CSV?", "fa-file-text-o", single=False)
    def export_csv(self, items):
        if not items:
            flash("No records found", "info")
            return redirect(url_for('{{ table_name.lower() }}reportview.list'))

        output = io.StringIO()
        writer = csv.writer(output)

        # Write header
        writer.writerow(self.list_columns)

        # Write data
        for item in items:
            row = [getattr(item, col) for col in self.list_columns]
            writer.writerow(row)

        response = send_file(
            io.BytesIO(output.getvalue().encode()),
            mimetype='text/csv',
            as_attachment=True,
            attachment_filename='{{ table_name.lower() }}_report.csv'
        )

        return response

    @action("summary_report", "Summary Report", "Generate summary report?", "fa-bar-chart", single=False)
    def summary_report(self, items):
        if not items:
            flash("No records found", "info")
            return redirect(url_for('{{ table_name.lower() }}reportview.list'))

        summary = {}
        for column in self.list_columns:
            if isinstance(getattr({{ table_name }}, column).type, (db.Integer, db.Float, db.Numeric)):
                summary[column] = {
                    'avg': db.session.query(func.avg(getattr({{ table_name }}, column))).scalar(),
                    'sum': db.session.query(func.sum(getattr({{ table_name }}, column))).scalar(),
                    'min': db.session.query(func.min(getattr({{ table_name }}, column))).scalar(),
                    'max': db.session.query(func.max(getattr({{ table_name }}, column))).scalar()
                }
            elif isinstance(getattr({{ table_name }}, column).type, db.String):
                summary[column] = {
                    'distinct_count': db.session.query(func.count(func.distinct(getattr({{ table_name }}, column)))).scalar()
                }

        self.update_redirect()
        return self.render_template(
            'report_summary.html',
            summary=summary,
            title='Summary Report for {{ table_name }}'
        )

class {{ table_name }}RChartView(GroupByChartView):
    datamodel = SQLAInterface({{ table_name }})
    chart_title = 'Grouped {{ table_name }} Chart'

    definitions = [
        {
            'label': 'Count of {{ columns[0].name }}',
            'group': '{{ columns[0].name }}',
            'series': [(aggregate_count, '{{ columns[0].name }}')]
        },
        {% for column in columns %}
        {% if column.type.startswith('INTEGER') or column.type.startswith('NUMERIC') %}
        {
            'label': 'Avg of {{ column.name }}',
            'group': '{{ columns[0].name }}',
            'series': [(aggregate_avg, '{{ column.name }}')]
        },
        {% endif %}
        {% endfor %}
    ]

