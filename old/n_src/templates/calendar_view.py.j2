class {{ table_name }}CalendarView(ModelView):
    datamodel = SQLAInterface({{ table_name }})
    base_order = ('{{ date_columns[0] }}', 'asc')
    
    # Assuming the first date column is the primary one for the calendar
    default_date_field = '{{ date_columns[0] }}'
    date_fields = [{% for col in date_columns %}'{{ col }}'{% if not loop.last %}, {% endif %}{% endfor %}]

    list_title = '{{ table_name }} Calendar'
    show_title = 'Event Details'

    # Add any additional configurations here
    # For example:
    # list_columns = ['title', 'start_date', 'end_date', 'description']
    # edit_columns = ['title', 'start_date', 'end_date', 'description']
    # show_columns = ['title', 'start_date', 'end_date', 'description']

    @expose('/calendar/')
    @has_access
    def calendar(self):
        widgets = self._get_calendar_widget()
        return render_template(
            'calendar_view.html',
            title=self.list_title,
            widgets=widgets,
            appbuilder=self.appbuilder,
            date_fields=self.date_fields,
            default_date_field=self.default_date_field
        )

    @expose('/calendar/events/')
    @has_access
    def calendar_events(self):
        start_date = request.args.get('start', '')
        end_date = request.args.get('end', '')
        date_field = request.args.get('date_field', self.default_date_field)

        if start_date and end_date:
            query = self.datamodel.session.query({{ table_name }}).filter(
                getattr({{ table_name }}, date_field) >= start_date,
                getattr({{ table_name }}, date_field) <= end_date
            )
            events = []
            for item in query.all():
                event = {
                    'id': item.id,
                    'title': str(item),  # Customize this based on your model
                    'start': getattr(item, date_field).isoformat(),
                    'url': f"{request.script_root}{self.show_url}?id={item.id}"
                }
                # Add end date if it exists
                if hasattr(item, 'end_date'):
                    event['end'] = item.end_date.isoformat()
                events.append(event)
            return jsonify(events)
        return jsonify([])

    def _get_calendar_widget(self):
        date_field_form = FormWidget()
        date_field_form.template = 'calendar_date_field_form.html'
        date_field_form.date_field = SelectField(
            'Date Field',
            choices=[(field, field.capitalize()) for field in self.date_fields],
            validators=[DataRequired()]
        )
        return {
            'date_field_form': date_field_form
        }

    @expose('/calendar/today/')
    @has_access
    def calendar_today_events(self):
        today = datetime.now().date()
        tomorrow = today + timedelta(days=1)
        date_field = request.args.get('date_field', self.default_date_field)

        query = self.datamodel.session.query({{ table_name }}).filter(
            getattr({{ table_name }}, date_field) >= today,
            getattr({{ table_name }}, date_field) < tomorrow
        )
        events = [
            {
                'id': item.id,
                'title': str(item),
                'start': getattr(item, date_field).isoformat(),
                'url': f"{request.script_root}{self.show_url}?id={item.id}"
            } for item in query.all()
        ]
        return jsonify(events)

    @expose('/calendar/month/')
    @has_access
    def calendar_month_summary(self):
        year = int(request.args.get('year', datetime.now().year))
        month = int(request.args.get('month', datetime.now().month))
        date_field = request.args.get('date_field', self.default_date_field)

        first_day = datetime(year, month, 1)
        last_day = first_day.replace(day=calendar.monthrange(year, month)[1])

        query = self.datamodel.session.query({{ table_name }}).filter(
            getattr({{ table_name }}, date_field) >= first_day,
            getattr({{ table_name }}, date_field) <= last_day
        )
        
        events_count = query.count()
        return jsonify({
            'year': year,
            'month': month,
            'events_count': events_count
        })

