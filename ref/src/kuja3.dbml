 }

enum t_severity_level {
  Insignificant [note: 'No impact or a negligible impact that requires no immediate action.']
  Trivial       [note: 'Minimal impact, requires very little attention.']
  Low           [note: 'Limited impact, may need attention but not urgent.']
  Moderate      [note: 'Moderate impact, requires attention but not immediate action.']
  Significant   [note: 'Important enough to warrant prompt attention.']
  High          [note: 'High impact, requiring immediate attention and action.']
  Urgent        [note: 'Immediate action required, failure to act could have severe consequences.']
  Severe        [note: 'Critical impact, immediate action is crucial to prevent severe consequences.']
  Extreme       [note: 'Extreme impact with potentially catastrophic results, immediate action is imperative.']
  Critical      [note: 'Immediate, decisive action required to prevent catastrophic failure.']
 }

