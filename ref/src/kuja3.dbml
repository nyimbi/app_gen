Table project_tag {
  id serial [pk]
  project_id_fk integer [ref: > project.id, not null]
  tag_id_fk integer [ref: > tag.id, not null]
 }

Table organization_badge {
  id serial [pk]
  organization_id_fk integer [ref: > organization.id, not null]
  badge_id_fk integer [ref: > badge.id, not null]
  date_earned timestamp [default: `now()`]
 }

Table onboarding_progress {
  id serial [pk]
  user_id_fk integer [ref: > person.id, not null]
  organization_id_fk integer [ref: > organization.id]
  step integer [default: 1]
  completed_at timestamp
 } 


//Gamification
Table user_gamification {
  id serial [pk]
  user_id_fk integer [ref: > person.id, not null]
  points integer [default: 0]
  level integer [default: 1]
  last_point_earned timestamp
  points_to_next_level integer [default: 100]
 }

Table badge {
  id serial [pk]
  name varchar(50) [not null, unique]
  description varchar(200)
  criteria varchar(200)
  icon varchar(100)
 }

Table person_badge {
  person_id_fk integer [ref: > person.id]
  badge_id_fk integer [ref: > badge.id]
  date_earned timestamp [default: `now()`]
  
  indexes {
    (person_id_fk, badge_id_fk) [pk]
  }
 }

Table leaderboard {
  id serial [pk]
  person_id_fk integer [ref: > person.id, not null]
  score integer [default: 0]
  last_updated timestamp [default: `now()`]
 }

Table gamification_challenge {
  id serial [pk]
  name varchar(100) [not null]
  description text
  points_reward integer [default: 0]
  badge_reward_id_fk integer [ref: > badge.id]
  start_date timestamp
  end_date timestamp
 }

Table user_challenge {
  id serial [pk]
  person_id_fk integer [ref: > person.id, not null]
  challenge_id_fk integer [ref: > gamification_challenge.id, not null]
  completed boolean [default: false]
  completion_date timestamp
 }

Table profile_update_reminder {
  id serial [pk]
  person_id_fk integer [ref: > person.id, not null]
  last_reminder_date timestamp [default: `now()`]
  reminder_count integer [default: 0]
  next_reminder_date timestamp
 }

Table point_earning_activity {
  id serial [pk]
  person_id_fk integer [ref: > person.id, not null]
  activity_type varchar(50) [not null]
  points_earned integer [default: 0]
  timestamp timestamp [default: `now()`]
 }
// People Profiles
Table skill_category {
  id integer [pk]
  name varchar(100) [not null, unique]
  description text
 }

Table skill {
  id serial [pk]
  name varchar(100) [not null, unique]
  skill_category_id_fk integer [ref: > skill_category.id, not null]
  description text
 }

Table person_skill {
  id serial [pk]
  person_id_fk integer [ref: > person.id, not null]
  skill_id_fk integer [ref: > skill.id, not null]
  proficiency_level integer
  endorsements integer [default: 0]
 }
Table person_experience {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  job_title varchar(150) [not null]
  company_name varchar(150) [not null]
  location varchar(150)
  start_date date [not null]
  end_date date
  description text
  awards text
 }

Table person_education {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  school_name varchar(150) [not null]
  degree varchar(100)
  field_of_study varchar(100)
  start_date date [not null]
  end_date date
  description text
 }

Table person_certification {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  name varchar(150) [not null]
  issuing_organization varchar(150) [not null]
  issue_date date [not null]
  expiration_date date
  credential_id varchar(100)
  credential_url varchar(255)
 }

Table person_project {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  name varchar(150) [not null]
  description text
  start_date date [not null]
  end_date date
  project_url varchar(255)
 }

Table person_language {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  name varchar(50) [not null]
  proficiency t_language_proficiency_level [not null, default: 'A1']
 }

Table person_honor_award {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  title varchar(150) [not null]
  issuer varchar(150) [not null]
  date_received date [not null]
  description text
 }

Table person_publication {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  title varchar(150) [not null]
  publisher varchar(150) [not null]
  date date [not null]
  url varchar(255)
  description text
 }

Table person_volunteer_experience {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  role varchar(150) [not null]
  organization varchar(150) [not null]
  cause varchar(150)
  start_date date [not null]
  end_date date
  description text
 }

Table person_patent {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  title varchar(150) [not null]
  patent_office varchar(150) [not null]
  patent_number varchar(50) [not null]
  issue_date date [not null]
  description text
 }

Table person_course {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  name varchar(150) [not null]
  institution varchar(150) [not null]
  completion_date date [not null]
  description text
 }

Table person_organization_membership {
  id serial [pk, increment]
  person_id_fk integer [ref: > person.id, not null]
  organization_name varchar(150) [not null]
  role varchar(150) [not null]
  start_date date [not null]
  end_date date
  description text
 }
