enum t_contact_status {
  New [Note: 'Contact has been created but not yet contacted']
  Contacted [Note: 'Contact has been contacted at least once']
  Qualified [Note: 'Contact is qualified as a potential lead']
  Unqualified [Note: 'Contact is not a potential lead']
  Customer [Note: 'Contact has become a customer']
  Inactive [Note: 'Contact is inactive']
  Blocked [Note: 'Contact has requested not to be contacted']
  Deleted [Note: 'Contact has been deleted']
 }

enum t_person_application_status {
  Submitted [Note: 'Application has been submitted']
  Pending_Review [Note: 'Application is pending review']
  Under_Review [Note: 'Application is currently under review']
  Approved [Note: 'Application has been approved']
  Rejected [Note: 'Application has been rejected']
  Withdrawn [Note: 'Application has been withdrawn']
  On_Hold [Note: 'Application is on hold']
  Completed [Note: 'Application process is complete']
 }

enum t_project_status {
  Initiated [Note: 'Project has been initiated']
  Planned [Note: 'Project is in the planning phase']
  In_Progress [Note: 'Project is actively being worked on']
  Delayed [Note: 'Project is behind schedule']
  Suspended [Note: 'Project is temporarily suspended']
  Completed [Note: 'Project is completed']
  Cancelled [Note: 'Project has been cancelled']
  Closed [Note: 'Project is closed and archived']
 }

enum t_grant_status {
  Submitted [Note: 'Grant application submitted']
  Pending_Review [Note: 'Grant application under review']
  Approved [Note: 'Grant approved']
  Funded [Note: 'Grant funds disbursed']
  In_Progress [Note: 'Grant activities in progress']
  Delayed [Note: 'Grant activities delayed']
  Suspended [Note: 'Grant temporarily suspended']
  Completed [Note: 'Grant activities completed']
  Closed [Note: 'Grant closed and archived']
  Terminated [Note: 'Grant terminated early']
  Rejected [Note: 'Grant application rejected']
 }

enum t_social_media_platform {
  LinkedIn [Note: 'LinkedIn']
  Facebook [Note: 'Facebook']
  Twitter [Note: 'Twitter']
  Instagram [Note: 'Instagram']
  YouTube [Note: 'YouTube']
  TikTok [Note: 'TikTok']
  Pinterest [Note: 'Pinterest']
  Snapchat [Note: 'Snapchat']
  Reddit [Note: 'Reddit']
  WhatsApp [Note: 'WhatsApp']
  Telegram [Note: 'Telegram']
  Discord [Note: 'Discord']
  Other [Note: 'Other social media platform']
 }


enum t_org_hierarchy_type {
  parent [Note: 'Parent Organization']
  subsidiary [Note: 'Subsidiary']
  department [Note: 'Department']
  division [Note: 'Division']
  unit [Note: 'Unit']
  team [Note: 'Team']
  branch [Note: 'Branch']
  office [Note: 'Office']
  location [Note: 'Location']
  region [Note: 'Region']
  country [Note: 'Country']
  global [Note: 'Global']
  holding_company [Note: 'Holding Company']
  joint_venture [Note: 'Joint Venture']
  partnership [Note: 'Partnership']
  franchise [Note: 'Franchise']
  affiliate [Note: 'Affiliate']
  customer [Note: 'Customer']
  supplier [Note: 'Supplier']
}
//Geographic Location information
//Upload geoname db
Table geoname {
    id serial [pk, note: 'Unique identifier for each geoname'] 
    name varchar(200) [note: 'Local name of the place or location']
    asciiname varchar(200) [note: 'ASCII version of the name, suitable for URL or systems that dont support unicode']
    alternatenames text [note: 'Alternative names or variations of the location name, possibly in different languages or scripts']
    latitude float [note: 'Latitude coordinate of the location']
    longitude float [note: 'Longitude coordinate of the location']
    fclass char(1) [note: 'Feature class, represents general type/category of the location e.g. P for populated place, A for administrative division']
    fcode varchar(10) [note: 'Feature code, more specific than feature class, indicating the exact type of feature']
    country varchar(2) [note: 'ISO-3166 2-letter country code']
    cc2 varchar(1000) [note: 'Alternative country codes if the location is near a border']
    admin1 varchar(20) [note: 'Primary administrative division, e.g., state in the USA, oblast in Russia']
    admin2 varchar(80) [note: 'Secondary administrative division, e.g., county in the USA']
    admin3 varchar(20) [note: 'Tertiary administrative division, specific to each country']
    admin4 varchar(20) [note: 'Quaternary administrative division, specific to each country']
    population bigint [note: 'Population of the location if applicable']
    elevation int [note: 'Elevation above sea level in meters']
    gtopo30 int [note: 'Digital elevation model, indicates the average elevation of 30x30 area in meters']
    timezone varchar(40) [note: 'The timezone in which the location lies, based on the IANA Time Zone Database']
    moddate date [note: 'The last date when the record was modified or updated']
 }


Table alternatename {
    id int [pk, increment, note: 'Unique identifier for each alternate name entry'] 
    geo_id_fk int [ref: > geoname.id, note: 'Reference to the geoname table; denotes which location this alternate name pertains to']
    isolanguage varchar(7) [note: 'ISO language code denoting the language of this alternate name, e.g., en for English']
    alternatename varchar(200) [note: 'The alternate name itself in the specified language']
    ispreferredname boolean [default: False, note: 'Indicates if this is the preferred name in the associated language']
    isshortname boolean [default: False, note: 'Indicates if this name is a short version or abbreviation']
    iscolloquial boolean [default: False, note: 'Indicates if this name is colloquial or informal']
    ishistoric boolean [default: False, note: 'Indicates if this name is historic and no longer widely in use']
    name_from varchar(500) [note: 'Used for transliterations; the script or system from which the name was derived']
    name_to varchar(500) [note: 'Used for transliterations; the script or system to which the name was translated']
 }


Table country {
    id serial [pk]
    iso_alpha2 char(2) [unique, not null, note: '2-letter ISO 3166-1 alpha code e.g., US for the United States']
    iso_alpha3 char(3) [unique, not null, note: '3-letter ISO 3166-1 alpha code e.g., USA for the United States']
    iso_numeric integer [note: 'ISO 3166-1 numeric code e.g., 840 for the United States']
    fips_code varchar(3) [note: 'Federal Information Processing Standard code, used by the US government']
    name varchar(200) [note: 'Full name of the country']
    capital varchar(200) [note: 'Capital city of the country']
    areainsqkm float [note: 'Total area of the country in square kilometers']
    population integer [note: 'Estimated population of the country']
    continent varchar(2) [note: 'Abbreviation of the continent the country is located in']
    tld varchar(10) [note: 'Top Level Domain for the country e.g., .us for the United States']
    currencycode varchar(3) [note: 'ISO code of the country’s currency e.g., USD for US Dollar']
    currencyname varchar(20) [note: 'Full name of the country’s currency e.g., Dollar for US Dollar']
    phone varchar(20) [note: 'Country dialing code e.g., +1 for the United States']
    postalcode varchar(100) [note: 'Template or format of postal codes in the country']
    postalcoderegex varchar(200) [note: 'Regular expression pattern to validate postal codes']
    languages varchar(200) [note: 'Commonly spoken languages in the country, represented as ISO codes']
    geo_id_fk int [ref: > geoname.id, note: 'Reference to geoname table; linking country data with geographical name data']
    neighbors varchar(50) [note: 'Neighboring countries, usually represented as ISO codes']
    equivfipscode varchar(3) [note: 'Equivalent FIPS code in cases where it might differ from the primary FIPS code']
    flag text [note: 'Field to store a link or representation of the country’s flag']
    Note: 'Country Data needs expansion'
 }


Table admin1codes {
  id serial [pk]
  code varchar(11) [note: 'Primary identifier, typically a combination of country code and admin1 code e.g., US.AL for Alabama, United States']
  countrycode_id_fk integer [ref: > country.id, note: '3-letter ISO 3166-1 alpha code of the country e.g., USA for the United States']
  admin1_code varchar(10) [note: 'Unique identifier within a country for this first-level administrative division. E.g., AL for Alabama']
  name varchar(200) [note: 'Local name of the administrative division in the official language']
  alt_name_english varchar(200) [note: 'Alternative name or translation of the division in English']
  geo_id_fk int [ref: > geoname.id, note: 'Reference to geoname table; linking administrative division data with geographical name data']
 Indexes {
    countrycode_id_fk
    admin1_code
    (countrycode_id_fk, admin1_code)
  }
 }


Table admin2codes {
  id serial [pk]
  code varchar(50) [note: 'Primary identifier, typically a combination of country code, admin1 code, and an additional code representing the second-level administrative division e.g., US.AL.001']
  countrycode_id_fk integer  [ref: > country.id, note: '3-letter ISO 3166-1 alpha code of the country this division belongs to e.g., USA for the United States']
  admin1_code varchar(11) [ note: 'ref: > admin1codes.admin1_code,Reference to the first-level administrative division. E.g., US.AL for Alabama in the United States']
  name varchar(200) [note: 'Local name of the second-level administrative division in the official language']
  alt_name_english varchar(200) [note: 'Alternative name or translation of the division in English']
  geo_id_fk int [ref: > geoname.id, note: 'Reference to geoname table; linking second-level administrative division data with geographical name data']

  Indexes {
    code
    (countrycode_id_fk, admin1_code)
  }
 }

Table featurecodes {
  id serial [pk]
  code varchar(10) [pk, note: 'Primary identifier for the feature code, typically a combination of class and fcode']
  fclass varchar(10) [note: 'Class identifier that categorizes the type of geographical feature e.g., P for populated place, T for mountain']
  fcode varchar(10) [pk, note: 'Specific code within a class that describes the feature in more detail. E.g., within class P, an fcode might specify city, village, etc.']
  label varchar(100) [note: 'Short label or name for the feature code']
  description varchar(1000) [note: 'Detailed description of what the feature code represents']
 }


Table languagecodes {
  id serial [pk]
  iso_639_3 varchar(10) [note: 'ISO 639-3 code is a three-letter code that represents a specific language uniquely. It offers a comprehensive set of languages.']
  iso_639_2 varchar(10) [note: 'ISO 639-2 code is a three-letter code, which could be either bibliographic or terminological, representing a set of similar languages.']
  iso_639_1 varchar(10) [note: 'ISO 639-1 code is a two-letter code. It represents major languages but is not as exhaustive as ISO 639-3.']
  name varchar(1000) [note: 'The descriptive name of the language in English.']
 }


//Currencies
Table currency {
   id serial [pk, increment]
   name varchar(4)
   symbol varchar(5)
   numeric_code varchar(4)
   full_name varchar(100)
   // curr_code varchar(3) [not null
   // decimal_places SMALLINT 
   // display_symbol varchar(10)
   // name varchar(50) [not null]
   //internationalized_name_code varchar(90)

 Indexes {
   name [unique]
  }
 }

Table timezone {
  id serial [pk]
  country_code_id_fk integer [ref: > country.id]
  timezonename varchar(100)
  comments text
 }



Table person {
  id integer [pk, increment]
  first_name varchar(150) [not null]
  middle_name varchar(150)
  last_name varchar(150) [not null]
  full_name varchar(150) 
  nick_name varchar(150)

  headline varchar(220)
  location varchar(150)
  summary text
  email varchar(150) [not null, unique]
  phone varchar(50)
  date_of_birth date
  contacts_id_fk int [ref: > contact.id]

  city varchar(100)
  state_province varchar(100)
  postal_code varchar(20)
  country varchar(100)
  bio text
  skills_description text
  interests text
  is_volunteer boolean [default: false]
  is_staff boolean [default: false]

  onboarding_step integer [default: 0]
  profile_completion integer [default: 0]
  last_profile_update timestamp
  points integer [default: 0]
  level integer [default: 1]
  social_media_imported boolean [default: false]
 }

Table contact_type {
  id serial [pk,increment,  note: 'Unique identifier for the address type.']
  name varchar(50) [not null, note: 'Name or type of contact method, e.g., Mobile, Email, WhatsApp.']
  description text [note: 'Brief description about the address type, providing context or usage scenarios.']
  is_digital boolean [default: True, note: 'Indicates if the contact method is digital or physical.']
  requires_verification boolean [default: False, note: 'Indicates if the address type typically requires a verification process, e.g., email confirmation.']
  max_length int [note: 'If applicable, the maximum character length of a value of this address type. Useful for validation.']
  icon_url varchar(255) [note: 'URL or link to an icon or image representing this address type. Useful for UI/UX purposes.']

  created_at timestamp [default: 'now()', note: 'Timestamp when the address type was added to the system.']
  updated_at timestamp [default: 'now()', note: 'Timestamp when the address type was last updated.']

  note: ' phone, mobile, email, messaging, whatsapp, viber, instagram, website, etc'
  Indexes {
    name [unique, name: 'idx_unique_name']
  }
 }

Table contact {
  id integer [pk, increment, note: 'Unique identifier for the contact.']
  
  person_id_fk int [ref: > person.id, note: 'Reference to the individual associated with this contact.']
  contact_type_id_fk int [ref: > contact_type.id, not null, note: 'Reference to the type of contact.']

  contact varchar(100) [not null, note: 'Actual contact value, e.g., phone number or email address.']
  priority int [not null, default: 10, note: 'Ordering priority for displaying or using the contact. Lower value indicates higher priority.']
  best_time_to_contact_start time [note: 'Preferred start time when the individual/organization is available for contact.']
  best_time_to_contact_end time [note: 'Preferred end time for availability.']
  active_from_date timestamp [default: `now()`, note: 'Date when this contact became active or relevant.']
  active_to_date date [note: 'Date when this contact ceases to be active or relevant.']
  
  for_business_use boolean [default: False, note: 'Indicates if the contact is primarily for business purposes.']
  for_personal_use boolean [default: True, note: 'Indicates if the contact is primarily for personal use.']
  do_not_use boolean [default: False, note: 'Indicates if there are any restrictions or requests not to use this contact.']
  is_active boolean [default: True, note: 'Indicates if this contact is currently active and usable.']
  is_blocked boolean [default: False, note: 'Indicates if this contact is blocked, maybe due to spam or other reasons.']
  is_verified boolean [default: False, note: 'Indicates if this contact has been verified, e.g., via OTP or email confirmation.']

  notes text [note: 'Additional notes or context about the contact.']
  note:'Agent or person contacts'

  Indexes {
    (person_id_fk, contact_type_id_fk) [unique, name: 'idx_person_contact']
    contact [unique, name: 'idx_unique_contact']
  }
 }

Table social_media_profile {
  id serial [pk]
  person_id_fk integer [ref: > person.id]
  org_id_fk integer [ref: > organization.id]
  platform t_social_media_platform [not null]
