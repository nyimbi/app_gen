enum t_admin_level {
  Continent     [note: 'The highest geographical level, divides the world into large land masses.']
  Region        [note: 'A geographic area larger than a single country but smaller than a continent.']
  Supranational [note: 'Above the national level, often representing a group of countries.']
  Country       [note: 'A sovereign nation recognized by international law.']
  Federal       [note: 'Relating to a system of government where multiple states form a unity but remain independent in internal affairs.']
  State         [note: 'A political entity within a country, can have its own government.']
  LGA           [note: 'Local Government Area, an administrative division within a country.']
  Ward          [note: 'A subdivision of a larger administrative area, often related to urban settings.']
  Province      [note: 'A territory governed as a unit within a country or empire.']
  County        [note: 'A geographic and administrative division within a state or province.']
  District      [note: 'A type of administrative division that can exist in various countries.']
  Location      [note: 'Smaller than a district, can refer to a specific area within a district or city.']
  Sub_location  [note: 'Smaller than a location, can refer to a specific area within a district or city.']
  Canton        [note: 'A type of administrative division found in some countries, like Switzerland.']
  Municipality  [note: 'A city or town that has its own local government.']
  Town          [note: 'Smaller than a city but larger than a village, usually has its own local government.']
  Village       [note: 'A small community or group of houses in a rural area.']
  Neighborhood  [note: 'A localized community within a larger city, town, or suburb.']
  Borough       [note: 'An administrative division in various English-speaking countries, often a self-governing township.']
  Suburb        [note: 'An outlying district of a city, often residential.']
  Zone          [note: 'A segment of area separated for a particular purpose, could be residential, industrial, etc.']
 }

