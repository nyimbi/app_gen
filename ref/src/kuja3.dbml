enum t_doc_verification_status {
  pending_approval     [note: 'Initial status, waiting for approval to proceed.']
  kyc_submitted        [note: 'Know Your Customer (KYC) documents have been submitted for review.']
  kyc_approved         [note: 'KYC documents have been approved.']
  kyc_rejected         [note: 'KYC documents were not approved and need resubmission or clarification.']
  escalated            [note: 'Requires special or urgent attention, possibly due to issues in verification.']
  contracted           [note: 'Contract has been finalized and agreed upon.']
  active               [note: 'Account or contract is in good standing and operational.']
  suspended            [note: 'Account or contract temporarily disabled due to specific reasons.']
  inactive             [note: 'Account or contract is not active but not terminated.']
  contract_terminated  [note: 'Contract has been officially terminated.']
  docs_expired         [note: 'Documents, like licenses or certificates, have expired.']
  under_review         [note: 'Account or contract is under administrative or legal review.']
  locked               [note: 'Account or contract is locked due to security reasons or fraudulent activity.']
  awaiting_renewal     [note: 'Pending status for accounts or contracts that are up for renewal.']
  renewal_rejected     [note: 'Renewal application has been rejected.']
  verification_failed  [note: 'Failed verification checks other than KYC.']
 }

enum t_org_type {
  INGO
  CBO
  NNGO
  Individual                          [note: 'A single person not operating as a formal business entity.']
  Business_Name                       [note: 'An unincorporated business owned by a single individual or multiple individuals.']
  Sole_Proprietorship                 [note: 'A business structure where the owner and the business are legally considered the same entity.']
  Partnership                         [note: 'A business structure where two or more individuals manage and operate a business.']
  Private_Limited_Company             [note: 'A privately-held business entity, owned by shareholders, with liability limited to the value of shares.']
  Public_Limited_Company              [note: 'A business whose shares are publicly traded and available to the general public, with liability limited to the value of shares.']
  Public_Company_Limited_by_Guarantee [note: 'A public company where members’ financial liability is limited to a predetermined amount.']
  Private_Unlimited_Company           [note: 'A privately-held business with no limit on the financial liability of its owners or shareholders.']
  Public_Unlimited_Company            [note: 'A publicly-held company with no limit on the financial liability of its shareholders.']
  Cooperative                         [note: 'A member-owned business structure with at least five members, all having equal voting power.']
  Nonprofit                           [note: 'An organization established for purposes other than generating profit.']
  Trust                               [note: 'An entity that holds assets for the benefit of certain persons or entities.']
  Government                          [note: 'A governmental organization or entity.']
  Franchise                           [note: 'A type of license that a party (franchisee) acquires to allow them to have access to a business’s (franchisor) proprietary knowledge, processes, and trademarks.']
  Subsidiary                          [note: 'An entity that is completely or partly owned and wholly controlled by another (parent) entity.']
  Holding_Company                     [note: 'A company that owns the stock of other companies but produces no goods or services itself.']
  Joint_Venture                       [note: 'A business entity created by two or more parties, generally characterized by shared ownership, shared returns and risks, and shared governance.']
  Freelancer                          [note: 'An individual who offers services to businesses or clients on a contract or project basis.']
  Agency                              [note: 'A business that offers a particular kind of service on behalf of other businesses or individuals.']
  Womens_Group                        [note: 'A community or organization primarily composed of women, focused on issues of interest to women.']
  Meiti_Allah                         [note: 'A pastoralist association, typically in countries like Nigeria, representing cattle herders.']
  Informal_Group                      [note: 'A group without formal organizational structure but with a common purpose or interest.']
  Chama                               [note: 'A micro-savings group commonly found in East Africa, usually consisting of a small number of people who contribute to a communal fund.']
  Other_Groupings                     [note: 'Any other types of groupings not listed above.']
  Family                              [note: 'Basic social unit']
  Clan                                [note: 'Group based on familial lineage']
  Tribe                               [note: 'Larger group of related clans']
  Association                         [note: 'Group organized for a common purpose']
  Club                                [note: 'Social, recreational organization']
  Consortium                          [note: 'Coalition of organizations for a common purpose']
  Syndicate                           [note: 'Self-organizing group for specific business']
  Collective                          [note: 'Collaborative and shared group']
  Network                             [note: 'Interconnected individuals or organizations']
  Foundation                          [note: 'Nonprofit for a specific goal']
  Federation                          [note: 'Unified body of organizations']
  Chamber_of_Commerce                 [note: 'Local business community association']
  Guild                               [note: 'Association in trades or crafts']
  Union                               [note: 'Workers’ organization for mutual goals']
  Religious_Organization              [note: 'For religious practices and doctrines']
  Political_Organization              [note: 'For political activities']
  Alumni_Association                  [note: 'Organization of former students']
  Affiliate                           [note: 'Connected but not controlled company']
  Division                            [note: 'Separate business unit of a company']
  Council                             [note: 'Administrative or advisory body']
  Task_Force                          [note: 'Unit for a single defined task']
  Social_Club                         [note: 'For socializing']
  Charity                             [note: 'Nonprofit for public well-being']
