  prepaid             [note: 'Payment made in advance, usually for subscriptions or services.']
  qr_code             [note: 'Payment made by scanning a QR code.']
  digital_wallet      [note: 'Payment made from a digital or electronic wallet.']
  automatic_debit     [note: 'Payment made through automatic bank debit.']
  cash_on_delivery    [note: 'Payment made in cash upon delivery of goods.']
  postpaid            [note: 'Payment to be made after receiving the service or goods.']
  third_party         [note: 'Payment processed by a third-party service.']
  trade_credit        [note: 'Payment deferred as a form of short-term credit.']
 }

enum t_transaction_status {
  pending                 [note: 'Transaction is initiated but not yet processed.']
  authorized              [note: 'Transaction is authorized but not yet captured.']
  completed               [note: 'Transaction is successfully completed.']
  failed                  [note: 'Transaction has failed.']
  cancelled               [note: 'Transaction has been cancelled by the user or system.']
  refunded                [note: 'Funds have been returned to the payer.']
  reversed                [note: 'Transaction has been reversed, typically due to a dispute or error.']
  hold                    [note: 'Transaction is on hold for further review or action.']
  suspended               [note: 'Transaction is temporarily suspended, usually for investigation.']
  disputed                [note: 'Transaction is under dispute.']
  delivered               [note: 'Goods or services have been delivered, but payment may still be pending.']
  settlement_pending      [note: 'Transaction is awaiting settlement.']
  settled                 [note: 'Transaction has been settled.']
  rejected                [note: 'Transaction has been rejected by the gateway or financial institution.']
  expired                 [note: 'Transaction authorization has expired.']
  pending_verification    [note: 'Transaction is pending further verification.']
  hold_for_review         [note: 'Transaction is on hold for manual review.']
  partially_completed     [note: 'Transaction is partially completed; further action needed for full completion.']
  partially_refunded      [note: 'Partial funds have been returned to the payer.']
  partially_reversed      [note: 'Transaction is partially reversed.']
  completed_with_errors   [note: 'Transaction completed but encountered some errors.']
  batch_processing        [note: 'Transaction is part of a batch that is being processed.']
  deferred                [note: 'Transaction is deferred for future processing.']
  waiting_for_authorization [note: 'Transaction is waiting for authorization from payer or financial institution.']
  processing              [note: 'Transaction is currently being processed.']
  pending_funds_availability [note: 'Transaction is pending until funds become available.']
  pending_review          [note: 'Transaction is pending review from the financial institution.']
  pending_confirmation    [note: 'Transaction is pending confirmation from an external entity.']
  waiting_for_settlement  [note: 'Transaction is completed but waiting for final settlement.']
  pending_reconciliation  [note: 'Transaction is awaiting reconciliation with accounting records.']
  pending_disbursement    [note: 'Funds are pending disbursement to the payee.']
  chargeback_initiated    [note: 'A chargeback process has been initiated against the transaction.']
  chargeback_resolved     [note: 'The chargeback process has been resolved, either in favor or against the merchant.']
  pending_capture         [note: 'Transaction is authorized and is pending capture of funds.']
  captured                [note: 'Funds have been successfully captured after authorization.']
  voided                  [note: 'Transaction has been nullified before completion.']
  in_queue                [note: 'Transaction is in a processing queue, typically for batch processing.']
  manual_intervention_required [note: 'Transaction requires manual intervention for completion.']
  gateway_timeout         [note: 'Transaction could not be completed due to a timeout at the payment gateway.']
  fraud_alert             [note: 'Transaction has triggered a fraud alert and is under investigation.']
  under_audit             [note: 'Transaction is currently being audited for compliance or accuracy.']
  audit_completed         [note: 'Audit process for the transaction is complete.']
  currency_conversion     [note: 'Transaction involves currency conversion and is pending rate confirmation.']
  currency_conversion_completed [note: 'Currency conversion for the transaction is complete.']
  escalated               [note: 'Transaction issue has been escalated for higher-level review or action.']
  de_escalated            [note: 'Transaction issue has been resolved after escalation.']
  pending_approval        [note: 'Transaction is pending approval from a supervisory entity.']
  approved                [note: 'Transaction has received necessary approvals.']
  declined                [note: 'Transaction has been declined by the payer or financial institution after initial authorization.']
  re_attempted            [note: 'Transaction has been re-attempted after a failure.']
  re_scheduled            [note: 'Transaction has been rescheduled for future processing.']
  insufficient_funds      [note: 'Transaction could not be completed due to insufficient funds.']
  verification_failed     [note: 'Transaction failed due to verification issues, such as incorrect CVV or OTP.']
  verification_successful [note: 'Transaction successfully passed all verification checks.']
  pending_clearance       [note: 'Transaction is pending clearance from the clearing house.']
  cleared                 [note: 'Transaction has been cleared by the clearing house.']
  re_initiated            [note: 'Transaction has been re-initiated after being cancelled or failed.']
  split_transaction       [note: 'Transaction has been split into multiple parts for processing.']
  consolidated            [note: 'Multiple transactions have been consolidated into one.']
 }

enum t_doc_status {
  Not_Started       [note: ' Not started preparing the document']
  Draft             [note: 'Document is in an initial stage.']
  In_Progress       [note: 'Document is being actively worked on.']
  Awaiting_Review   [note: 'Document is complete and is waiting to be reviewed.']
  Under_Review      [note: 'Document is currently being reviewed.']
  Review_Completed  [note: 'Review of the document is complete.']
  Revisions_Needed  [note: 'Document needs revisions after review.']
  Submitted         [note: 'Document has been submitted for final approval or implementation.']
  Approved          [note: 'Document is approved.']
  Partially_Approved [note: 'Document is approved by some, but not all, required parties.']
  Rejected          [note: 'Document is not approved.']
  Cancelled         [note: 'Document processing has been canceled.']
  Archived          [note: 'Document is no longer active but kept for historical reasons.']
  Published         [note: 'Document is made public.']
  Suspended         [note: 'Document is temporarily on hold.']
  Voided            [note: 'Document is null and void.']
  Completed         [note: 'Document has served its purpose or task is complete.']
  Expired           [note: 'Document or its relevance has expired.']
  Renewed           [note: 'Document has been updated and renewed after expiration or period of validity.']
  Locked            [note:'Document is currently locked for editing by a user or system process.']
  Merged            [note:'Changes from multiple versions or contributors have been merged.']
  Rollback          [note:'Document has been reverted to a previous version.']
  Conflict          [note:'There are conflicting changes in the document that need resolution.']
  Queued_for_Review [note:'Document is in a queue waiting to be reviewed.']
  Queued_for_Publish [note:'Document is in a queue waiting to be published.']
  Deprecated        [note:'Document is outdated but not yet archived.']
  Unpublished       [note:'Document has been reverted from a Published state.']
  In_Translation    [note:'Document is currently being translated.']
  Validation_Failed [note:'Document failed some form of validation.']
  Validation_Passed [note:'Document successfully passed validation checks.']
  Digitized         [note:'Physical document has been converted to a digital format.']
  In_Signature_Process [note:'Document is in the process of being digitally signed.']
  Signature_Completed [note:'All required digital signatures have been obtained.']
  Signature_Failed  [note:'Digital signature process failed.']
  In_Audit          [note:'Document is currently being audited or inspected.']
  Audit_Completed   [note:'Audit or inspection process is complete.']
  In_Transit        [note:'Document is being moved from one location to another.']
  Received          [note:'Document has been received by the intended party.']
  Sent              [note:'Document has been sent but not necessarily received by the intended party.']
 }

//Combined Intervals and Recurrence
enum t_interval {
  None                [note: 'No recurrence; single event instance.']
  Per_Second          [note: 'For very high-frequency use-cases, like real-time analytics or monitoring.']
  Per_Minute          [note: 'For minute-by-minute intervals, used for relatively high-frequency tasks.']
  Hourly              [note: 'Hourly interval, commonly used for things like hourly rates or metrics.']
  Daily               [note: 'For daily operations, such as daily reports or aggregations.']
  Weekly              [note: 'For operations that occur once a week.']
  Biweekly            [note: 'For operations that happen twice a month or every two weeks.']
  Monthly             [note: 'For monthly activities, such as billing or reporting.']
  Bimonthly           [note: 'Recurs every two months; for activities requiring bimonthly attention like strategic reviews.']
  Quarterly           [note: 'For activities that occur once every three months.']
  Semi_Annually       [note: 'For operations that happen twice a year.']
  Annually            [note: 'For yearly activities, like annual reviews or reports.']
  Custom              [note: 'For user-defined intervals.']
  Workdays            [note: 'Recurs on workdays only (Mon-Fri); for events related to standard business operations.']
  Weekends            [note: 'Recurs on weekends only (Sat-Sun); useful for non-business activities.']
  MONDAY              [note: 'Recurs every Monday; suitable for weekly meetings or tasks falling on this day.']
  TUESDAY             [note: 'Recurs every Tuesday; suitable for weekly meetings or tasks falling on this day.']
  WEDNESDAY           [note: 'Recurs every Wednesday; suitable for weekly meetings or tasks falling on this day.']
  THURSDAY            [note: 'Recurs every Thursday; suitable for weekly meetings or tasks falling on this day.']
  FRIDAY              [note: 'Recurs every Friday; suitable for weekly meetings or tasks falling on this day.']
  SATURDAY            [note: 'Recurs every Saturday; useful for non-business activities.']
  SUNDAY              [note: 'Recurs every Sunday; useful for non-business activities.']
  FIRST_DAY_MONTH     [note: 'Recurs on the first day of each month; for events like the start of a billing cycle.']
  LAST_DAY_MONTH      [note: 'Recurs on the last day of each month; suitable for end-of-month reporting.']
  FIRST_WEEKDAY       [note: 'Recurs on the first weekday of each month; useful for recurring tasks that fall at the start of business months.']
  LAST_WEEKDAY        [note: 'Recurs on the last weekday of each month; useful for activities wrapping up the business month.']
  EVERY_X_DAYS        [note: 'Recurs every X days; allows for specifying an arbitrary number of days for the event to recur.']
  EVERY_X_WEEKS       [note: 'Recurs every X weeks; permits specifying an arbitrary number of weeks for recurring events.']
  EVERY_X_MONTHS      [note: 'Recurs every X months; permits specifying an arbitrary number of months for recurring events.']
  EVERY_X_YEARS       [note: 'Recurs every X years; allows for specifying an arbitrary number of years for recurring events.']
 }

enum t_language_proficiency_level {
  BASIC [note: 'Basic knowledge, can understand and produce familiar and routine expressions.']
  INTERMEDIATE [note: 'Can handle most situations while traveling, can produce simple connected text on familiar topics.']
  ADVANCED [note: 'Can produce clear, detailed text on a range of subjects; can understand the main ideas of complex text.']
  FLUENT [note: 'Can understand a wide range of demanding texts, and recognize implicit meanings; can express ideas without searching for expressions.']
  
  A1 [note: 'Beginner - Can understand and use familiar everyday expressions and very basic phrases aimed at the satisfaction of needs of a concrete type.']
  A2 [note: 'Elementary - Can understand sentences and frequently used expressions related to areas of most immediate relevance.']
  B1 [note: 'Intermediate - Can understand the main points of clear standard input on familiar matters regularly encountered in work, school, etc.']
  B2 [note: 'Upper Intermediate - Can produce clear, detailed text on a wide range of subjects and explain a viewpoint on a topical issue.']
  C1 [note: 'Advanced - Can understand a wide range of demanding, longer texts, and recognize implicit meaning.']
  C2 [note: 'Proficient - Can understand with ease virtually everything heard or read.']
 }

