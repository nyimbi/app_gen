from flask import request, jsonify, current_app
from sqlalchemy import or_
from flask_appbuilder import ModelRestApi
from flask_appbuilder.api import BaseApi, expose, rison, safe
from flask_appbuilder.models.sqla.interface import SQLAInterface
from flask_appbuilder.models.filters import BaseFilter
from flask_appbuilder.security.decorators import has_access, protect

from app import appbuilder, db
from ..models import {{ table_name|capitalize }}

# from {{ config.get('app_package', 'app') }} import appbuilder, db

class {{ table_name|capitalize }}Api(ModelRestApi):
    resource_name = "{{ table_name.lower() }}"
    datamodel = SQLAInterface({{ table_name|capitalize }})
    custom_template = ""

    {%- if columns %}
    # Include or exclude specific columns from the API
    include_columns = [
        {%- for column in columns %}
        "{{ column['name'] }}",
        {%- endfor %}
    ]
    {%- endif %}

    {%- if config.get('permissions') %}
    # Permissions for different operations
    allow_browser_login = {{ config.get('permissions').get('allow_browser_login', True) }}
    {%- endif %}

    {%- if config.get('extra_methods') %}
    # Extra methods provided by config
    {%- for method in config.get('extra_methods') %}
    def {{ method }}(self, *args, **kwargs):
        pass
    {%- endfor %}
    {%- endif %}

    @expose('/custom_query/', methods=['GET'])
    @has_access
    def custom_query(self):
        """
        An example custom query endpoint that allows complex filtering.
        """
        try:
            filters = request.args.to_dict()
            query = db.session.query(self.datamodel.obj)
            for key, value in filters.items():
                if hasattr(self.datamodel.obj, key):
                    query = query.filter(getattr(self.datamodel.obj, key) == value)
            results = query.all()
            return jsonify([result.to_dict() for result in results])
        except Exception as e:
            return jsonify({"error": str(e)}), 400

    @expose('/bulk_create/', methods=['POST'])
    @has_access
    def bulk_create(self):
        """
        An endpoint to allow bulk creation of records.
        """
        try:
            data = request.get_json()
            if not isinstance(data, list):
                return jsonify({"error": "Input should be a list of records"}), 400
            for item in data:
                self.datamodel.add(item, raise_exception=True)
            db.session.commit()
            return jsonify({"status": "success"}), 201
        except Exception as e:
            db.session.rollback()
            return jsonify({"error": str(e)}), 400

    @expose('/bulk_delete/', methods=['DELETE'])
    @has_access
    def bulk_delete(self):
        """
        An endpoint to allow bulk deletion of records based on a list of IDs in {{ table_name | capitalize }}.
        """
        try:
            data = request.get_json()
            if not isinstance(data, list):
                return jsonify({"error": "Input should be a list of IDs"}), 400
            for record_id in data:
                record = self.datamodel.get(record_id, raise_exception=True)
                self.datamodel.delete(record, raise_exception=True)
            db.session.commit()
            return jsonify({"status": "success"}), 200
        except Exception as e:
            db.session.rollback()
            return jsonify({"error": str(e)}), 400

    @expose('/update/<pk>/', methods=['PUT'])
    @has_access
    def update_record(self, pk):
        """
        An endpoint to update a specific record by primary key.
        """
        try:
            data = request.get_json()
            record = self.datamodel.get(pk, raise_exception=True)
            self.datamodel.edit(record, data, raise_exception=True)
            db.session.commit()
            return jsonify({"status": "success"}), 200
        except Exception as e:
            db.session.rollback()
            return jsonify({"error": str(e)}), 400

    @expose('/paginated_query/', methods=['GET'])
    @has_access
    def paginated_query(self):
        """
        An endpoint that provides paginated results for large datasets.
        """
        try:
            page = int(request.args.get('page', 1))
            page_size = int(request.args.get('page_size', 10))
            query = db.session.query(self.datamodel.obj)
            total_records = query.count()
            results = query.offset((page - 1) * page_size).limit(page_size).all()
            return jsonify({
                "total_records": total_records,
                "page": page,
                "page_size": page_size,
                "results": [result.to_dict() for result in results]
            })
        except Exception as e:
            return jsonify({"error": str(e)}), 400

    @expose('/search/', methods=['GET'])
    @has_access
    def search(self):
        """
        A flexible search endpoint that allows searching across multiple fields in {{ table_name|capitalize }}.
        """
        try:
            search_term = request.args.get('q', '')
            if not search_term:
                return jsonify({"error": "Search term is required"}), 400
            query = db.session.query(self.datamodel.obj)
            search_filters = [
                getattr(self.datamodel.obj, column).ilike(f"%{search_term}%")
                for column in self.include_columns
                if hasattr(self.datamodel.obj, column)
            ]
            query = query.filter(db.or_(*search_filters))
            results = query.all()
            return jsonify([result.to_dict() for result in results])
        except Exception as e:
            return jsonify({"error": str(e)}), 400

