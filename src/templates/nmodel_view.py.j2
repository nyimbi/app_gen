    # Form Validation
    def _validate_form(self, form: Any, is_edit: bool = False) -> None:
        """
        Validate form data comprehensively.

        Args:
            form: Form object to validate
            is_edit: Whether this is an edit operation

        Raises:
            ValidationError: If validation fails
        """
        errors = {}

        # Validate required fields
        required_errors = self._validate_required_fields(form)
        if required_errors:
            errors.update(required_errors)

        # Validate field types
        type_errors = self._validate_field_types(form)
        if type_errors:
            errors.update(type_errors)

        # Validate unique constraints
        if not is_edit:
            unique_errors = self._validate_unique_constraints(form)
            if unique_errors:
                errors.update(unique_errors)

        # Validate custom business rules
        rule_errors = self._validate_custom_rules(form)
        if rule_errors:
            errors.update(rule_errors)

        # Raise error with all validation issues if any were found
        if errors:
            raise ValidationError("Form validation failed", errors=errors)

    def _validate_required_fields(self, form: Any) -> Dict[str, List[str]]:
        """
        Validate required fields have values.

        Args:
            form: Form object to validate

        Returns:
            Dict[str, List[str]]: Dictionary of field names and error messages
        """
        errors = {}

        for field_name in self.add_columns:
            field_config = self._get_field_config(field_name)
            if field_config.get('required', False):
                field_value = getattr(form, field_name, None)

                if field_value is None or (isinstance(field_value, str) and not field_value.strip()):
                    errors[field_name] = [f"{self.label_columns.get(field_name, field_name)} is required"]

        return errors

    def _validate_field_types(self, form: Any) -> Dict[str, List[str]]:
        """
        Validate that field values match their expected types.

        Args:
            form: Form object to validate

        Returns:
            Dict[str, List[str]]: Dictionary of field names and error messages
        """
        errors = {}

        for field_name in self.add_columns:
            field_value = getattr(form, field_name, None)

            if field_value is not None:
                field_errors = self._validate_field_type(field_name, field_value)
                if field_errors:
                    errors[field_name] = field_errors

        return errors

    def _validate_field_type(self, field_name: str, value: Any) -> List[str]:
        """
        Validate that a field value matches its expected type.

        Args:
            field_name: Name of the field to validate
            value: Value to validate

        Returns:
            List[str]: List of error messages or empty list if validation succeeds
        """
        errors = []
        field_config = self._get_field_config(field_name)
        field_type = field_config.get('type', 'string')
        field_label = self.label_columns.get(field_name, field_name)

        try:
            # Validation based on field type
            if field_type == 'integer':
                try:
                    int(value)
                except (ValueError, TypeError):
                    errors.append(f"{field_label} must be an integer")

            elif field_type == 'float':
                try:
                    float(value)
                except (ValueError, TypeError):
                    errors.append(f"{field_label} must be a number")

            elif field_type == 'boolean':
                if not isinstance(value, bool) and str(value).lower() not in ('true', 'false', '1', '0', 'yes', 'no'):
                    errors.append(f"{field_label} must be a boolean value")

            elif field_type == 'date':
                if not isinstance(value, (date, datetime)):
                    try:
                        parse(str(value))
                    except ValueError:
                        errors.append(f"{field_label} must be a valid date")

            elif field_type == 'datetime':
                if not isinstance(value, datetime):
                    try:
                        parse(str(value))
                    except ValueError:
                        errors.append(f"{field_label} must be a valid date and time")

            elif field_type == 'json':
                if isinstance(value, str):
                    try:
                        json.loads(value)
                    except json.JSONDecodeError as e:
                        errors.append(f"{field_label} must be valid JSON: {str(e)}")
                elif not isinstance(value, (dict, list)):
                    errors.append(f"{field_label} must be a valid JSON object")

            elif field_type == 'array':
                if not isinstance(value, list) and not (isinstance(value, str) and ',' in value):
                    errors.append(f"{field_label} must be a list or comma-separated values")

            elif field_type == 'email':
                # Simple email validation
                if not isinstance(value, str) or '@' not in value or '.' not in value.split('@')[1]:
                    errors.append(f"{field_label} must be a valid email address")

            elif field_type == 'url':
                # Simple URL validation
                if not isinstance(value, str) or not value.startswith(('http://', 'https://')):
                    errors.append(f"{field_label} must be a valid URL starting with http:// or https://")

            elif field_type == 'phone':
                # Basic phone validation
                if not self._validate_phone_number(value):
                    errors.append(f"{field_label} must be a valid phone number")

            elif field_type == 'currency':
                # Currency validation
                if not self._validate_currency(value):
                    errors.append(f"{field_label} must be a valid currency amount")

            elif field_type == 'color':
                # Color validation
                if not self._validate_color(value):
                    errors.append(f"{field_label} must be a valid color code")

            # Check for custom validator
            custom_validator = field_config.get('validator')
            if custom_validator:
                if isinstance(custom_validator, str):
                    validator_method = getattr(self, custom_validator, None)
                    if validator_method:
                        try:
                            validator_method(field_name, value)
                        except Exception as e:
                            errors.append(str(e))
                else:
                    try:
                        custom_validator(field_name, value)
                    except Exception as e:
                        errors.append(str(e))

        except Exception as e:
            errors.append(f"Error validating {field_label}: {str(e)}")

        return errors

    def _validate_phone_number(self, value: str) -> bool:
        """
        Validate phone number format.

        Args:
            value: Phone number to validate

        Returns:
            bool: True if the phone number is valid, False otherwise
        """
        if not isinstance(value, str):
            return False

        # Remove common separators and spaces
        cleaned = ''.join(c for c in value if c.isdigit() or c in '+-')

        # Check for minimum length and basic format
        return len(cleaned) >= 10 and cleaned.replace('+', '').isdigit()

    def _validate_currency(self, value: Any) -> bool:
        """
        Validate currency amount.

        Args:
            value: Currency amount to validate

        Returns:
            bool: True if the currency amount is valid, False otherwise
        """
        if isinstance(value, (int, float)):
            return True

        if not isinstance(value, str):
            return False

        # Remove currency symbols and thousand separators
        cleaned = value.strip()
        for symbol in ['$', '€', '£', '¥', '₹', '₽', '¢', '฿', '₴', '₩']:
            cleaned = cleaned.replace(symbol, '')

        # Try to convert to float
        try:
            float_val = float(cleaned.replace(',', ''))
            return True
        except ValueError:
            return False

    def _validate_color(self, value: str) -> bool:
        """
        Validate color code.

        Args:
            value: Color code to validate

        Returns:
            bool: True if the color code is valid, False otherwise
        """
        if not isinstance(value, str):
            return False

        # Basic color names
        basic_colors = {
            'red', 'blue', 'green', 'yellow', 'black', 'white', 'purple',
            'orange', 'brown', 'gray', 'grey', 'pink', 'teal', 'cyan',
            'magenta', 'lime', 'olive', 'navy', 'maroon', 'aqua', 'silver',
            'fuchsia'
        }

        # Check for basic color names
        if value.lower() in basic_colors:
            return True

        # Check for hex color codes
        if value.startswith('#'):
            hex_value = value[1:]
            return (len(hex_value) in (3, 6) and
                    all(c in '0123456789ABCDEFabcdef' for c in hex_value))

        # Check for rgb/rgba format
        rgb_pattern = r'^rgb\(\s*\d+\s*,\s*\d+\s*,\s*\d+\s*\)$'
        rgba_pattern = r'^rgba\(\s*\d+\s*,\s*\d+\s*,\s*\d+\s*,\s*(?:0|0?\.\d+|1(?:\.0)?)\s*\)$'

        if re.match(rgb_pattern, value) or re.match(rgba_pattern, value):
            return True

        return False

    def _validate_unique_constraints(self, form: Any) -> Dict[str, List[str]]:
        """
        Validate that fields with unique constraints have unique values.

        Args:
            form: Form object to validate

        Returns:
            Dict[str, List[str]]: Dictionary of field names and error messages
        """
        errors = {}

        for field_name in self.add_columns:
            field_config = self._get_field_config(field_name)

            if field_config.get('unique', False):
                field_value = getattr(form, field_name, None)

                if field_value is not None and field_value != '':
                    field_errors = self._check_unique_constraint(field_name, field_value)
                    if field_errors:
                        errors[field_name] = field_errors

        return errors

    def _check_unique_constraint(self, field_name: str, value: Any) -> List[str]:
        """
        Check if a field value violates unique constraints.

        Args:
            field_name: Name of the field to check
            value: Value to check for uniqueness

        Returns:
            List[str]: List of error messages or empty list if validation succeeds
        """
        errors = []
        field_label = self.label_columns.get(field_name, field_name)

        # Skip check for empty values
        if value is None or (isinstance(value, str) and not value.strip()):
            return errors

        try:
            # Build query to check uniqueness
            column = getattr(self.datamodel.obj, field_name)
            query = self.datamodel.session.query(self.datamodel.obj).filter(column == value)

            # For edit operations, exclude the current record
            item_id = getattr(self, 'item_id', None)
            if item_id:
                primary_key = self._get_primary_key()
                pk_column = getattr(self.datamodel.obj, primary_key)
                query = query.filter(pk_column != item_id)

            # Check if any records exist with this value
            existing = query.first()
            if existing:
                errors.append(f"{field_label} must be unique. Value '{value}' is already used.")
        except Exception as e:
            log.warning(f"Error checking unique constraint for {field_name}: {str(e)}")
            errors.append(f"Could not validate uniqueness of {field_label}")

        return errors

    def _validate_custom_rules(self, form: Any) -> Dict[str, List[str]]:
        """
        Validate custom business rules.

        Args:
            form: Form object to validate

        Returns:
            Dict[str, List[str]]: Dictionary of field names and error messages
        """
        errors = {}

        # Check for custom validators in form class
        for field_name, validators_list in getattr(form, 'validators', {}).items():
            for validator in validators_list:
                try:
                    if hasattr(validator, '__call__'):
                        validator(form, getattr(form, field_name, None))
                except Exception as e:
                    if field_name not in errors:
                        errors[field_name] = []
                    errors[field_name].append(str(e))

        # Check for model-level validators
        model_validator = getattr(self, 'validate_model', None)
        if model_validator and callable(model_validator):
            try:
                model_validator(form)
            except Exception as e:
                errors['__model__'] = [str(e)]

        return errors

    def _check_delete_constraints(self, item: Any) -> None:
        """
        Check if an item can be safely deleted.

        Args:
            item: Item to check

        Raises:
            ValidationError: If the item cannot be deleted
        """
        # Check for related records
        try:
            dependent_records = self._get_dependent_records(item)
            if dependent_records:
                # Format the error message with details about dependent records
                error_msg = "Cannot delete: This record is referenced by other records:\n"
                for model_name, count in dependent_records.items():
                    error_msg += f"- {model_name}: {count} record(s)\n"
                raise ValidationError(error_msg)
        except Exception as e:
            log.warning(f"Error checking delete constraints: {str(e)}")

        # Check custom delete constraints on the model
        if hasattr(item, 'check_delete_constraints'):
            try:
                item.check_delete_constraints()
            except Exception as e:
                raise ValidationError(f"Delete constraint failed: {str(e)}")

        # Check workflow state if applicable
        if self.has_workflow and hasattr(item, self.workflow_config.get('state_column', 'state')):
            state = getattr(item, self.workflow_config.get('state_column', 'state'))
            if not self._can_delete_in_state(state):
                raise ValidationError(f"Cannot delete item in state: {state}")

def _get_dependent_records(self, item: Any) -> Dict[str, int]:
        """
        Get dependent records that would prevent deletion.

        Args:
            item: Item to check

        Returns:
            Dict[str, int]: Dictionary of model names and count of dependent records
        """
        dependent_records = {}

        try:
            # Get all relationships where this model is the target
            mapper = inspect(self.datamodel.obj)
            pk_column = mapper.primary_key[0]
            pk_value = getattr(item, pk_column.name)

            for relationship in mapper.relationships:
                if relationship.direction.name == 'ONETOMANY':
                    # Get related model and table
                    related_model = relationship.mapper.class_
                    related_model_name = related_model.__name__

                    # Find foreign key referencing this model
                    for local_col, remote_col in relationship.local_remote_pairs:
                        foreign_key_name = remote_col.name

                        # Check if there are any records referencing this item
                        query = self.datamodel.session.query(func.count(getattr(related_model, foreign_key_name)))
                        query = query.filter(getattr(related_model, foreign_key_name) == pk_value)
                        count = query.scalar()

                        if count > 0:
                            dependent_records[related_model_name] = count
        except Exception as e:
            log.warning(f"Error checking dependent records: {str(e)}")

        return dependent_records

    def _can_delete_in_state(self, state: str) -> bool:
        """
        Check if deletion is allowed in the current workflow state.

        Args:
            state: Current workflow state

        Returns:
            bool: Whether deletion is allowed
        """
        if not self.has_workflow:
            return True

        # Get the state configuration
        state_config = next(
            (s for s in self.workflow_config.get('states', []) if s.get('name') == state),
            None
        )

        if state_config:
            # Check if delete is in allowed actions
            return 'delete' in state_config.get('actions', [])

        return True  # Default to allowing deletion if state not found

    def _archive_version(self, item: Any) -> None:
        """
        Archive the current version of an item before deletion.

        Args:
            item: Item to archive

        Raises:
            ValidationError: If archiving fails
        """
        if not self.has_versioning:
            return

        try:
            # Get version class or create it if it doesn't exist
            version_class = self._get_version_class()

            # Create archive record
            version_data = {
                'item_type': self.datamodel.obj.__name__,
                'item_id': getattr(item, self._get_primary_key()),
                'version': getattr(item, self.versioning_config.get('version_column', 'version'), 1),
                'data': self._serialize_item(item),
                'deleted_at': datetime.now(),
                'deleted_by_id': self._get_user_id()
            }

            archive = ArchivedVersion(**version_data)
            self.datamodel.session.add(archive)

        except Exception as e:
            log.error(f"Error archiving version: {str(e)}")
            raise ValidationError(f"Could not archive version: {str(e)}")

    def _get_version_class(self) -> Any:
        """
        Get the version model class for versioning.

        Returns:
            Any: Model class for versions
        """
        if not hasattr(self, '_version_class_cache'):
            class_name = f"{self.datamodel.obj.__name__}Version"

            # Check if class already exists in the module
            if hasattr(sys.modules[self.datamodel.obj.__module__], class_name):
                self._version_class_cache = getattr(sys.modules[self.datamodel.obj.__module__], class_name)
            else:
                # Create a new version class
                self._version_class_cache = type(
                    class_name,
                    (ArchivedVersion,),
                    {
                        '__tablename__': f'{self.datamodel.obj.__tablename__}_versions',
                        '__table_args__': {'extend_existing': True}
                    }
                )

        return self._version_class_cache

    def _update_audit_fields(self, item: Any) -> None:
        """
        Update audit fields (created_by, updated_by, timestamps) on an item.

        Args:
            item: Item to update
        """
        now = datetime.now()
        user_id = self._get_user_id()

        # Set created fields for new items
        if not getattr(item, self._get_primary_key(), None):
            if hasattr(item, 'created_at') and not getattr(item, 'created_at', None):
                setattr(item, 'created_at', now)

            if hasattr(item, 'created_by_fk') and not getattr(item, 'created_by_fk', None):
                setattr(item, 'created_by_fk', user_id)

            if hasattr(item, 'created_on') and not getattr(item, 'created_on', None):
                setattr(item, 'created_on', now)

        # Always set update fields
        if hasattr(item, 'updated_at'):
            setattr(item, 'updated_at', now)

        if hasattr(item, 'changed_by_fk'):
            setattr(item, 'changed_by_fk', user_id)

        if hasattr(item, 'changed_on'):
            setattr(item, 'changed_on', now)

    def _validate_workflow_transition(self, item: Any) -> None:
        """
        Validate workflow state transition.

        Args:
            item: Item being transitioned

        Raises:
            ValidationError: If transition is invalid
        """
        if not self.has_workflow:
            return

        state_column = self.workflow_config.get('state_column', 'state')
        if not hasattr(item, state_column):
            return

        # Get original state
        original_state = getattr(item, f'_original_{state_column}', None)
        new_state = getattr(item, state_column)

        if original_state == new_state:
            return  # No transition

        # Check if transition is allowed
        transition = self._find_transition(original_state, new_state)
        if not transition:
            raise ValidationError(
                f"Invalid state transition: {original_state} -> {new_state}. "
                f"No transition defined for this state change."
            )

        # Check transition permissions
        if 'permission' in transition and transition['permission']:
            user_roles = self._get_user_roles()
            if transition['permission'] not in user_roles:
                raise ValidationError(
                    f"You don't have permission for the {transition['name']} transition. "
                    f"Required role: {transition['permission']}"
                )

        # Check transition conditions
        for condition in transition.get('conditions', []):
            if not self._check_transition_condition(item, condition):
                message = transition.get('message', f"Condition failed: {condition}")
                raise ValidationError(f"Transition condition not met: {message}")

    def _find_transition(self, source: str, target: str) -> Optional[Dict[str, Any]]:
        """
        Find a valid transition between two states.

        Args:
            source: Source state
            target: Target state

        Returns:
            Optional[Dict[str, Any]]: Transition configuration or None if no valid transition found
        """
        if not self.has_workflow:
            return None

        transitions = self.workflow_config.get('transitions', [])
        return next(
            (t for t in transitions if t.get('source') == source and t.get('target') == target),
            None
        )

    def _check_transition_condition(self, item: Any, condition: str) -> bool:
        """
        Check if a transition condition is met.

        Args:
            item: Item being transitioned
            condition: Condition to check

        Returns:
            bool: True if condition is met, False otherwise
        """
        # Check for built-in conditions
        if condition == 'is_complete':
            return self._check_item_complete(item)

        # Check for custom condition methods on item
        if hasattr(item, condition):
            condition_method = getattr(item, condition)
            if callable(condition_method):
                return condition_method()

        # Check for custom condition methods on view
        condition_method = getattr(self, f'check_{condition}', None)
        if condition_method and callable(condition_method):
            return condition_method(item)

        # Unknown condition
        log.warning(f"Unknown transition condition: {condition}")
        return False

    def _check_item_complete(self, item: Any) -> bool:
        """
        Check if an item has all required fields filled.

        Args:
            item: Item to check

        Returns:
            bool: True if item is complete, False otherwise
        """
        try:
            # Check all required columns
            for field_name in self.add_columns:
                field_config = self._get_field_config(field_name)
                if field_config.get('required', False):
                    value = getattr(item, field_name, None)
                    if value is None or (isinstance(value, str) and not value.strip()):
                        return False
            return True
        except Exception as e:
            log.warning(f"Error checking item completeness: {str(e)}")
            return False

    def _track_changes(self, item: Any) -> None:
        """
        Track changes for version control.

        Args:
            item: Item to track changes for
        """
        if not self.has_versioning:
            return

        # Get changes
        changes = self._get_changes(item)
        if not changes:
            return  # No changes to track

        # Increment version
        version_column = self.versioning_config.get('version_column', 'version')
        current_version = getattr(item, version_column, 0) or 0
        setattr(item, version_column, current_version + 1)

        # Create version record
        try:
            # Get version class
            version_class = self._get_version_class()

            # Create version record
            version_data = {
                'item_type': self.datamodel.obj.__name__,
                'item_id': getattr(item, self._get_primary_key()),
                'version': current_version + 1,
                'changes': changes,
                'created_at': datetime.now(),
                'created_by_id': self._get_user_id(),
                'data': self._serialize_item(item)
            }

            version = version_class(**version_data)
            self.datamodel.session.add(version)

            # Prune old versions if configured
            if self.versioning_config.get('prune_old_versions', False):
                self._prune_old_versions(item)

        except Exception as e:
            log.error(f"Error creating version record: {str(e)}")

    def _get_changes(self, item: Any) -> Dict[str, Dict[str, Any]]:
        """
        Get changes between current and previous state of an item.

        Args:
            item: Item to get changes for

        Returns:
            Dict[str, Dict[str, Any]]: Dictionary of changes where keys are field names
                                      and values are dictionaries with 'old' and 'new' values
        """
        changes = {}

        # Skip if we don't have original state
        if not hasattr(item, '_original_state'):
            return changes

        # Get columns to ignore
        ignore_fields = self.versioning_config.get('ignore_fields', [])
        ignore_fields.append(self._get_primary_key())
        ignore_fields.append(self.versioning_config.get('version_column', 'version'))

        # Compare each field
        for field_name in self.edit_columns:
            if field_name in ignore_fields:
                continue

            old_value = getattr(item._original_state, field_name, None)
            new_value = getattr(item, field_name, None)

            # Skip if values are equal
            if old_value == new_value:
                continue

            # Add to changes
            changes[field_name] = {
                'old': old_value,
                'new': new_value
            }

        return changes

    def _prune_old_versions(self, item: Any) -> None:
        """
        Prune old versions beyond the maximum configured limit.

        Args:
            item: Item to prune versions for
        """
        if not self.has_versioning:
            return

        max_versions = self.versioning_config.get('max_versions', 100)
        if max_versions <= 0:
            return  # No limit

        try:
            # Get version class
            version_class = self._get_version_class()

            # Get item ID
            item_id = getattr(item, self._get_primary_key())

            # Count versions
            version_count = self.datamodel.session.query(func.count(version_class.id)).filter_by(
                item_type=self.datamodel.obj.__name__,
                item_id=item_id
            ).scalar() or 0

            # Delete oldest versions if we have too many
            if version_count > max_versions:
                # Get IDs of oldest versions
                oldest_ids = self.datamodel.session.query(version_class.id).filter_by(
                    item_type=self.datamodel.obj.__name__,
                    item_id=item_id
                ).order_by(version_class.created_at.asc()).limit(version_count - max_versions).all()

                # Delete them
                if oldest_ids:
                    self.datamodel.session.query(version_class).filter(
                        version_class.id.in_([id[0] for id in oldest_ids])
                    ).delete(synchronize_session=False)

        except Exception as e:
            log.warning(f"Error pruning old versions: {str(e)}")

    # CRUD Operations
    @handle_errors
    @audit_log('create')
    def pre_add(self, item: Any) -> None:
        """
        Pre-process item before adding.

        Args:
            item: Item to process

        Raises:
            ValidationError: If processing fails
        """
        # Process all fields
        for field_name in self.add_columns:
            value = getattr(item, field_name, None)
            if value is not None:
                processed_value = self._process_form_field(field_name, value)
                setattr(item, field_name, processed_value)

        # Set audit fields
        self._update_audit_fields(item)

        # Initialize version if versioning is enabled
        if self.has_versioning:
            version_column = self.versioning_config.get('version_column', 'version')
            setattr(item, version_column, 1)

        # Set initial state if workflow is enabled
        if self.has_workflow:
            state_column = self.workflow_config.get('state_column', 'state')
            if hasattr(item, state_column):
                initial_state = next(
                    (s['name'] for s in self.workflow_config.get('states', []) if s.get('is_initial')),
                    self.workflow_config.get('initial_state')
                )
                if initial_state:
                    setattr(item, state_column, initial_state)

        # Run custom pre-add logic
        self._run_event_handlers(self.before_create_handlers, item)

    @handle_errors
    @audit_log('update')
    def pre_update(self, item: Any) -> None:
        """
        Pre-process item before updating.

        Args:
            item: Item to process

        Raises:
            ValidationError: If processing fails
        """
        # Store original state for change tracking
        if not hasattr(item, '_original_state'):
            item._original_state = self._clone_item(item)

            # Store original workflow state if applicable
            if self.has_workflow:
                state_column = self.workflow_config.get('state_column', 'state')
                if hasattr(item, state_column):
                    setattr(item, f'_original_{state_column}', getattr(item, state_column))

        # Process all fields
        for field_name in self.edit_columns:
            value = getattr(item, field_name, None)
            if value is not None:
                processed_value = self._process_form_field(field_name, value)
                setattr(item, field_name, processed_value)

        # Validate workflow transition if applicable
        if self.has_workflow:
            self._validate_workflow_transition(item)

        # Set audit fields
        self._update_audit_fields(item)

        # Track changes if versioning is enabled
        if self.has_versioning:
            self._track_changes(item)

        # Run custom pre-update logic
        self._run_event_handlers(self.before_update_handlers, item)

    @handle_errors
    @audit_log('delete')
    def pre_delete(self, item: Any) -> None:
        """
        Pre-process item before deletion.

        Args:
            item: Item to process

        Raises:
            ValidationError: If deletion is not allowed
        """
        # Check if item can be deleted
        self._check_delete_constraints(item)

        # Archive version if versioning is enabled
        if self.has_versioning:
            self._archive_version(item)

        # Run custom pre-delete logic
        self._run_event_handlers(self.before_delete_handlers, item)

    def post_add(self, item: Any) -> None:
        """
        Post-process item after adding.

        Args:
            item: Added item
        """
        # Send workflow notifications if applicable
        if self.has_workflow:
            self._send_workflow_notifications(item, 'create')

        # Run custom post-add logic
        self._run_event_handlers(self.after_create_handlers, item)

    def post_update(self, item: Any) -> None:
        """
        Post-process item after updating.

        Args:
            item: Updated item
        """
        # Send workflow notifications if applicable
        if self.has_workflow and hasattr(item, '_original_state'):
            state_column = self.workflow_config.get('state_column', 'state')
            if hasattr(item, state_column) and hasattr(item, f'_original_{state_column}'):
                old_state = getattr(item, f'_original_{state_column}')
                new_state = getattr(item, state_column)
                if old_state != new_state:
                    self._send_workflow_notifications(item, 'transition', {
                        'from_state': old_state,
                        'to_state': new_state
                    })

        # Run custom post-update logic
        self._run_event_handlers(self.after_update_handlers, item)

    def post_delete(self, item: Any) -> None:
        """
        Post-process item after deletion.

        Args:
            item: Deleted item
        """
        # Clean up associated files if applicable
        if self.has_file_upload:
            self._cleanup_files(item)

        # Run custom post-delete logic
        self._run_event_handlers(self.after_delete_handlers, item)

    def _clone_item(self, item: Any) -> Any:
        """
        Create a shallow copy of an item.

        Args:
            item: Item to clone

        Returns:
            Any: Cloned item
        """
        # Create a new instance of the same class
        clone = self.datamodel.obj()

        # Copy all attributes
        for column in self.datamodel.obj.__table__.columns:
            setattr(clone, column.name, getattr(item, column.name, None))

        return clone

