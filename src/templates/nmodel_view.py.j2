    def bulk_edit(self, items: List[Any]) -> Response:
        """
        Bulk edit selected records.

        Args:
            items: List of records to edit

        Returns:
            Response: Redirect or rendered template
        """
        if not items:
            flash(_("No records selected to edit"), "warning")
            return redirect(self.get_redirect())

        if request.method == 'POST':
            # Get fields to update
            update_fields = request.form.getlist('update_fields')

            if not update_fields:
                flash(_("No fields selected for update"), "warning")
                return redirect(url_for(f'.bulk_edit', ids=','.join([str(item.id) for item in items])))

            try:
                updated_count = 0

                for item in items:
                    # Store original state for change tracking
                    item._original_state = self._clone_item(item)

                    # Update selected fields
                    for field in update_fields:
                        if field in self.edit_columns:
                            field_value = request.form.get(f'field_{field}')
                            processed_value = self._process_form_field(field, field_value)
                            setattr(item, field, processed_value)

                    # Process the item
                    self.pre_update(item)

                    # Save to database
                    self.datamodel.edit(item)

                    # Post-process
                    self.post_update(item)

                    updated_count += 1

                flash(_(f"Successfully updated {updated_count} records"), "success")
                return redirect(self.get_redirect())

            except Exception as e:
                flash(_(f"Error updating records: {str(e)}"), "error")
                log.exception(f"Error updating records: {str(e)}")

