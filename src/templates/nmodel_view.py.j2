    # Workflow Management
    @expose('/workflow/<pk>')
    @has_access
    @handle_errors
    def workflow(self, pk: Any) -> Response:
        """
        Show workflow status and available transitions.

        Args:
            pk: Primary key of the record

        Returns:
            Response: Rendered template with workflow status
        """
        if not self.has_workflow:
            flash(_("Workflow is not enabled for this view"), "warning")
            return redirect(self.get_redirect())

        item = self.datamodel.get(pk)
        if not item:
            flash(_("Record not found"), "warning")
            return redirect(self.get_redirect())

        # Get state column
        state_column = self.workflow_config.get('state_column', 'state')
        if not hasattr(item, state_column):
            flash(_(f"Record does not have a {state_column} column"), "warning")
            return redirect(self.get_redirect())

        # Get current state
        current_state = getattr(item, state_column)

        # Get state configuration
        state_config = next(
            (s for s in self.workflow_config.get('states', []) if s.get('name') == current_state),
            None
        )

        if not state_config:
            flash(_(f"Unknown state: {current_state}"), "warning")
            return redirect(self.get_redirect())

        # Get available transitions
        available_transitions = []
        for transition in self.workflow_config.get('transitions', []):
            if transition.get('source') == current_state:
                # Check permissions
                if 'permission' in transition and transition['permission']:
                    if not self._user_has_role(transition['permission']):
                        continue

                # Check conditions
                conditions_met = True
                for condition in transition.get('conditions', []):
                    if not self._check_transition_condition(item, condition):
                        conditions_met = False
                        break

                if conditions_met:
                    available_transitions.append(transition)

        return self.render_template(
            'workflow.html',
            title=_(f"Workflow Status for {item}"),
            item=item,
            pk=pk,
            current_state=current_state,
            state_config=state_config,
            available_transitions=available_transitions,
            workflow_config=self.workflow_config,
            state_column=state_column
        )

    @expose('/workflow/<pk>/transition/<transition_name>', methods=['GET', 'POST'])
    @has_access
    @handle_errors
    @csrf_protect
    def transition(self, pk: Any, transition_name: str) -> Response:
        """
        Execute workflow transition.

        Args:
            pk: Primary key of the record
            transition_name: Name of the transition to execute

        Returns:
            Response: Redirect with status message
        """
        if not self.has_workflow:
            flash(_("Workflow is not enabled for this view"), "warning")
            return redirect(self.get_redirect())

        item = self.datamodel.get(pk)
        if not item:
            flash(_("Record not found"), "warning")
            return redirect(self.get_redirect())

        # Get state column
        state_column = self.workflow_config.get('state_column', 'state')
        if not hasattr(item, state_column):
            flash(_(f"Record does not have a {state_column} column"), "warning")
            return redirect(self.get_redirect())

        # Get current state
        current_state = getattr(item, state_column)

        # Find transition
        transition = next(
            (t for t in self.workflow_config.get('transitions', []) if t.get('name') == transition_name and t.get('source') == current_state),
            None
        )

        if not transition:
            flash(_(f"Invalid transition: {transition_name}"), "warning")
            return redirect(url_for(f'.workflow', pk=pk))

        # Check permissions
        if 'permission' in transition and transition['permission']:
            if not self._user_has_role(transition['permission']):
                flash(_("You don't have permission to execute this transition"), "warning")
                return redirect(url_for(f'.workflow', pk=pk))

        # Check conditions
        for condition in transition.get('conditions', []):
            if not self._check_transition_condition(item, condition):
                message = transition.get('message', f"Condition failed: {condition}")
                flash(_(message), "warning")
                return redirect(url_for(f'.workflow', pk=pk))

        # Store original state for change tracking
        item._original_state = self._clone_item(item)
        setattr(item, f'_original_{state_column}', current_state)

        # Update state
        target_state = transition.get('target')
        setattr(item, state_column, target_state)

        # Process comment if provided
        if request.method == 'POST':
            comment = request.form.get('comment')
            if comment and hasattr(item, 'workflow_comments'):
                # Add comment to workflow history
                if isinstance(item.workflow_comments, list):
                    item.workflow_comments.append({
                        'from_state': current_state,
                        'to_state': target_state,
                        'comment': comment,
                        'timestamp': datetime.now().isoformat(),
                        'user_id': self._get_user_id()
                    })
                elif isinstance(item.workflow_comments, str):
                    try:
                        comments = json.loads(item.workflow_comments)
                    except:
                        comments = []

                    comments.append({
                        'from_state': current_state,
                        'to_state': target_state,
                        'comment': comment,
                        'timestamp': datetime.now().isoformat(),
                        'user_id': self._get_user_id()
                    })

                    item.workflow_comments = json.dumps(comments)

        # Process the item
        self.pre_update(item)

        # Save to database
        self.datamodel.edit(item)

        # Post-process
        self.post_update(item)

        flash(_(f"Successfully transitioned from {current_state} to {target_state}"), "success")

        # Redirect to appropriate page
        if request.args.get('next'):
            return redirect(request.args.get('next'))

        return redirect(url_for(f'.show', pk=pk))

    # Helper for permissions
    def _check_item_permissions(self, item: Any, operation: str) -> bool:
        """
        Check item-level permissions for API access.

        Args:
            item: Item to check permissions for
            operation: Operation type (read, edit, delete)

        Returns:
            bool: True if user has permission, False otherwise
        """
        # Check custom item permissions method
        if hasattr(item, 'has_permission'):
            try:
                return item.has_permission(operation, self._get_user_id())
            except Exception as e:
                log.warning(f"Error checking item permission: {str(e)}")

        # Check common owner fields
        user_id = self._get_user_id()
        if user_id:
            for field in ['created_by_fk', 'owner_id', 'user_id']:
                if hasattr(item, field) and getattr(item, field) == user_id:
                    return True

        # Check role-based permissions for operations
        if operation == 'read' and not self.can_show:
            return False
        elif operation == 'edit' and not self.can_edit:
            return False
        elif operation == 'delete' and not self.can_delete:
            return False

        # Default permissions
        return True

