    @action("archive_selected", "Archive", "Archive selected records?", "fa-archive")
    @handle_errors
    def archive_selected(self, items: List[Any]) -> Response:
        """
        Archive selected records.

        Args:
            items: List of records to archive

        Returns:
            Response: Redirect with status message
        """
        if not items:
            flash(_("No records selected to archive"), "warning")
            return redirect(self.get_redirect())

        try:
            archived_count = 0

            for item in items:
                if hasattr(item, 'is_archived'):
                    # Store original state for change tracking
                    item._original_state = self._clone_item(item)

                    # Set archived flag
                    item.is_archived = True

                    if hasattr(item, 'archived_at'):
                        item.archived_at = datetime.now()

                    if hasattr(item, 'archived_by_fk'):
                        item.archived_by_fk = self._get_user_id()

                    # Process the item
                    self.pre_update(item)

                    # Save to database
                    self.datamodel.edit(item)

                    # Post-process
                    self.post_update(item)

                    archived_count += 1

            if archived_count > 0:
                flash(_(f"Successfully archived {archived_count} records"), "success")
            else:
                flash(_("No records were archived. Archiving requires an 'is_archived' field."), "warning")

        except Exception as e:
            flash(_(f"Error archiving records: {str(e)}"), "error")
            log.exception(f"Error archiving records: {str(e)}")

        return redirect(self.get_redirect())

