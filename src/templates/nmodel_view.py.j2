    def _cleanup_files(self, item: Any) -> None:
        """
        Clean up files associated with a deleted item.

        Args:
            item: Deleted item
        """
        if not self.has_file_upload:
            return

        upload_folder = self.upload_config['upload_folder']

        # Find all file fields
        for field_name in self.show_columns:
            if field_name.endswith(('_file', '_document', '_img', '_image', '_photo')):
                filename = getattr(item, field_name, None)
                if filename:
                    # Delete the file
                    file_path = os.path.join(upload_folder, filename)
                    try:
                        if os.path.exists(file_path):
                            os.remove(file_path)

                        # Also delete thumbnail if it exists
                        if field_name.endswith(('_img', '_image', '_photo')):
                            thumb_path = os.path.splitext(file_path)
                            thumb_path = f"{thumb_path[0]}_thumb{thumb_path[1]}"
                            if os.path.exists(thumb_path):
                                os.remove(thumb_path)
                    except Exception as e:
                        log.warning(f"Error cleaning up file {file_path}: {str(e)}")

# API Endpoints
    @expose('/api', methods=['GET'])
    @has_access_api
    @api_handle_errors
    @rate_limited(100, 60)  # 100 requests per minute
    def api_list(self) -> Response:
        """
        API endpoint for list view with pagination, filtering, and sorting.

        This endpoint provides a comprehensive interface for listing records with
        support for pagination, filtering, sorting, and search.

        Query Parameters:
            page (int): Page number (1-indexed)
            page_size (int): Number of items per page
            sort_column (str): Column to sort by
            sort_direction (str): 'asc' or 'desc'
            filters (str): JSON-encoded filter criteria
            search (str): Search query

        Returns:
            Response: JSON response with paginated list of records
        """
        if not self.has_api:
            return self.response(404, {'message': 'API not enabled for this resource'})

        # Get pagination parameters
        page = request.args.get('page', 1, type=int)
        page_size = request.args.get('page_size', self.api_config.get('default_page_size', 20), type=int)

        # Check page size is within limits
        max_page_size = self.api_config.get('max_page_size', 1000)
        if page_size > max_page_size:
            return self.response(400, {
                'message': f'Page size exceeds maximum ({max_page_size})',
                'error': 'page_size_exceeds_maximum'
            })

        # Build query
        query = self._get_base_query()

        # Apply filters
        query = self._apply_api_filters(query)

        # Apply search
        search_query = request.args.get('search', '')
        if search_query:
            query = self._apply_search(query, search_query)

        # Apply sorting
        query = self._apply_api_ordering(query)

        # Get total count if requested
        total_count = None
        if self.api_config.get('include_count', True):
            total_count = query.count()

        # Apply pagination
        items = query.offset((page - 1) * page_size).limit(page_size).all()

        # Prepare response
        response_data = {
            'data': [self._serialize_item(item) for item in items],
            'page': page,
            'page_size': page_size
        }

        # Add pagination metadata if count was requested
        if total_count is not None:
            total_pages = (total_count + page_size - 1) // page_size if total_count > 0 else 1
            response_data.update({
                'total_count': total_count,
                'total_pages': total_pages,
                'has_next': page < total_pages,
                'has_prev': page > 1
            })

        # Add HATEOAS links if enabled
        if self.api_config.get('hateoas', False):
            self._add_hateoas_links(response_data, page, page_size, total_pages)

        return self.response(200, response_data)

    def _apply_api_filters(self, query: Any) -> Any:
        """
        Apply filters from API request parameters.

        Args:
            query: Base SQLAlchemy query

        Returns:
            Any: Filtered query
        """
        filters_param = request.args.get('filters', '{}')
        try:
            filters = json.loads(filters_param)

            if not isinstance(filters, dict):
                raise ValidationError("Filters parameter must be a JSON object")

            for field, value in filters.items():
                # Skip undefined columns
                if not hasattr(self.datamodel.obj, field):
                    continue

                column = getattr(self.datamodel.obj, field)

                # Handle various filter types
                if isinstance(value, dict):
                    # Complex filter with operators
                    for op, filter_value in value.items():
                        if op == 'eq':
                            query = query.filter(column == filter_value)
                        elif op == 'ne':
                            query = query.filter(column != filter_value)
                        elif op == 'gt':
                            query = query.filter(column > filter_value)
                        elif op == 'lt':
                            query = query.filter(column < filter_value)
                        elif op == 'ge':
                            query = query.filter(column >= filter_value)
                        elif op == 'le':
                            query = query.filter(column <= filter_value)
                        elif op == 'in':
                            query = query.filter(column.in_(filter_value))
                        elif op == 'not_in':
                            query = query.filter(~column.in_(filter_value))
                        elif op == 'between':
                            if len(filter_value) == 2:
                                query = query.filter(column.between(filter_value[0], filter_value[1]))
                        elif op == 'like':
                            query = query.filter(column.like(f'%{filter_value}%'))
                        elif op == 'ilike':
                            query = query.filter(column.ilike(f'%{filter_value}%'))
                        elif op == 'startswith':
                            query = query.filter(column.startswith(filter_value))
                        elif op == 'endswith':
                            query = query.filter(column.endswith(filter_value))
                        elif op == 'is_null':
                            if filter_value:
                                query = query.filter(column.is_(None))
                            else:
                                query = query.filter(column.is_not(None))
                else:
                    # Simple equality filter
                    if value is None:
                        query = query.filter(column.is_(None))
                    else:
                        query = query.filter(column == value)

        except json.JSONDecodeError:
            # Ignore invalid JSON
            pass
        except Exception as e:
            log.warning(f"Error applying API filters: {str(e)}")

        return query

    def _apply_api_ordering(self, query: Any) -> Any:
        """
        Apply sorting from API request parameters.

        Args:
            query: Base SQLAlchemy query

        Returns:
            Any: Sorted query
        """
        sort_column = request.args.get('sort_column', self.base_order[0] if self.base_order else None)
        sort_direction = request.args.get('sort_direction', self.base_order[1] if self.base_order else 'asc')

        if sort_column and hasattr(self.datamodel.obj, sort_column):
            column = getattr(self.datamodel.obj, sort_column)

            if sort_direction.lower() == 'desc':
                query = query.order_by(desc(column))
            else:
                query = query.order_by(asc(column))

        return query

    def _add_hateoas_links(self, response_data: Dict[str, Any], page: int, page_size: int, total_pages: int) -> None:
        """
        Add HATEOAS links to API response.

        Args:
            response_data: Response data dictionary to modify
            page: Current page number
            page_size: Number of items per page
            total_pages: Total number of pages
        """
        base_url = request.base_url
        args = request.args.copy()

        links = {
            'self': self._build_url(base_url, args, page=page)
        }

        # Add first, prev, next, last links
        links['first'] = self._build_url(base_url, args, page=1)

        if page > 1:
            links['prev'] = self._build_url(base_url, args, page=page-1)

        if page < total_pages:
            links['next'] = self._build_url(base_url, args, page=page+1)

        links['last'] = self._build_url(base_url, args, page=total_pages)

        response_data['links'] = links

    def _build_url(self, base_url: str, args: Dict[str, Any], **kwargs) -> str:
        """
        Build URL with updated query parameters.

        Args:
            base_url: Base URL
            args: Current query parameters
            **kwargs: Parameters to update

        Returns:
            str: Updated URL
        """
        query_args = args.copy()
        for key, value in kwargs.items():
            query_args[key] = value

        query_string = '&'.join(f"{key}={value}" for key, value in query_args.items())
        return f"{base_url}?{query_string}"

    def response(self, status: int, data: Dict[str, Any], headers: Dict[str, str] = None) -> Response:
        """
        Create standardized API response.

        Args:
            status: HTTP status code
            data: Response data
            headers: Optional response headers

        Returns:
            Response: Flask response object
        """
        headers = headers or {}

        # Add standard headers
        headers.update({
            'Content-Type': 'application/json',
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
            'Access-Control-Allow-Headers': 'Content-Type, Authorization'
        })

        # Add API version if configured
        api_version = getattr(current_app.config, 'API_VERSION', None)
        if api_version:
            headers['X-API-Version'] = api_version

        # Add rate limit headers if enabled
        if self.has_rate_limit:
            rate_limit = self.rate_limit_config.get('limits', {}).get('api_list', {})
            if rate_limit:
                headers['X-RateLimit-Limit'] = str(rate_limit.get('limit', 100))

        response = Response(
            json.dumps(data),
            status=status,
            headers=headers
        )

        return response

    @expose('/api/<pk>', methods=['GET'])
    @has_access_api
    @api_handle_errors
    @rate_limited(120, 60)  # 120 requests per minute
    def api_show(self, pk: Any) -> Response:
        """
        API endpoint for retrieving a single record by ID.

        Args:
            pk: Primary key of the record

        Returns:
            Response: JSON response with record details
        """
        if not self.has_api:
            return self.response(404, {'message': 'API not enabled for this resource'})

        item = self.datamodel.get(pk)
        if not item:
            return self.response(404, {'message': 'Resource not found'})

        # Check item-level permissions
        if not self._check_item_permissions(item, 'read'):
            return self.response(403, {'message': 'Access denied to this resource'})

        # Get query parameters
        include_related = request.args.get('include_related', 'false').lower() == 'true'

        # Serialize item
        data = self._serialize_item(item, with_related=include_related)

        return self.response(200, data)

