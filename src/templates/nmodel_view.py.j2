    @expose('/api/bulk', methods=['POST'])
    @has_access_api
    @api_handle_errors
    @csrf_protect
    @rate_limited(10, 60)  # 10 requests per minute
    def api_bulk(self) -> Response:
        """
        API endpoint for bulk operations.

        This endpoint supports bulk create, update, and delete operations.

        Returns:
            Response: JSON response with operation results
        """
        if not self.has_api:
            return self.response(404, {'message': 'API not enabled for this resource'})

        if not request.is_json:
            return self.response(400, {'message': 'Invalid request. Content-Type must be application/json'})

        try:
            data = request.get_json()

            if not isinstance(data, dict) or 'operation' not in data or 'items' not in data:
                return self.response(400, {'message': 'Invalid request format. Must include "operation" and "items"'})

            operation = data['operation'].lower()
            items = data['items']

            if not isinstance(items, list):
                return self.response(400, {'message': 'Items must be a list'})

            # Check if operation is allowed
            if operation not in self.api_config.get('bulk_actions', []):
                return self.response(400, {'message': f'Bulk operation "{operation}" is not allowed'})

            # Process based on operation
            if operation == 'create':
                return self._api_bulk_create(items)
            elif operation == 'update':
                return self._api_bulk_update(items)
            elif operation == 'delete':
                return self._api_bulk_delete(items)
            else:
                return self.response(400, {'message': f'Unknown operation: {operation}'})

        except Exception as e:
            return self.response(500, {'message': f'Error processing bulk operation: {str(e)}'})

    def _api_bulk_create(self, items: List[Dict[str, Any]]) -> Response:
        """
        Process bulk create operation.

        Args:
            items: List of item data dictionaries

        Returns:
            Response: JSON response with operation results
        """
        if not self.can_create:
            return self.response(403, {'message': 'No permission to create'})

        results = []
        successful = 0
        failed = 0

        for item_data in items:
            try:
                # Validate data
                validation_errors = self._validate_api_data(item_data, is_update=False)
                if validation_errors:
                    results.append({
                        'success': False,
                        'errors': validation_errors,
                        'data': item_data
                    })
                    failed += 1
                    continue

                # Create new instance
                item = self.datamodel.obj()

                # Set attributes
                for key, value in item_data.items():
                    # Skip primary key and read-only fields
                    if key == self._get_primary_key() or key in self.api_config.get('read_only_fields', []):
                        continue

                    setattr(item, key, value)

                # Process the item
                self.pre_add(item)

                # Save to database
                self.datamodel.add(item)

                # Post-process
                self.post_add(item)

                results.append({
                    'success': True,
                    'id': getattr(item, self._get_primary_key()),
                    'data': self._serialize_item(item)
                })
                successful += 1

            except Exception as e:
                results.append({
                    'success': False,
                    'errors': str(e),
                    'data': item_data
                })
                failed += 1

        return self.response(200, {
            'message': f'Bulk create completed: {successful} successful, {failed} failed',
            'results': results
        })

