# Exceptions
class ViewException(Exception):
    """Base exception class for view-related errors"""
    status_code = 400

    def __init__(self, message: str, status_code: Optional[int] = None):
        self.message = message
        if status_code is not None:
            self.status_code = status_code
        super().__init__(self.message)


class PermissionDenied(ViewException):
    """Exception raised when a user doesn't have required permissions"""
    status_code = 403


class ResourceNotFound(ViewException):
    """Exception raised when a requested resource is not found"""
    status_code = 404


class ValidationError(ViewException):
    """Exception raised during validation failures"""
    status_code = 422

    def __init__(self, message: str, errors: Optional[Dict[str, List[str]]] = None):
        super().__init__(message)
        self.errors = errors or {}


class RateLimitError(ViewException):
    """Exception raised when rate limit is exceeded"""
    status_code = 429


class CSRFError(ViewException):
    """Exception raised for CSRF validation failures"""
    status_code = 400


# Decorators
def handle_errors(f: Callable) -> Callable:
    """
    Enhanced error handling decorator that catches exceptions and handles them appropriately.

    This decorator logs errors, flashes appropriate messages to the user, and redirects to
    a safe page when an error occurs. It handles different types of errors differently.

    Args:
        f: The function to wrap with error handling

    Returns:
        The wrapped function with error handling
    """
    @wraps(f)
    def wrapper(self, *args, **kwargs):
        try:
            return f(self, *args, **kwargs)
        except PermissionDenied as e:
            log.warning(f"Permission denied in {f.__name__}: {str(e)}")
            flash(markupsafe.escape(str(e)), "danger")
            return redirect(self.get_redirect())
        except ValidationError as e:
            log.warning(f"Validation error in {f.__name__}: {str(e)}")
            # Display field-specific errors if available
            if hasattr(e, 'errors') and e.errors:
                for field, errors in e.errors.items():
                    for error in errors:
                        flash(f"{field}: {markupsafe.escape(error)}", "warning")
            else:
                flash(markupsafe.escape(str(e)), "warning")
            return redirect(self.get_redirect())
        except ResourceNotFound as e:
            log.warning(f"Resource not found in {f.__name__}: {str(e)}")
            flash(markupsafe.escape(str(e)), "warning")
            return redirect(self.get_redirect())
        except RateLimitError as e:
            log.warning(f"Rate limit exceeded in {f.__name__}: {str(e)}")
            flash(markupsafe.escape(str(e)), "warning")
            return redirect(self.get_redirect())
        except CSRFError as e:
            log.warning(f"CSRF error in {f.__name__}: {str(e)}")
            flash(markupsafe.escape(str(e)), "danger")
            return redirect(self.get_redirect())
        except Exception as e:
            log.error(f"Error in {f.__name__}: {str(e)}", exc_info=True)
            # Provide a generic message to avoid exposing sensitive information
            flash(__("An unexpected error occurred. Please try again or contact support."), "error")
            return redirect(self.get_redirect())
    return wrapper


def api_handle_errors(f: Callable) -> Callable:
    """
    Error handling decorator specifically for API endpoints.

    This decorator catches exceptions and returns them as properly formatted JSON responses
    with appropriate HTTP status codes. It sanitizes error messages to avoid exposing
    sensitive information.

    Args:
        f: The API function to wrap with error handling

    Returns:
        The wrapped function with API-specific error handling
    """
    @wraps(f)
    def wrapper(self, *args, **kwargs):
        try:
            return f(self, *args, **kwargs)
        except PermissionDenied as e:
            log.warning(f"API permission denied in {f.__name__}: {str(e)}")
            return self.response(
                e.status_code,
                {"message": "Permission denied", "error": str(e)}
            )
        except ValidationError as e:
            log.warning(f"API validation error in {f.__name__}: {str(e)}")
            return self.response(
                e.status_code,
                {"message": "Validation error", "error": str(e), "errors": getattr(e, 'errors', {})}
            )
        except ResourceNotFound as e:
            log.warning(f"API resource not found in {f.__name__}: {str(e)}")
            return self.response(
                e.status_code,
                {"message": "Resource not found", "error": str(e)}
            )
        except RateLimitError as e:
            log.warning(f"API rate limit exceeded in {f.__name__}: {str(e)}")
            return self.response(
                e.status_code,
                {"message": "Rate limit exceeded", "error": str(e)}
            )
        except Exception as e:
            log.error(f"API error in {f.__name__}: {str(e)}", exc_info=True)
            # Provide a generic message to avoid exposing sensitive information
            return self.response(
                500,
                {"message": "Internal server error", "error": "An unexpected error occurred"}
            )
    return wrapper


def require_feature(feature_name: str) -> Callable:
    """
    Decorator to check if a feature is enabled before executing a method.

    Args:
        feature_name: The name of the feature to check

    Returns:
        Decorator function that checks for the feature
    """
    def decorator(f: Callable) -> Callable:
        @wraps(f)
        def wrapper(self, *args, **kwargs):
            if not getattr(self, f'has_{feature_name}', False):
                flash(_(f"{feature_name} feature is not enabled"), "warning")
                return redirect(self.get_redirect())
            return f(self, *args, **kwargs)
        return wrapper
    return decorator


def audit_log(action_type: str) -> Callable:
    """
    Decorator to log actions performed on records.

    Args:
        action_type: The type of action being performed (create, update, delete, etc.)

    Returns:
        Decorator function that logs the action
    """
    def decorator(f: Callable) -> Callable:
        @wraps(f)
        def wrapper(self, *args, **kwargs):
            result = f(self, *args, **kwargs)
            # Get the item being acted upon (first argument is typically the item)
            item = args[0] if args else None
            self._log_action(action_type, item)
            return result
        return wrapper
    return decorator


def csrf_protect(f: Callable) -> Callable:
    """
    Decorator to protect against Cross-Site Request Forgery (CSRF) attacks.

    This decorator validates that the request includes a valid CSRF token before
    processing POST, PUT, DELETE, or PATCH requests.

    Args:
        f: The function to protect against CSRF

    Returns:
        The wrapped function with CSRF protection
    """
    @wraps(f)
    def wrapper(self, *args, **kwargs):
        if request.method in ('POST', 'PUT', 'DELETE', 'PATCH'):
            token = request.form.get('csrf_token') or request.headers.get('X-CSRF-Token')
            if not token or not validate_csrf(token):
                if request.is_xhr or request.path.startswith('/api/'):
                    return jsonify({"error": "CSRF validation failed"}), 400
                flash(__("CSRF validation failed. Please try again."), "danger")
                return redirect(self.get_redirect())
        return f(self, *args, **kwargs)
    return wrapper


def rate_limited(limit: int, period: int = 60) -> Callable:
    """
    Decorator to apply rate limiting to API endpoints.

    Args:
        limit: Maximum number of requests allowed in the period
        period: Time period in seconds

    Returns:
        Decorator function that enforces rate limits
    """
    def decorator(f: Callable) -> Callable:
        @wraps(f)
        def wrapper(self, *args, **kwargs):
            key = f"rate_limit:{request.remote_addr}:{f.__name__}"
            current = cache.get(key, 0)

            if current >= limit:
                raise RateLimitError(f"Rate limit exceeded. Try again in {period} seconds.")

            # Increment counter
            cache.set(key, current + 1, timeout=period)

            # Add rate limit headers
            response = f(self, *args, **kwargs)

            if isinstance(response, Response):
                response.headers['X-RateLimit-Limit'] = str(limit)
                response.headers['X-RateLimit-Remaining'] = str(limit - current - 1)
                response.headers['X-RateLimit-Reset'] = str(int(time.time()) + period)

            return response
        return wrapper
    return decorator


