    @action("clone_selected", "Clone Records", "Clone selected records?", "fa-clone")
    @handle_errors
    def clone_selected(self, items: List[Any]) -> Response:
        """
        Clone selected records.

        Args:
            items: List of records to clone

        Returns:
            Response: Redirect with status message
        """
        if not items:
            flash(_("No records selected to clone"), "warning")
            return redirect(self.get_redirect())

        try:
            cloned_count = 0

            for item in items:
                # Create new instance
                new_item = self.datamodel.obj()

                # Copy attributes
                for column in self.datamodel.obj.__table__.columns:
                    if column.name != self._get_primary_key():
                        setattr(new_item, column.name, getattr(item, column.name))

                # Process the new item
                self.pre_add(new_item)

                # Save to database
                self.datamodel.add(new_item)

                # Post-process
                self.post_add(new_item)

                cloned_count += 1

            flash(_(f"Successfully cloned {cloned_count} records"), "success")

        except Exception as e:
            flash(_(f"Error cloning records: {str(e)}"), "error")
            log.exception(f"Error cloning records: {str(e)}")

        return redirect(self.get_redirect())

    @action("bulk_edit", "Bulk Edit", "Edit selected records?", "fa-edit")
