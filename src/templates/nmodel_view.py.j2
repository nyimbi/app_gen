def __init__(self, **kwargs):
        """
        Initialize the view with proper validation and feature detection.

        This method sets up all necessary components, validates configurations,
        and initializes features based on the provided configuration.

        Args:
            **kwargs: Additional keyword arguments to pass to the parent class
        """
        super().__init__(**kwargs)
        self._validate_required_configs()
        self._init_features()
        self._init_formatters()
        self._init_validators()
        self._init_event_handlers()
        self._init_csrf_tokens()

        # Store metadata about the model
        self.model_name = self.datamodel.obj.__name__
        self.table_name = self.datamodel.obj.__tablename__
        self.primary_key = self._get_primary_key()

        # Initialize API documentation
        if getattr(self, 'has_api', False):
            self._init_api_docs()

        # Set up caching
        self.cache_enabled = getattr(current_app.config, 'CACHE_ENABLED', False)
        self.cache_timeout = getattr(current_app.config, 'CACHE_DEFAULT_TIMEOUT', 300)

    def _validate_required_configs(self):
        """
        Validate that required configurations are present and properly structured.

        Raises:
            ValueError: If a required configuration is missing or invalid
        """
        # Check essential configurations
        required = [
            ('list_columns', list),
            ('label_columns', dict)
        ]

        for config, expected_type in required:
            if not hasattr(self, config):
                raise ValueError(f"Missing required configuration: {config}")

            value = getattr(self, config)
            if not isinstance(value, expected_type):
                raise ValueError(f"Configuration {config} must be a {expected_type.__name__}")

        # Validate specific configurations if present
        if hasattr(self, 'upload_config'):
            self._validate_upload_config()

        if hasattr(self, 'workflow_config'):
            self._validate_workflow_config()

        if hasattr(self, 'versioning_config'):
            self._validate_versioning_config()

        if hasattr(self, 'dynamic_form_config'):
            self._validate_dynamic_form_config()

        if hasattr(self, 'api_config'):
            self._validate_api_config()

        if hasattr(self, 'rate_limit_config'):
            self._validate_rate_limit_config()

    def _validate_upload_config(self):
        """
        Validate file upload configuration.

        Raises:
            ValueError: If the upload configuration is invalid
        """
        config = self.upload_config

        # Check required fields
        required_fields = ['enabled', 'allowed_extensions', 'max_size', 'upload_folder']
        for field in required_fields:
            if field not in config:
                raise ValueError(f"Missing required field '{field}' in upload_config")

        # Check upload folder exists and is writable
        if config.get('enabled', False) and config.get('storage_type', 'local') == 'local':
            folder = config['upload_folder']
            if not os.path.exists(folder):
                try:
                    os.makedirs(folder, exist_ok=True)
                    log.info(f"Created upload folder: {folder}")
                except Exception as e:
                    raise ValueError(f"Could not create upload folder '{folder}': {str(e)}")
            elif not os.access(folder, os.W_OK):
                raise ValueError(f"Upload folder '{folder}' is not writable")

    def _validate_workflow_config(self):
        """
        Validate workflow configuration.

        Raises:
            ValueError: If the workflow configuration is invalid
        """
        config = self.workflow_config

        # Check required fields
        if not config.get('enabled', False):
            return

        # Check for state column
        state_column = config.get('state_column', 'state')
        if not hasattr(self.datamodel.obj, state_column):
            raise ValueError(f"Workflow state column '{state_column}' does not exist on the model")

        # Check states configuration
        states = config.get('states', [])
        if not states:
            raise ValueError("Workflow configuration must include at least one state")

        # Check for initial state
        initial_states = [s for s in states if s.get('is_initial', False)]
        if not initial_states:
            raise ValueError("Workflow configuration must include an initial state")

        # Check transitions
        transitions = config.get('transitions', [])
        if not transitions:
            raise ValueError("Workflow configuration must include at least one transition")

        # Validate transitions
        state_names = {s['name'] for s in states}
        for transition in transitions:
            if 'source' not in transition or 'target' not in transition:
                raise ValueError("Workflow transitions must include source and target states")

            if transition['source'] not in state_names:
                raise ValueError(f"Transition source state '{transition['source']}' is not defined")

            if transition['target'] not in state_names:
                raise ValueError(f"Transition target state '{transition['target']}' is not defined")

    def _validate_versioning_config(self):
        """
        Validate versioning configuration.

        Raises:
            ValueError: If the versioning configuration is invalid
        """
        config = self.versioning_config

        # Check required fields
        if not config.get('enabled', False):
            return

        # Check for version column
        version_column = config.get('version_column', 'version')
        if not hasattr(self.datamodel.obj, version_column):
            raise ValueError(f"Version column '{version_column}' does not exist on the model")

    def _validate_dynamic_form_config(self):
        """
        Validate dynamic form configuration.

        Raises:
            ValueError: If the dynamic form configuration is invalid
        """
        config = self.dynamic_form_config

        # Check required fields
        if not config.get('enabled', False):
            return

        # Validate conditional fields
        conditional_fields = config.get('conditional_fields', {})
        for field, conditions in conditional_fields.items():
            if not hasattr(self.datamodel.obj, field):
                raise ValueError(f"Conditional field '{field}' does not exist on the model")

            for condition in conditions:
                if 'field' not in condition or 'value' not in condition:
                    raise ValueError(f"Conditional field '{field}' has invalid condition: {condition}")

                if not hasattr(self.datamodel.obj, condition['field']):
                    raise ValueError(f"Condition field '{condition['field']}' for '{field}' does not exist on the model")

    def _validate_api_config(self):
        """
        Validate API configuration.

        Raises:
            ValueError: If the API configuration is invalid
        """
        config = self.api_config

        # Check required fields
        if not config.get('enabled', False):
            return

        # Check maximum page size
        max_page_size = config.get('max_page_size', 1000)
        if max_page_size <= 0:
            raise ValueError("API max_page_size must be a positive number")

    def _validate_rate_limit_config(self):
        """
        Validate rate limiting configuration.

        Raises:
            ValueError: If the rate limit configuration is invalid
        """
        config = self.rate_limit_config

        # Check required fields
        if not config.get('enabled', False):
            return

        # Check default values
        default_limit = config.get('default_limit', 100)
        if default_limit <= 0:
            raise ValueError("Rate limit default_limit must be a positive number")

        default_period = config.get('default_period', 3600)
        if default_period <= 0:
            raise ValueError("Rate limit default_period must be a positive number")

        # Check method-specific limits
        limits = config.get('limits', {})
        for method, limit_config in limits.items():
            if 'limit' not in limit_config or 'period' not in limit_config:
                raise ValueError(f"Rate limit for method '{method}' must include 'limit' and 'period'")

            if limit_config['limit'] <= 0:
                raise ValueError(f"Rate limit for method '{method}' must be a positive number")

            if limit_config['period'] <= 0:
                raise ValueError(f"Rate limit period for method '{method}' must be a positive number")

    def _init_features(self):
        """
        Initialize enabled features based on configuration.

        Sets boolean flags for each feature to easily check if it's enabled.
        """
        # Core features
        self.has_file_upload = hasattr(self, 'upload_config') and self.upload_config.get('enabled', False)
        self.has_workflow = hasattr(self, 'workflow_config') and self.workflow_config.get('enabled', False)
        self.has_versioning = hasattr(self, 'versioning_config') and self.versioning_config.get('enabled', False)
        self.has_dynamic_forms = hasattr(self, 'dynamic_form_config') and self.dynamic_form_config.get('enabled', False)
        self.has_api = hasattr(self, 'api_config') and self.api_config.get('enabled', False)

        # Security features
        self.has_rate_limit = hasattr(self, 'rate_limit_config') and self.rate_limit_config.get('enabled', False)
        self.has_csrf = not hasattr(self, 'csrf_exempt_list') or not request.endpoint in self.csrf_exempt_list

        # Additional features
        self.has_bulk_actions = self.api_config.get('bulk_actions', []) if self.has_api else []
        self.has_search = hasattr(self, 'search_columns') and bool(self.search_columns)
        self.has_export = hasattr(self, 'export_types') and bool(self.export_types)

        # Log enabled features for debugging
        log.debug(f"Enabled features for {self.__class__.__name__}: " +
                 f"file_upload={self.has_file_upload}, workflow={self.has_workflow}, " +
                 f"versioning={self.has_versioning}, dynamic_forms={self.has_dynamic_forms}, " +
                 f"api={self.has_api}, rate_limit={self.has_rate_limit}, " +
                 f"bulk_actions={self.has_bulk_actions}, search={self.has_search}, " +
                 f"export={self.has_export}")

    def _init_formatters(self):
        """
        Initialize field formatters for proper data display.

        This method sets up formatters for all columns based on their types and
        custom formatter definitions.
        """
        self.formatters_columns = {}

        # Get model columns
        try:
            mapper = inspect(self.datamodel.obj)
            columns = {c.key: c for c in mapper.columns}
        except Exception as e:
            log.warning(f"Error inspecting model columns: {str(e)}")
            columns = {}

        # Set up formatters for each column in list view
        for column_name in self.list_columns:
            # Skip columns that don't exist
            if column_name not in columns and not hasattr(self.datamodel.obj, column_name):
                continue

            # Try to get custom formatter from field_type_config
            formatter = self._get_formatter(column_name)
            if formatter:
                self.formatters_columns[column_name] = formatter
                continue

            # Auto-detect formatter based on column type
            if column_name in columns:
                column = columns[column_name]
                formatter = self._get_formatter_for_type(column.type)
                if formatter:
                    self.formatters_columns[column_name] = formatter

    def _get_formatter_for_type(self, column_type):
        """
        Get an appropriate formatter for a SQLAlchemy column type.

        Args:
            column_type: SQLAlchemy column type

        Returns:
            Function: Formatter function or None if no appropriate formatter is found
        """
        if isinstance(column_type, String) or isinstance(column_type, Text):
            # For large text fields, truncate for list views
            if isinstance(column_type, Text) or (hasattr(column_type, 'length') and column_type.length > 100):
                return lambda x: markupsafe.escape(str(x)[:97] + '...') if x and len(str(x)) > 100 else markupsafe.escape(str(x) or '')
            return lambda x: markupsafe.escape(str(x) or '')

        elif isinstance(column_type, Boolean):
            return boolean_formatter

        elif isinstance(column_type, DateTime):
            return datetime_formatter

        elif isinstance(column_type, Date):
            return date_formatter

        elif isinstance(column_type, Time):
            return time_formatter

        elif isinstance(column_type, Numeric) or isinstance(column_type, Integer):
            # For money-related column names, use currency formatter
            if any(term in column_type.name.lower() for term in ['price', 'cost', 'amount', 'total', 'fee']):
                return currency_formatter
            return lambda x: f"{x:,}" if x is not None else ""

        elif isinstance(column_type, Enum):
            return enum_formatter

        elif isinstance(column_type, JSON) or isinstance(column_type, JSONB):
            return json_formatter

        elif isinstance(column_type, ARRAY):
            return list_formatter

        elif isinstance(column_type, LargeBinary):
            return file_formatter

        # Default formatter - convert to string and escape
        return lambda x: markupsafe.escape(str(x)) if x is not None else ""

    def _get_formatter(self, field_name: str) -> Optional[Callable]:
        """
        Get field formatter from config with fallback to method.

        Args:
            field_name: Name of the field to get formatter for

        Returns:
            Callable: Formatter function or None if not found
        """
        # First check if there's a formatter in custom_field_types
        field_config = self._get_field_config(field_name)
        field_type = field_config.get('type')

        if field_type in self.custom_field_types:
            return self.custom_field_types[field_type].get('formatter')

        # Then check if there's a formatter specified directly in field_config
        formatter = field_config.get('formatter')
        if formatter:
            if isinstance(formatter, str):
                # If formatter is a string, look for method in view class
                return getattr(self, formatter, None)
            else:
                # Otherwise assume it's a callable
                return formatter

        # Check for a formatter method on the view
        formatter_method = f'format_{field_name}'
        if hasattr(self, formatter_method):
            return getattr(self, formatter_method)

        # Look for a formatter based on common naming patterns
        if field_name.endswith('_date') or field_name.endswith('_at'):
            return datetime_formatter
        elif field_name.endswith('_time'):
            return time_formatter
        elif field_name.endswith('_price') or field_name.endswith('_cost') or field_name.endswith('_amount'):
            return currency_formatter
        elif field_name.endswith('_json'):
            return json_formatter
        elif field_name.endswith('_array') or field_name.endswith('_list'):
            return list_formatter
        elif field_name.endswith('_img') or field_name.endswith('_image') or field_name.endswith('_photo'):
            return image_formatter
        elif field_name.endswith('_file') or field_name.endswith('_document'):
            return file_formatter
        elif field_name.endswith('_phone'):
            return phone_formatter
        elif field_name.endswith('_address'):
            return address_formatter
        elif field_name.endswith('_color'):
            return color_formatter
        elif field_name.endswith('_id') and field_name != 'id':
            return related_formatter

        return None

    def _init_validators(self):
        """
        Initialize field validators for form processing.

        This method sets up validators for all columns based on their types, constraints,
        and custom validator definitions.
        """
        self.validators_columns = {}

        # Get model columns
        try:
            mapper = inspect(self.datamodel.obj)
            columns = {c.key: c for c in mapper.columns}
        except Exception as e:
            log.warning(f"Error inspecting model columns: {str(e)}")
            columns = {}

        # Set up validators for each column in add/edit forms
        for column_name in set(self.add_columns + self.edit_columns):
            validators_list = []

            # Skip columns that don't exist
            if column_name not in columns and not hasattr(self.datamodel.obj, column_name):
                continue

            # Add CSRF validator for specific fields if needed
            if column_name == 'csrf_token':
                validators_list.append(CSRFProtectionValidator())

            # Try to get custom validators from field_type_config
            field_validators = self._get_validators(column_name)
            if field_validators:
                validators_list.extend(field_validators)

            # Auto-detect validators based on column constraints
            if column_name in columns:
                column = columns[column_name]

                # Required validation
                if not column.nullable and not column.default and not column.server_default:
                    validators_list.append(validators.DataRequired())

                # String length validation
                if isinstance(column.type, String) and hasattr(column.type, 'length') and column.type.length:
                    validators_list.append(validators.Length(max=column.type.length))

                # Numeric range validation for integers
                if isinstance(column.type, Integer):
                    # Try to determine range from database constraints
                    min_val = None
                    max_val = None

                    # For unsigned integers
                    if getattr(column.type, 'unsigned', False):
                        min_val = 0

                    # Add validator if we have min or max
                    if min_val is not None or max_val is not None:
                        validators_list.append(validators.NumberRange(min=min_val, max=max_val))

                # Email validation
                if column_name.endswith('_email') or column_name == 'email':
                    validators_list.append(validators.Email())

                # URL validation
                if column_name.endswith('_url') or column_name == 'url' or column_name == 'website':
                    validators_list.append(validators.URL())

            # Add validators to the dictionary if we have any
            if validators_list:
                self.validators_columns[column_name] = validators_list

    def _get_validators(self, field_name: str) -> List[Callable]:
        """
        Get field validators from config with fallback to method.

        Args:
            field_name: Name of the field to get validators for

        Returns:
            List[Callable]: List of validator functions
        """
        validator_list = []

        # First check if there's a validator in custom_field_types
        field_config = self._get_field_config(field_name)
        field_type = field_config.get('type')

        if field_type in self.custom_field_types:
            validator = self.custom_field_types[field_type].get('validator')
            if validator:
                validator_list.append(validator)

        # Then check if there are validators specified directly in field_config
        config_validators = field_config.get('validators', [])
        for validator in config_validators:
            if isinstance(validator, str):
                # If validator is a string, look for it in wtforms.validators
                validator_func = getattr(validators, validator, None)
                if validator_func:
                    validator_list.append(validator_func())
                else:
                    # Or check if it's a method on the view
                    validator_method = getattr(self, validator, None)
                    if validator_method:
                        validator_list.append(validator_method)
            else:
                # Otherwise assume it's a callable
                validator_list.append(validator)

        # Check for a validator method on the view
        validator_method_name = f'validate_{field_name}'
        if hasattr(self, validator_method_name):
            validator_list.append(getattr(self, validator_method_name))

        return validator_list

    def _init_event_handlers(self):
        """
        Initialize event handler registries for the view.

        This method sets up registry dictionaries for various event types that can
        be used to register custom event handlers.
        """
        self.before_request_handlers = []
        self.after_request_handlers = []
        self.before_create_handlers = []
        self.after_create_handlers = []
        self.before_update_handlers = []
        self.after_update_handlers = []
        self.before_delete_handlers = []
        self.after_delete_handlers = []
        self.form_process_handlers = []
        self.search_query_handlers = []
        self.export_data_handlers = []

    def _init_csrf_tokens(self):
        """
        Initialize CSRF token generation for forms.

        This method sets up CSRF protection for the view.
        """
        self.csrf_token = generate_csrf() if self.has_csrf else None

    def _init_api_docs(self):
        """
        Initialize API documentation data.

        This method sets up API documentation information for the API docs endpoint.
        """
        self.api_docstrings = {
            'api_list': 'Get a paginated list of records',
            'api_show': 'Get details of a specific record by ID',
            'api_add': 'Create a new record',
            'api_edit': 'Update an existing record',
            'api_delete': 'Delete a record',
            'api_bulk': 'Perform bulk operations on multiple records',
            'api_schema': 'Get the schema definition for this resource',
            'api_docs': 'Get API documentation'
        }

        # Build API schema
        self.api_schema = self._build_api_schema()

    def _build_api_schema(self) -> Dict[str, Any]:
        """
        Build API schema definition for documentation.

        Returns:
            Dict[str, Any]: Schema definition
        """
        schema = {
            'type': 'object',
            'title': self.model_name,
            'properties': {},
            'required': []
        }

        try:
            mapper = inspect(self.datamodel.obj)

            # Add properties for each column
            for column in mapper.columns:
                if column.name in self.api_config.get('exclude_columns', []):
                    continue

                property_def = self._get_property_definition(column)
                if property_def:
                    schema['properties'][column.name] = property_def

                    # Add to required list if not nullable
                    if not column.nullable and not column.primary_key:
                        schema['required'].append(column.name)

            # Add properties for relationships
            for relationship in mapper.relationships:
                if relationship.key in self.api_config.get('exclude_columns', []):
                    continue

                property_def = self._get_relationship_definition(relationship)
                if property_def:
                    schema['properties'][relationship.key] = property_def

        except Exception as e:
            log.warning(f"Error building API schema: {str(e)}")

        return schema

    def _get_property_definition(self, column) -> Dict[str, Any]:
        """
        Get property definition for a column in API schema.

        Args:
            column: SQLAlchemy column

        Returns:
            Dict[str, Any]: Property definition
        """
        property_def = {
            'title': self.label_columns.get(column.name, column.name),
            'description': self.description_columns.get(column.name, '')
        }

        # Determine type
        if column.primary_key:
            property_def['type'] = 'integer'
            property_def['readOnly'] = True
        elif isinstance(column.type, String) or isinstance(column.type, Text):
            property_def['type'] = 'string'
            if isinstance(column.type, String) and hasattr(column.type, 'length'):
                property_def['maxLength'] = column.type.length
        elif isinstance(column.type, Integer):
            property_def['type'] = 'integer'
        elif isinstance(column.type, Numeric) or isinstance(column.type, Float):
            property_def['type'] = 'number'
        elif isinstance(column.type, Boolean):
            property_def['type'] = 'boolean'
        elif isinstance(column.type, Date):
            property_def['type'] = 'string'
            property_def['format'] = 'date'
        elif isinstance(column.type, DateTime):
            property_def['type'] = 'string'
            property_def['format'] = 'date-time'
        elif isinstance(column.type, Time):
            property_def['type'] = 'string'
            property_def['format'] = 'time'
        elif isinstance(column.type, Enum):
            property_def['type'] = 'string'
            property_def['enum'] = [e for e in column.type.enums]
        elif isinstance(column.type, JSON) or isinstance(column.type, JSONB):
            property_def['type'] = 'object'
        elif isinstance(column.type, ARRAY):
            property_def['type'] = 'array'
        else:
            property_def['type'] = 'string'

        return property_def

    def _get_relationship_definition(self, relationship) -> Dict[str, Any]:
        """
        Get property definition for a relationship in API schema.

        Args:
            relationship: SQLAlchemy relationship

        Returns:
            Dict[str, Any]: Property definition
        """
        property_def = {
            'title': self.label_columns.get(relationship.key, relationship.key),
            'description': self.description_columns.get(relationship.key, '')
        }

        # Determine type based on relationship type
        if relationship.uselist:
            property_def['type'] = 'array'
            property_def['items'] = {
                'type': 'object',
                '$ref': f'#/definitions/{relationship.mapper.class_.__name__}'
            }
        else:
            property_def['type'] = 'object'
            property_def['$ref'] = f'#/definitions/{relationship.mapper.class_.__name__}'

        return property_def

    # Field Type Utilities
    def _get_field_config(self, field_name: str) -> Dict[str, Any]:
        """
        Get field configuration with fallbacks.

        Args:
            field_name: Name of the field to get configuration for

        Returns:
            Dict[str, Any]: Field configuration dictionary
        """
        try:
            field_type_config = getattr(self, 'field_type_config', {}) or {}
            return field_type_config.get(field_name, {})
        except AttributeError:
            return {}

    def _get_primary_key(self) -> str:
        """
        Get the primary key column name of the model.

        Returns:
            str: Primary key column name
        """
        try:
            mapper = inspect(self.datamodel.obj)
            return mapper.primary_key[0].name
        except Exception as e:
            log.warning(f"Error getting primary key: {str(e)}")
            return 'id'  # Default fallback

# Form Processing
    def _process_form_field(self, field_name: str, value: Any) -> Any:
        """
        Process form field value based on field type.

        This method converts form input values to the appropriate Python type
        based on the field's configuration and model column type.

        Args:
            field_name: Name of the field to process
            value: Original value from the form

        Returns:
            Any: Processed value ready for database storage
        """
        if value is None:
            return None

        field_config = self._get_field_config(field_name)
        field_type = field_config.get('type')

        # Process based on field type if specified
        if field_type:
            processor_method = getattr(self, f'_process_{field_type}_field', None)
            if processor_method:
                return processor_method(value)

        # Try to determine field type from column type
        try:
            column = getattr(self.datamodel.obj.__table__.columns, field_name, None)
            if column:
                return self._process_field_by_column_type(value, column.type)
        except Exception as e:
            log.warning(f"Error determining column type for {field_name}: {str(e)}")

        # Default processing based on common field naming patterns
        if field_name.endswith('_json'):
            return self._process_json_field(value)
        elif field_name.endswith('_date'):
            return self._process_date_field(value)
        elif field_name.endswith('_at') or field_name.endswith('_time'):
            return self._process_datetime_field(value)
        elif field_name.endswith('_file') or field_name.endswith('_document'):
            return self._process_file_field(field_name, value)
        elif field_name.endswith('_img') or field_name.endswith('_image') or field_name.endswith('_photo'):
            return self._process_image_field(field_name, value)

        # If no special processing is needed, return value as is
        return value

    def _process_field_by_column_type(self, value: Any, column_type: Any) -> Any:
        """
        Process a value based on the SQLAlchemy column type.

        Args:
            value: Original value from the form
            column_type: SQLAlchemy column type

        Returns:
            Any: Processed value ready for database storage
        """
        if isinstance(column_type, String) or isinstance(column_type, Text):
            return str(value) if value is not None else None

        elif isinstance(column_type, Integer):
            try:
                return int(value) if value is not None and value != '' else None
            except (ValueError, TypeError):
                return None

        elif isinstance(column_type, Numeric) or isinstance(column_type, Float):
            try:
                return float(value) if value is not None and value != '' else None
            except (ValueError, TypeError):
                return None

        elif isinstance(column_type, Boolean):
            if isinstance(value, bool):
                return value
            if isinstance(value, str):
                return value.lower() in ('true', 'yes', '1', 'y', 'on')
            return bool(value)

        elif isinstance(column_type, Date):
            return self._process_date_field(value)

        elif isinstance(column_type, DateTime):
            return self._process_datetime_field(value)

        elif isinstance(column_type, Time):
            return self._process_time_field(value)

        elif isinstance(column_type, Enum):
            return value  # Enum values should already be valid

        elif isinstance(column_type, JSON) or isinstance(column_type, JSONB):
            return self._process_json_field(value)

        elif isinstance(column_type, ARRAY):
            return self._process_array_field(value)

        # For any other type, return as is
        return value

    @handle_errors
    def _process_json_field(self, value: Any) -> Dict[str, Any]:
        """
        Process JSON field value.

        Args:
            value: Value to process, can be string or dict

        Returns:
            Dict[str, Any]: Processed JSON data

        Raises:
            ValidationError: If the value is not valid JSON
        """
        if not value:
            return None

        if isinstance(value, dict) or isinstance(value, list):
            return value

        if isinstance(value, str):
            try:
                return json.loads(value)
            except json.JSONDecodeError as e:
                raise ValidationError(f"Invalid JSON: {str(e)}")

        raise ValidationError(f"Expected JSON object or string, got {type(value).__name__}")

    @handle_errors
    def _process_file_field(self, field_name: str, file_data: Any) -> str:
        """
        Process file upload field.

        Args:
            field_name: Name of the field
            file_data: File data (typically werkzeug.datastructures.FileStorage)

        Returns:
            str: Filename of the saved file

        Raises:
            ValidationError: If file upload configuration is missing or file is invalid
            PermissionDenied: If file operation fails due to permissions
        """
        if not file_data or not isinstance(file_data, FileStorage) or not file_data.filename:
            return None

        if not self.has_file_upload:
            raise ValidationError("File upload not configured")

        return self._handle_file_upload(field_name, file_data)

    @handle_errors
    def _process_image_field(self, field_name: str, file_data: Any) -> str:
        """
        Process image upload field with additional image validation.

        Args:
            field_name: Name of the field
            file_data: File data (typically werkzeug.datastructures.FileStorage)

        Returns:
            str: Filename of the saved image

        Raises:
            ValidationError: If file is not a valid image or image processing fails
        """
        if not file_data or not isinstance(file_data, FileStorage) or not file_data.filename:
            return None

        # First validate and save as a file
        filename = self._process_file_field(field_name, file_data)
        if not filename:
            return None

        # Additional validation for images
        try:
            file_path = os.path.join(self.upload_config['upload_folder'], filename)
            with Image.open(file_path) as img:
                # Get image format and validate
                img_format = img.format
                if img_format not in ['JPEG', 'PNG', 'GIF', 'WebP']:
                    os.remove(file_path)
                    raise ValidationError(f"Invalid image format: {img_format}")

                # Create thumbnail if configured
                if 'thumbnail_size' in self.upload_config:
                    self._create_image_thumbnail(file_path, img)
        except Exception as e:
            # Clean up the file in case of error
            try:
                os.remove(file_path)
            except:
                pass
            raise ValidationError(f"Error processing image: {str(e)}")

        return filename

    @handle_errors
    def _process_date_field(self, value: Any) -> date:
        """
        Process date field value.

        Args:
            value: Date value (string, datetime, or date)

        Returns:
            date: Processed date object

        Raises:
            ValidationError: If the value cannot be converted to a date
        """
        if not value:
            return None

        if isinstance(value, date) and not isinstance(value, datetime):
            return value

        if isinstance(value, datetime):
            return value.date()

        try:
            return parse(str(value)).date()
        except Exception as e:
            raise ValidationError(f"Invalid date format: {str(e)}")

    @handle_errors
    def _process_datetime_field(self, value: Any) -> datetime:
        """
        Process datetime field value.

        Args:
            value: Datetime value (string or datetime)

        Returns:
            datetime: Processed datetime object

        Raises:
            ValidationError: If the value cannot be converted to a datetime
        """
        if not value:
            return None

        if isinstance(value, datetime):
            return value

        try:
            return parse(str(value))
        except Exception as e:
            raise ValidationError(f"Invalid datetime format: {str(e)}")

    @handle_errors
    def _process_time_field(self, value: Any) -> time:
        """
        Process time field value.

        Args:
            value: Time value (string, datetime, or time)

        Returns:
            time: Processed time object

        Raises:
            ValidationError: If the value cannot be converted to a time
        """
        if not value:
            return None

        if isinstance(value, time):
            return value

        if isinstance(value, datetime):
            return value.time()

        try:
            return parse(str(value)).time()
        except Exception as e:
            raise ValidationError(f"Invalid time format: {str(e)}")

    @handle_errors
    def _process_array_field(self, value: Any) -> List[Any]:
        """
        Process array field value.

        Args:
            value: Array value (string, list, or comma-separated values)

        Returns:
            List[Any]: Processed list

        Raises:
            ValidationError: If the value cannot be converted to a list
        """
        if not value:
            return []

        if isinstance(value, list):
            return value

        if isinstance(value, str):
            # Handle comma-separated values
            if ',' in value:
                return [item.strip() for item in value.split(',') if item.strip()]
            # Handle JSON array string
            if value.startswith('[') and value.endswith(']'):
                try:
                    return json.loads(value)
                except json.JSONDecodeError:
                    pass
            # Single value
            return [value]

        # If it's some other type, wrap it in a list
        return [value]

    # File Handling
    @require_feature('file_upload')
    def _handle_file_upload(self, field_name: str, file_data: FileStorage) -> str:
        """
        Handle file upload with proper validation and processing.

        Args:
            field_name: Name of the field
            file_data: File data (werkzeug.datastructures.FileStorage)

        Returns:
            str: Filename of the saved file

        Raises:
            ValidationError: If file validation fails
            PermissionDenied: If file operation fails due to permissions
        """
        if not file_data or not file_data.filename:
            return None

        # Get original filename and determine extension
        original_filename = secure_filename(file_data.filename)
        ext = original_filename.rsplit('.', 1)[1].lower() if '.' in original_filename else ''

        # Validate file type
        field_config = self._get_field_config(field_name)
        upload_type = field_config.get('upload_type', 'document')

        allowed_extensions = self.upload_config['allowed_extensions'].get(
            upload_type, self.upload_config['allowed_extensions']['document']
        )

        if ext not in allowed_extensions:
            raise ValidationError(
                f"Invalid file type '.{ext}'. Allowed types: {', '.join(allowed_extensions)}"
            )

        # Validate file size
        content_length = file_data.content_length or 0
        max_size = field_config.get('max_size', self.upload_config['max_size'])

        if content_length > max_size:
            raise ValidationError(
                f"File too large ({content_length} bytes). Maximum allowed: {max_size} bytes"
            )

        # Generate unique filename
        if not self.upload_config.get('preserve_filename', False):
            filename = f"{datetime.now().strftime('%Y%m%d_%H%M%S')}_{uuid.uuid4().hex[:8]}_{original_filename}"
        else:
            filename = original_filename

        # Save file
        upload_folder = self.upload_config['upload_folder']
        os.makedirs(upload_folder, exist_ok=True)

        file_path = os.path.join(upload_folder, filename)

        try:
            file_data.save(file_path)

            # Scan for virus if enabled
            if self.upload_config.get('scan_virus', False):
                self._scan_file_for_virus(file_path)

            # Log the upload
            log.info(f"File uploaded: {filename} ({content_length} bytes)")

        except PermissionError:
            raise PermissionDenied(f"Cannot write to upload folder: {upload_folder}")
        except Exception as e:
            # Clean up partial file if it exists
            try:
                if os.path.exists(file_path):
                    os.remove(file_path)
            except:
                pass
            raise ValidationError(f"Error saving file: {str(e)}")

        return filename

    def _create_image_thumbnail(self, file_path: str, img: Any = None) -> None:
        """
        Create a thumbnail version of an uploaded image.

        Args:
            file_path: Path to the original image
            img: Optional PIL Image object (to avoid reopening the file)

        Raises:
            ValidationError: If thumbnail creation fails
        """
        try:
            if img is None:
                img = Image.open(file_path)

            thumb_size = self.upload_config['thumbnail_size']

            # Create a copy to avoid modifying the original
            thumb_img = img.copy()
            thumb_img.thumbnail(thumb_size)

            # Generate thumbnail filename
            path_parts = os.path.splitext(file_path)
            thumb_path = f"{path_parts[0]}_thumb{path_parts[1]}"

            # Save thumbnail
            thumb_img.save(thumb_path)

        except Exception as e:
            raise ValidationError(f"Error creating thumbnail: {str(e)}")

