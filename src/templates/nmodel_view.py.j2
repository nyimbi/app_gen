            route_base=self.route_base,
            model_description=self.description_columns.get('model', f"API for {self.model_name}")
        )

    def _get_api_endpoints(self) -> List[Dict[str, Any]]:
        """
        Get list of API endpoints with documentation.

        Returns:
            List[Dict[str, Any]]: List of endpoint definitions
        """
        endpoints = []

        # Helper to build endpoint documentation
        def add_endpoint(name, path, method, description, params=None, request_body=None, responses=None):
            endpoints.append({
                'name': name,
                'path': path,
                'method': method,
                'description': description,
                'parameters': params or [],
                'request_body': request_body,
                'responses': responses or {}
            })

        # List endpoint
        add_endpoint(
            'list',
            f"{self.route_base}/api",
            'GET',
            self.api_docstrings.get('api_list', 'Get a paginated list of records'),
            params=[
                {'name': 'page', 'type': 'integer', 'description': 'Page number (1-indexed)', 'default': 1},
                {'name': 'page_size', 'type': 'integer', 'description': 'Number of items per page', 'default': self.api_config.get('default_page_size', 20)},
                {'name': 'sort_column', 'type': 'string', 'description': 'Column to sort by'},
                {'name': 'sort_direction', 'type': 'string', 'description': 'Sort direction (asc or desc)', 'default': 'asc'},
                {'name': 'filters', 'type': 'string', 'description': 'JSON-encoded filter criteria'},
                {'name': 'search', 'type': 'string', 'description': 'Search query'}
            ],
            responses={
                '200': {'description': 'Successful response with paginated list of records'},
                '400': {'description': 'Bad request (invalid filters or pagination parameters)'},
                '403': {'description': 'Forbidden (no permission to access)'}
            }
        )

        # Show endpoint
        add_endpoint(
            'show',
            f"{self.route_base}/api/<pk>",
            'GET',
            self.api_docstrings.get('api_show', 'Get details of a specific record by ID'),
            params=[
                {'name': 'pk', 'type': 'string', 'description': 'Primary key of the record', 'required': True},
                {'name': 'include_related', 'type': 'boolean', 'description': 'Include related records', 'default': False}
            ],
            responses={
                '200': {'description': 'Successful response with record details'},
                '403': {'description': 'Forbidden (no permission to access)'},
                '404': {'description': 'Record not found'}
            }
        )

        # Create endpoint
        add_endpoint(
            'create',
            f"{self.route_base}/api",
            'POST',
            self.api_docstrings.get('api_add', 'Create a new record'),
            request_body={
                'description': 'Record data',
                'content_type': 'application/json',
                'schema': self.api_schema
            },
            responses={
                '201': {'description': 'Record created successfully'},
                '400': {'description': 'Bad request (invalid data format)'},
                '403': {'description': 'Forbidden (no permission to create)'},
                '422': {'description': 'Validation error'}
            }
        )

        # Update endpoint
        add_endpoint(
            'update',
            f"{self.route_base}/api/<pk>",
            'PUT',
            self.api_docstrings.get('api_edit', 'Update an existing record'),
            params=[
                {'name': 'pk', 'type': 'string', 'description': 'Primary key of the record', 'required': True}
            ],
            request_body={
                'description': 'Updated record data',
                'content_type': 'application/json',
                'schema': self.api_schema
            },
            responses={
                '200': {'description': 'Record updated successfully'},
                '400': {'description': 'Bad request (invalid data format)'},
                '403': {'description': 'Forbidden (no permission to update)'},
                '404': {'description': 'Record not found'},
                '422': {'description': 'Validation error'}
            }
        )

        # Delete endpoint
        add_endpoint(
            'delete',
            f"{self.route_base}/api/<pk>",
            'DELETE',
            self.api_docstrings.get('api_delete', 'Delete a record'),
            params=[
                {'name': 'pk', 'type': 'string', 'description': 'Primary key of the record', 'required': True}
            ],
            responses={
                '200': {'description': 'Record deleted successfully'},
                '403': {'description': 'Forbidden (no permission to delete)'},
                '404': {'description': 'Record not found'},
                '422': {'description': 'Cannot delete due to dependencies'}
            }
        )

        # Bulk endpoint
        if self.api_config.get('bulk_actions'):
            add_endpoint(
                'bulk',
                f"{self.route_base}/api/bulk",
                'POST',
                self.api_docstrings.get('api_bulk', 'Perform bulk operations on multiple records'),
                request_body={
                    'description': 'Bulk operation data',
                    'content_type': 'application/json',
                    'schema': {
                        'type': 'object',
                        'properties': {
                            'operation': {
                                'type': 'string',
                                'enum': self.api_config.get('bulk_actions'),
                                'description': 'Operation to perform'
                            },
                            'items': {
                                'type': 'array',
                                'items': self.api_schema,
                                'description': 'List of items to process'
                            }
                        },
                        'required': ['operation', 'items']
                    }
                },
                responses={
                    '200': {'description': 'Bulk operation completed successfully'},
                    '400': {'description': 'Bad request (invalid operation or data format)'},
                    '403': {'description': 'Forbidden (no permission to perform operation)'}
                }
            )

        # Schema endpoint
        add_endpoint(
            'schema',
            f"{self.route_base}/api/schema",
            'GET',
            self.api_docstrings.get('api_schema', 'Get the schema definition for this resource'),
            responses={
                '200': {'description': 'Successful response with schema definition'}
            }
        )

        return endpoints

    def _serialize_item(self, item: Any, with_related: bool = False) -> Dict[str, Any]:
        """
        Serialize an item for API response.

        Args:
            item: Item to serialize
            with_related: Whether to include related records

        Returns:
            Dict[str, Any]: Serialized item
        """
        data = {}

        # Add primary fields
        for column_name in self.show_columns:
            value = getattr(item, column_name, None)
            formatter = self.formatters_columns.get(column_name)

            if formatter and value is not None:
                try:
                    # Apply formatter but keep raw value for certain types
                    if isinstance(value, (dict, list)):
                        data[column_name] = value
                    else:
                        formatted = formatter(value)
                        # If formatter returns Markup, convert to string
                        if hasattr(formatted, '__html__'):
                            formatted = str(formatted)
                        data[column_name] = formatted
                except Exception as e:
                    # If formatting fails, use raw value
                    log.warning(f"Error formatting {column_name}: {str(e)}")
                    data[column_name] = value
            else:
                data[column_name] = value

        # Add related records if requested
        if with_related:
            # Add one-to-many relationships
            for relationship in inspect(self.datamodel.obj).relationships:
                if relationship.direction.name == 'ONETOMANY':
                    related_data = getattr(item, relationship.key, None)
                    if related_data:
                        if hasattr(related_data, '__iter__'):
                            data[relationship.key] = [
                                {col: getattr(rel_item, col) for col in getattr(rel_item, '__table__').columns.keys()}
                                for rel_item in related_data
                            ]
                        else:
                            data[relationship.key] = {
                                col: getattr(related_data, col)
                                for col in getattr(related_data, '__table__').columns.keys()
                            }

        return data

    # Import/Export Functionality
    @expose('/export/<export_type>')
    @has_access
    @handle_errors
    def export(self, export_type: str) -> Response:
        """
        Export data to file.

        Args:
            export_type: Type of export (csv, xlsx, json, yaml)

        Returns:
            Response: File download response
        """
        if not self.has_export:
            flash(_("Export is not enabled for this view"), "warning")
            return redirect(self.get_redirect())

        if export_type not in self.export_types:
            flash(_(f"Export type {export_type} is not supported"), "warning")
            return redirect(self.get_redirect())

        # Get query with applied filters
        query = self._get_base_query()
        query = self._apply_filters(query)
        query = self._apply_search(query)
        query = self._apply_ordering(query)

        # Apply row limit
        if self.export_max_rows:
            query = query.limit(self.export_max_rows)

        # Execute query
        items = query.all()

        # Check if we have any items
        if not items:
            flash(_("No records found to export"), "warning")
            return redirect(self.get_redirect())

        # Export based on type
        if export_type == 'csv':
            return self._export_csv(items)
        elif export_type == 'xlsx':
            return self._export_xlsx(items)
        elif export_type == 'json':
            return self._export_json(items)
        elif export_type == 'yaml':
            return self._export_yaml(items)
        else:
            flash(_(f"Export type {export_type} is not implemented"), "warning")
            return redirect(self.get_redirect())

    def _export_csv(self, items: List[Any]) -> Response:
        """
        Export data to CSV file.

        Args:
            items: List of items to export

        Returns:
            Response: CSV file download response
        """
        output = io.StringIO()
        writer = csv.writer(output)

        # Get columns to export
        columns = self.list_columns

        # Write header row
        header = [self.label_columns.get(col, col) for col in columns]
        writer.writerow(header)

        # Write data rows
        for item in items:
            row = []
            for col in columns:
                value = getattr(item, col, None)
                formatter = self.formatters_columns.get(col)

                if formatter and value is not None:
                    try:
                        # Apply formatter
                        formatted = formatter(value)
                        # If formatter returns Markup, convert to string
                        if hasattr(formatted, '__html__'):
                            formatted = str(formatted)
                        row.append(formatted)
                    except Exception as e:
                        # If formatting fails, use raw value or empty string
                        log.warning(f"Error formatting {col}: {str(e)}")
                        row.append(str(value) if value is not None else '')
                else:
                    row.append(str(value) if value is not None else '')

            writer.writerow(row)

        # Create response
        response = make_response(output.getvalue())
        response.headers['Content-Type'] = 'text/csv'
        response.headers['Content-Disposition'] = f'attachment; filename={self.model_name}_{datetime.now().strftime("%Y%m%d_%H%M%S")}.csv'

        return response

    def _export_xlsx(self, items: List[Any]) -> Response:
        """
        Export data to Excel file.

        Args:
            items: List of items to export

        Returns:
            Response: Excel file download response
        """
        # Convert data to pandas DataFrame
        data = {}
        columns = self.list_columns

        # Prepare column data
        for col in columns:
            values = []
            for item in items:
                value = getattr(item, col, None)
                formatter = self.formatters_columns.get(col)

                if formatter and value is not None:
                    try:
                        # Apply formatter
                        formatted = formatter(value)
                        # If formatter returns Markup, convert to string
                        if hasattr(formatted, '__html__'):
                            formatted = str(formatted)
                        values.append(formatted)
                    except Exception as e:
                        # If formatting fails, use raw value or empty string
                        log.warning(f"Error formatting {col}: {str(e)}")
                        values.append(str(value) if value is not None else '')
                else:
                    values.append(str(value) if value is not None else '')

            data[self.label_columns.get(col, col)] = values

        # Create DataFrame
        df = pd.DataFrame(data)

        # Save to Excel
        output = io.BytesIO()
        with pd.ExcelWriter(output, engine='openpyxl') as writer:
            df.to_excel(writer, index=False, sheet_name=self.model_name[:31])  # Excel sheet names have a 31 character limit

            # Auto-adjust column widths
            worksheet = writer.sheets[self.model_name[:31]]
            for idx, col in enumerate(df.columns):
                max_width = max(df[col].astype(str).map(len).max(), len(col)) + 2
                worksheet.column_dimensions[openpyxl.utils.get_column_letter(idx + 1)].width = min(max_width, 50)  # Limit width to 50 characters

        # Create response
        output.seek(0)
        response = make_response(output.getvalue())
        response.headers['Content-Type'] = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        response.headers['Content-Disposition'] = f'attachment; filename={self.model_name}_{datetime.now().strftime("%Y%m%d_%H%M%S")}.xlsx'

        return response

    def _export_json(self, items: List[Any]) -> Response:
        """
        Export data to JSON file.

        Args:
            items: List of items to export

        Returns:
            Response: JSON file download response
        """
        data = [self._serialize_item(item) for item in items]

        # Create response
        response = make_response(json.dumps(data, indent=2, default=str))
        response.headers['Content-Type'] = 'application/json'
        response.headers['Content-Disposition'] = f'attachment; filename={self.model_name}_{datetime.now().strftime("%Y%m%d_%H%M%S")}.json'

        return response

    def _export_yaml(self, items: List[Any]) -> Response:
        """
        Export data to YAML file.

        Args:
            items: List of items to export

        Returns:
            Response: YAML file download response
        """
        data = [self._serialize_item(item) for item in items]

        # Create response with proper date/time handling
        import yaml

        class CustomYAMLDumper(yaml.SafeDumper):
            """Custom YAML dumper that handles dates and times."""
            pass

        def datetime_representer(dumper, data):
            return dumper.represent_scalar('tag:yaml.org,2002:timestamp', data.isoformat())

        def date_representer(dumper, data):
            return dumper.represent_scalar('tag:yaml.org,2002:timestamp', data.isoformat())

        CustomYAMLDumper.add_representer(datetime, datetime_representer)
        CustomYAMLDumper.add_representer(date, date_representer)

        response = make_response(yaml.dump(data, Dumper=CustomYAMLDumper, default_flow_style=False))
        response.headers['Content-Type'] = 'application/x-yaml'
        response.headers['Content-Disposition'] = f'attachment; filename={self.model_name}_{datetime.now().strftime("%Y%m%d_%H%M%S")}.yaml'

        return response

    @expose('/import', methods=['GET', 'POST'])
    @has_access
    @handle_errors
    @csrf_protect
    def import_data(self) -> Response:
        """
        Import data from file.

        Returns:
            Response: Redirect or rendered template
        """
        if not getattr(self, 'can_import', False):
            flash(_("Import is not enabled for this view"), "warning")
            return redirect(self.get_redirect())

        if request.method == 'POST':
            file = request.files.get('file')
            if not file:
                flash(_("No file uploaded"), "warning")
                return redirect(url_for(f'.{self.import_data.__name__}'))

            try:
                # Check file extension
                filename = secure_filename(file.filename or '')
                extension = filename.rsplit('.', 1)[1].lower() if '.' in filename else ''

                if extension not in ['csv', 'xlsx', 'json', 'yaml', 'yml']:
                    flash(_("Unsupported file type. Please upload CSV, Excel, JSON, or YAML."), "warning")
                    return redirect(url_for(f'.{self.import_data.__name__}'))

                # Process the file
                results = self._process_import_file(file, extension)

                return self.render_template(
                    'import_review.html',
                    title=_("Import Review"),
                    results=results,
                    model_name=self.model_name,
                    list_columns=self.list_columns,
                    label_columns=self.label_columns
                )

            except Exception as e:
                log.exception("Error processing import file")
                flash(_(f"Error processing import file: {str(e)}"), "error")
                return redirect(url_for(f'.{self.import_data.__name__}'))

        return self.render_template(
            'import.html',
            title=_("Import Data"),
            model_name=self.model_name
        )

    def _process_import_file(self, file: FileStorage, extension: str) -> List[Dict[str, Any]]:
        """
        Process import file.

        Args:
            file: Uploaded file
            extension: File extension

        Returns:
            List[Dict[str, Any]]: List of import results
        """
        if extension == 'csv':
            return self._process_csv_import(file)
        elif extension == 'xlsx':
            return self._process_xlsx_import(file)
        elif extension == 'json':
            return self._process_json_import(file)
        elif extension in ['yaml', 'yml']:
            return self._process_yaml_import(file)
        else:
            raise ValueError(f"Unsupported file extension: {extension}")

    def _process_csv_import(self, file: FileStorage) -> List[Dict[str, Any]]:
        """
        Process CSV import file.

        Args:
            file: Uploaded CSV file

        Returns:
            List[Dict[str, Any]]: List of import results
        """
        results = []

        try:
            # Read CSV content
            content = file.read().decode('utf-8')
            reader = csv.DictReader(content.splitlines())

            # Process each row
            for row in reader:
                result = self._process_import_row(row)
                results.append(result)

        except Exception as e:
            log.exception("Error processing CSV import")
            raise ValueError(f"Error processing CSV: {str(e)}")

        return results

    def _process_xlsx_import(self, file: FileStorage) -> List[Dict[str, Any]]:
        """
        Process Excel import file.

        Args:
            file: Uploaded Excel file

        Returns:
            List[Dict[str, Any]]: List of import results
        """
        results = []

        try:
            # Read Excel content
            content = file.read()
            file_obj = io.BytesIO(content)
            df = pd.read_excel(file_obj)

            # Convert DataFrame to dict
            rows = df.to_dict('records')

            # Process each row
            for row in rows:
                # Handle NaN values
                clean_row = {k: None if pd.isna(v) else v for k, v in row.items()}
                result = self._process_import_row(clean_row)
                results.append(result)

        except Exception as e:
            log.exception("Error processing Excel import")
            raise ValueError(f"Error processing Excel: {str(e)}")

        return results

    def _process_json_import(self, file: FileStorage) -> List[Dict[str, Any]]:
        """
        Process JSON import file.

        Args:
            file: Uploaded JSON file

        Returns:
            List[Dict[str, Any]]: List of import results
        """
        results = []

        try:
            # Read JSON content
            content = file.read().decode('utf-8')
            data = json.loads(content)

            # Ensure we have a list of records
            if not isinstance(data, list):
                data = [data]

            # Process each record
            for row in data:
                if not isinstance(row, dict):
                    results.append({
                        'status': 'error',
                        'row': row,
                        'errors': ['Record must be a JSON object']
                    })
                    continue

                result = self._process_import_row(row)
                results.append(result)

        except Exception as e:
            log.exception("Error processing JSON import")
            raise ValueError(f"Error processing JSON: {str(e)}")

        return results

    def _process_yaml_import(self, file: FileStorage) -> List[Dict[str, Any]]:
        """
        Process YAML import file.

        Args:
            file: Uploaded YAML file

        Returns:
            List[Dict[str, Any]]: List of import results
        """
        results = []

        try:
            # Read YAML content
            import yaml
            content = file.read().decode('utf-8')
            data = yaml.safe_load(content)

            # Ensure we have a list of records
            if not isinstance(data, list):
                data = [data]

            # Process each record
            for row in data:
                if not isinstance(row, dict):
                    results.append({
                        'status': 'error',
                        'row': row,
                        'errors': ['Record must be a YAML object']
                    })
                    continue

                result = self._process_import_row(row)
                results.append(result)

        except Exception as e:
            log.exception("Error processing YAML import")
            raise ValueError(f"Error processing YAML: {str(e)}")

        return results

    def _process_import_row(self, row: Dict[str, Any]) -> Dict[str, Any]:
        """
        Process a single import row.

        Args:
            row: Dictionary of field values

        Returns:
            Dict[str, Any]: Import result with status
        """
        try:
            # Clean field names (convert to lowercase, remove whitespace)
            clean_row = {}
            for key, value in row.items():
                # Skip empty keys
                if not key or not key.strip():
                    continue

                # Clean key
                clean_key = key.strip().lower()

                # Check if this is a valid column
                if clean_key not in [col.lower() for col in self.add_columns]:
                    # Try to match label to column
                    label_map = {label.strip().lower(): col for col, label in self.label_columns.items()}
                    if key.strip().lower() in label_map:
                        clean_key = label_map[key.strip().lower()]
                    else:
                        continue  # Skip unknown column

                clean_row[clean_key] = value

            # Validate the row data
            errors = {}
            for field_name in self.add_columns:
                field_value = clean_row.get(field_name)

                # Process the field value
                try:
                    if field_value is not None:
                        clean_row[field_name] = self._process_import_field(field_name, field_value)
                except Exception as e:
                    errors[field_name] = [str(e)]

            # Check for validation errors
            if errors:
                return {
                    'status': 'error',
                    'row': row,
                    'processed': clean_row,
                    'errors': errors
                }

            return {
                'status': 'success',
                'row': row,
                'processed': clean_row
            }

        except Exception as e:
            return {
                'status': 'error',
                'row': row,
                'errors': {'__all__': [str(e)]}
            }

def _process_import_field(self, field_name: str, value: Any) -> Any:
        """
        Process import field value.

        Args:
            field_name: Field name
            value: Field value

        Returns:
            Any: Processed value
        """
        if value is None:
            return None

        # Get field type
        field_type = None
        try:
            column = getattr(self.datamodel.obj.__table__.columns, field_name, None)
            if column:
                field_type = type(column.type)
        except Exception:
            pass

        # Process based on field type
        if field_type:
            if issubclass(field_type, Integer):
                return int(value) if value != '' else None
            elif issubclass(field_type, Numeric) or issubclass(field_type, Float):
                return float(value) if value != '' else None
            elif issubclass(field_type, Boolean):
                if isinstance(value, bool):
                    return value
                if isinstance(value, str):
                    return value.lower() in ('true', 'yes', '1', 'y', 'on')
                return bool(value)
            elif issubclass(field_type, Date):
                if isinstance(value, date):
                    return value
                if isinstance(value, datetime):
                    return value.date()
                if isinstance(value, str):
                    return parse(value).date()
                return None
            elif issubclass(field_type, DateTime):
                if isinstance(value, datetime):
                    return value
                if isinstance(value, str):
                    return parse(value)
                return None
            elif issubclass(field_type, (JSON, JSONB)):
                if isinstance(value, (dict, list)):
                    return value
                if isinstance(value, str):
                    return json.loads(value)
                return None

        # Process based on field name pattern
        if field_name.endswith(('_date', '_on')):
            return self._process_date_field(value)
        elif field_name.endswith(('_at', '_time')):
            return self._process_datetime_field(value)
        elif field_name.endswith('_json'):
            return self._process_json_field(value)

        # Default processing (convert to string)
        return str(value) if value is not None else None

    @expose('/import/commit', methods=['POST'])
    @has_access
    @handle_errors
    @csrf_protect
    def import_commit(self) -> Response:
        """
        Commit imported data to database.

        Returns:
            Response: Redirect with status message
        """
        if not getattr(self, 'can_import', False):
            flash(_("Import is not enabled for this view"), "warning")
            return redirect(self.get_redirect())

        try:
            import_data = request.form.get('import_data', '[]')
            data = json.loads(import_data)

            if not isinstance(data, list):
                flash(_("Invalid import data format"), "error")
                return redirect(self.get_redirect())

            # Filter out rows with errors
            valid_rows = [row for row in data if row.get('status') == 'success']

            if not valid_rows:
                flash(_("No valid records to import"), "warning")
                return redirect(self.get_redirect())

            # Import each valid row
            successful = 0
            failed = 0
            errors = []

            for row in valid_rows:
                try:
                    # Create new instance
                    item = self.datamodel.obj()

                    # Set attributes
                    for key, value in row.get('processed', {}).items():
                        if key in self.add_columns:
                            setattr(item, key, value)

                    # Process the item
                    self.pre_add(item)

                    # Save to database
                    self.datamodel.add(item)

                    # Post-process
                    self.post_add(item)

                    successful += 1

                except Exception as e:
                    failed += 1
                    errors.append(str(e))
                    log.exception(f"Error importing row: {row}")

            # Commit transaction
            self.datamodel.session.commit()

            if successful > 0:
                if failed > 0:
                    flash(_(f"Imported {successful} records successfully. {failed} records failed."), "warning")
                else:
                    flash(_(f"Imported {successful} records successfully."), "success")
            else:
                flash(_("Import failed. No records were imported."), "error")
                if errors:
                    flash(_(f"Errors: {'; '.join(errors[:5])}{'...' if len(errors) > 5 else ''}"), "error")

        except Exception as e:
            log.exception("Error committing import")
            flash(_(f"Error committing import: {str(e)}"), "error")

        return redirect(self.get_redirect())

    # Advanced Search
    @expose('/search', methods=['GET', 'POST'])
    @has_access
    def search(self) -> Response:
        """
        Advanced search view.

        Returns:
            Response: Rendered template with search results
        """
        if not self.has_search:
            flash(_("Search is not enabled for this view"), "warning")
            return redirect(self.get_redirect())

        search_query = request.args.get('q', '')

        if search_query:
            # Get base query
            query = self._get_base_query()

            # Apply search
            query = self._apply_search(query, search_query)

            # Apply ordering
            query = self._apply_ordering(query)

            # Apply pagination
            page = request.args.get('page', 1, type=int)
            per_page = self.page_size

            # Get total count
            total_count = query.count()

            # Paginate results
            items = query.offset((page - 1) * per_page).limit(per_page).all()

            # Check if we have any items
            if not items and page > 1:
                # If we're on a page with no results, go back to page 1
                return redirect(url_for(
                    f'.{self.search.__name__}',
                    q=search_query,
                    page=1
                ))

            # Create pagination object
            pagination = {
                'page': page,
                'per_page': per_page,
                'total': total_count,
                'pages': (total_count + per_page - 1) // per_page,
                'has_next': page < ((total_count + per_page - 1) // per_page),
                'has_prev': page > 1
            }

            return self.render_template(
                'search_results.html',
                title=_(f"Search Results for '{search_query}'"),
                search_query=search_query,
                items=items,
                pagination=pagination,
                list_columns=self.list_columns,
                label_columns=self.label_columns,
                formatters_columns=self.formatters_columns,
                search_filters=self._get_search_filters()
            )

        return self.render_template(
            'search.html',
            title=_("Advanced Search"),
            search_columns=self.search_columns,
            label_columns=self.label_columns,
            search_filters=self._get_search_filters()
        )

    def _apply_search(self, query: Any, search_query: str = None) -> Any:
        """
        Apply search filters to query.

        Args:
            query: Base SQLAlchemy query
            search_query: Search query string

        Returns:
            Any: Filtered query
        """
        search_query = search_query or request.args.get('q', '')
        if not search_query:
            return query

        # Optimization: Use PostgreSQL full-text search if available
        if self.search_use_fulltext and self.datamodel.session.bind.dialect.name == 'postgresql':
            return self._apply_fulltext_search(query, search_query)

        # Standard search across columns
        search_filters = []
        for column_name in self.search_columns:
            if column_name in self.search_exclude_columns:
                continue

            if hasattr(self.datamodel.obj, column_name):
                column = getattr(self.datamodel.obj, column_name)
                column_type = getattr(column, 'type', None)

                # Skip binary columns
                if isinstance(column_type, LargeBinary):
                    continue

                # Apply appropriate filter based on column type
                if isinstance(column_type, (String, Text)):
                    if self.search_case_sensitive:
                        search_filters.append(column.like(f"%{search_query}%"))
                    else:
                        search_filters.append(func.lower(column).like(f"%{search_query.lower()}%"))
                elif isinstance(column_type, (Integer, Numeric, Float)):
                    try:
                        numeric_value = float(search_query)
                        search_filters.append(column == numeric_value)
                    except ValueError:
                        pass  # Not a valid number, skip this filter
                elif isinstance(column_type, Enum) and hasattr(column_type, 'enums'):
                    for enum_value in column_type.enums:
                        if search_query.lower() in enum_value.lower():
                            search_filters.append(column == enum_value)
                elif isinstance(column_type, Boolean):
                    if search_query.lower() in ('true', 'yes', '1'):
                        search_filters.append(column == True)
                    elif search_query.lower() in ('false', 'no', '0'):
                        search_filters.append(column == False)

        # No valid filters
        if not search_filters:
            return query.filter(False)  # Empty result set

        # Combine filters with OR
        return query.filter(or_(*search_filters))

    def _apply_fulltext_search(self, query: Any, search_query: str) -> Any:
        """
        Apply full-text search using PostgreSQL to_tsquery.

        Args:
            query: Base SQLAlchemy query
            search_query: Search query string

        Returns:
            Any: Filtered query with full-text search
        """
        # Break query into terms
        terms = search_query.split()

        # Build to_tsquery expression with prefix matching
        ts_query = ' & '.join([f"{term}:*" for term in terms])

        # Get searchable text columns
        text_columns = []
        for column_name in self.search_columns:
            if column_name in self.search_exclude_columns:
                continue

            if hasattr(self.datamodel.obj, column_name):
                column = getattr(self.datamodel.obj, column_name)
                column_type = getattr(column, 'type', None)

                if isinstance(column_type, (String, Text)):
                    text_columns.append(column)

        if not text_columns:
            return query.filter(False)  # Empty result set

        # Build to_tsvector expression from all text columns
        ts_vectors = []
        for column in text_columns:
            ts_vectors.append(func.to_tsvector('english', column))

        # Combine all ts_vectors
        combined_ts_vector = ts_vectors[0]
        for ts_vector in ts_vectors[1:]:
            combined_ts_vector = combined_ts_vector.op('||')(ts_vector)

        # Add full-text search filter
        return query.filter(combined_ts_vector.op('@@')(func.to_tsquery('english', ts_query)))

    def _apply_ordering(self, query: Any) -> Any:
        """
        Apply sorting to query.

        Args:
            query: Base SQLAlchemy query

        Returns:
            Any: Sorted query
        """
        # Get sort parameters
        sort_column = request.args.get('sort_column', self.base_order[0] if self.base_order else None)
        sort_direction = request.args.get('sort_direction', self.base_order[1] if self.base_order else 'asc')

        if sort_column and hasattr(self.datamodel.obj, sort_column):
            column = getattr(self.datamodel.obj, sort_column)

            if sort_direction.lower() == 'desc':
                query = query.order_by(desc(column))
            else:
                query = query.order_by(asc(column))
        elif self.base_order:
            column = getattr(self.datamodel.obj, self.base_order[0], None)
            if column:
                if self.base_order[1].lower() == 'desc':
                    query = query.order_by(desc(column))
                else:
                    query = query.order_by(asc(column))

        return query

    def _apply_filters(self, query: Any) -> Any:
        """
        Apply filters from request parameters.

        Args:
            query: Base SQLAlchemy query

        Returns:
            Any: Filtered query
        """
        for filter_name, filter_value in request.args.items():
            # Skip pagination and sorting parameters
            if filter_name in ['page', 'sort_column', 'sort_direction', 'q']:
                continue

            # Skip empty filters
            if not filter_value:
                continue

            # Apply filter if column exists
            if hasattr(self.datamodel.obj, filter_name):
                column = getattr(self.datamodel.obj, filter_name)

                # Handle different filter types
                if filter_value.startswith('gt:'):
                    # Greater than
                    filter_value = filter_value[3:]
                    query = query.filter(column > filter_value)
                elif filter_value.startswith('lt:'):
                    # Less than
                    filter_value = filter_value[3:]
                    query = query.filter(column < filter_value)
                elif filter_value.startswith('ge:'):
                    # Greater than or equal
                    filter_value = filter_value[3:]
                    query = query.filter(column >= filter_value)
                elif filter_value.startswith('le:'):
                    # Less than or equal
                    filter_value = filter_value[3:]
                    query = query.filter(column <= filter_value)
                elif filter_value.startswith('ne:'):
                    # Not equal
                    filter_value = filter_value[3:]
                    query = query.filter(column != filter_value)
                elif filter_value.startswith('like:'):
                    # LIKE
                    filter_value = filter_value[5:]
                    query = query.filter(column.like(f'%{filter_value}%'))
                elif filter_value.startswith('in:'):
                    # IN
                    filter_value = filter_value[3:]
                    values = [v.strip() for v in filter_value.split(',')]
                    query = query.filter(column.in_(values))
                elif filter_value == 'null':
                    # IS NULL
                    query = query.filter(column.is_(None))
                elif filter_value == 'not_null':
                    # IS NOT NULL
                    query = query.filter(column.is_not(None))
                else:
                    # Default equality
                    query = query.filter(column == filter_value)

        return query

    def _get_search_filters(self) -> List[Dict[str, Any]]:
        """
        Get available search filters for the view.

        Returns:
            List[Dict[str, Any]]: List of filter definitions
        """
        filters = []

        for column_name in self.search_columns:
            if column_name in self.search_exclude_columns:
                continue

            if hasattr(self.datamodel.obj, column_name):
                column = getattr(self.datamodel.obj, column_name)
                column_type = getattr(column, 'type', None)

                # Skip binary columns
                if isinstance(column_type, LargeBinary):
                    continue

                filter_def = {
                    'name': column_name,
                    'label': self.label_columns.get(column_name, column_name),
                    'type': self._get_filter_type(column_type),
                    'operators': self._get_filter_operators(column_type)
                }

                filters.append(filter_def)

        return filters

    def _get_filter_type(self, column_type: Any) -> str:
        """
        Get filter type for a column type.

        Args:
            column_type: SQLAlchemy column type

        Returns:
            str: Filter type
        """
        if isinstance(column_type, (String, Text)):
            return 'text'
        elif isinstance(column_type, Integer):
            return 'integer'
        elif isinstance(column_type, (Numeric, Float)):
            return 'number'
        elif isinstance(column_type, Boolean):
            return 'boolean'
        elif isinstance(column_type, Date):
            return 'date'
        elif isinstance(column_type, DateTime):
            return 'datetime'
        elif isinstance(column_type, Enum):
            return 'enum'
        else:
            return 'text'

    def _get_filter_operators(self, column_type: Any) -> List[Dict[str, str]]:
        """
        Get available filter operators for a column type.

        Args:
            column_type: SQLAlchemy column type

        Returns:
            List[Dict[str, str]]: List of operator definitions
        """
        operators = []

        if isinstance(column_type, (String, Text)):
            operators.extend([
                {'name': 'eq', 'label': _('equals')},
                {'name': 'ne', 'label': _('not equal')},
                {'name': 'like', 'label': _('contains')},
                {'name': 'in', 'label': _('in')},
                {'name': 'null', 'label': _('is null')},
                {'name': 'not_null', 'label': _('is not null')}
            ])
        elif isinstance(column_type, (Integer, Numeric, Float)):
            operators.extend([
                {'name': 'eq', 'label': _('equals')},
                {'name': 'ne', 'label': _('not equal')},
                {'name': 'gt', 'label': _('greater than')},
                {'name': 'lt', 'label': _('less than')},
                {'name': 'ge', 'label': _('greater or equal')},
                {'name': 'le', 'label': _('less or equal')},
                {'name': 'in', 'label': _('in')},
                {'name': 'null', 'label': _('is null')},
                {'name': 'not_null', 'label': _('is not null')}
            ])
        elif isinstance(column_type, Boolean):
            operators.extend([
                {'name': 'eq', 'label': _('equals')},
                {'name': 'null', 'label': _('is null')},
                {'name': 'not_null', 'label': _('is not null')}
            ])
        elif isinstance(column_type, (Date, DateTime)):
            operators.extend([
                {'name': 'eq', 'label': _('equals')},
                {'name': 'ne', 'label': _('not equal')},
                {'name': 'gt', 'label': _('after')},
                {'name': 'lt', 'label': _('before')},
                {'name': 'ge', 'label': _('on or after')},
                {'name': 'le', 'label': _('on or before')},
                {'name': 'null', 'label': _('is null')},
                {'name': 'not_null', 'label': _('is not null')}
            ])
        elif isinstance(column_type, Enum):
            operators.extend([
                {'name': 'eq', 'label': _('equals')},
                {'name': 'ne', 'label': _('not equal')},
                {'name': 'in', 'label': _('in')},
                {'name': 'null', 'label': _('is null')},
                {'name': 'not_null', 'label': _('is not null')}
            ])
        else:
            operators.extend([
                {'name': 'eq', 'label': _('equals')},
                {'name': 'ne', 'label': _('not equal')},
                {'name': 'null', 'label': _('is null')},
                {'name': 'not_null', 'label': _('is not null')}
            ])

        return operators

    # Version Management
    @expose('/versions/<pk>')
    @has_access
    @handle_errors
    def versions(self, pk: Any) -> Response:
        """
        Show version history for an item.

        Args:
            pk: Primary key of the item

        Returns:
            Response: Rendered template with version history
        """
        if not self.has_versioning:
            flash(_("Versioning is not enabled for this view"), "warning")
            return redirect(self.get_redirect())

        item = self.datamodel.get(pk)
        if not item:
            flash(_("Record not found"), "warning")
            return redirect(self.get_redirect())

        # Get version class
        version_class = self._get_version_class()

        # Get versions
        versions = self.datamodel.session.query(version_class).filter_by(
            item_type=self.datamodel.obj.__name__,
            item_id=pk
        ).order_by(version_class.version.desc()).all()

        return self.render_template(
            'version_history.html',
            title=_(f"Version History for {item}"),
            item=item,
            versions=versions,
            pk=pk,
            diff_format=self.versioning_config.get('diff_format', 'detailed')
        )

    @expose('/versions/<pk>/diff/<int:version1>/<int:version2>')
    @has_access
    @handle_errors
    def version_diff(self, pk: Any, version1: int, version2: int) -> Response:
        """
        Show difference between two versions.

        Args:
            pk: Primary key of the item
            version1: First version number
            version2: Second version number

        Returns:
            Response: Rendered template with version difference
        """
        if not self.has_versioning:
            flash(_("Versioning is not enabled for this view"), "warning")
            return redirect(self.get_redirect())

        item = self.datamodel.get(pk)
        if not item:
            flash(_("Record not found"), "warning")
            return redirect(self.get_redirect())

        # Get version class
        version_class = self._get_version_class()

        # Get versions
        v1 = self.datamodel.session.query(version_class).filter_by(
            item_type=self.datamodel.obj.__name__,
            item_id=pk,
            version=version1
        ).first()

        v2 = self.datamodel.session.query(version_class).filter_by(
            item_type=self.datamodel.obj.__name__,
            item_id=pk,
            version=version2
        ).first()

        if not v1 or not v2:
            flash(_("Version not found"), "warning")
            return redirect(url_for(f'.versions', pk=pk))

        # Generate diff
        diff = self._generate_version_diff(v1, v2)

        return self.render_template(
            'version_diff.html',
            title=_(f"Version Comparison for {item}"),
            item=item,
            version1=v1,
            version2=v2,
            diff=diff,
            pk=pk,
            diff_format=self.versioning_config.get('diff_format', 'detailed')
        )

    def _generate_version_diff(self, v1: Any, v2: Any) -> Dict[str, Any]:
        """
        Generate difference between two versions.

        Args:
            v1: First version
            v2: Second version

        Returns:
            Dict[str, Any]: Version difference
        """
        diff = {}

        # Get data
        data1 = v1.data
        data2 = v2.data

        # Compare all fields
        all_fields = set(data1.keys()) | set(data2.keys())

        for field in all_fields:
            if field in data1 and field in data2:
                if data1[field] != data2[field]:
                    diff[field] = {
                        'old': data1[field],
                        'new': data2[field],
                        'changed': True
                    }
            elif field in data1:
                diff[field] = {
                    'old': data1[field],
                    'new': None,
                    'deleted': True
                }
            else:
                diff[field] = {
                    'old': None,
                    'new': data2[field],
                    'added': True
                }

        return diff

    @expose('/versions/<pk>/restore/<int:version>')
    @has_access
    @handle_errors
    def restore_version(self, pk: Any, version: int) -> Response:
        """
        Restore an item to a previous version.

        Args:
            pk: Primary key of the item
            version: Version number to restore

        Returns:
            Response: Redirect with status message
        """
        if not self.has_versioning or not self.versioning_config.get('restore_enabled', False):
            flash(_("Version restoration is not enabled"), "warning")
            return redirect(self.get_redirect())

        # Check restoration permissions
        required_roles = self.versioning_config.get('restore_permissions', [])
        if required_roles and not any(self._user_has_role(role) for role in required_roles):
            flash(_("You don't have permission to restore versions"), "warning")
            return redirect(self.get_redirect())

        item = self.datamodel.get(pk)
        if not item:
            flash(_("Record not found"), "warning")
            return redirect(self.get_redirect())

        # Get version class
        version_class = self._get_version_class()

        # Get version
        version_obj = self.datamodel.session.query(version_class).filter_by(
            item_type=self.datamodel.obj.__name__,
            item_id=pk,
            version=version
        ).first()

        if not version_obj:
            flash(_("Version not found"), "warning")
            return redirect(url_for(f'.versions', pk=pk))

        # Get version data
        version_data = version_obj.data

        try:
            # Store original state for change tracking
            item._original_state = self._clone_item(item)

            # Update item with version data
            for field, value in version_data.items():
                if hasattr(item, field) and field != self._get_primary_key():
                    setattr(item, field, value)

            # Increment version
            version_column = self.versioning_config.get('version_column', 'version')
            current_version = getattr(item, version_column, 0) or 0
            setattr(item, version_column, current_version + 1)

            # Set audit fields
            self._update_audit_fields(item)

            # Save changes
            self.datamodel.edit(item)

            # Create a new version entry for the restoration
            self._track_changes(item)

            flash(_(f"Successfully restored to version {version}"), "success")

        except Exception as e:
            flash(_(f"Error restoring version: {str(e)}"), "error")
            log.exception(f"Error restoring version {version} for {item}")

        return redirect(url_for(f'.versions', pk=pk))

    # Utility Methods
    def _get_base_query(self) -> Any:
        """
        Get base query with base filters applied.

        Returns:
            Any: Base SQLAlchemy query
        """
        query = self.datamodel.session.query(self.datamodel.obj)

        # Apply base filters
        if hasattr(self, 'base_filters') and self.base_filters:
            for filter_name, filter_value in self.base_filters:
                query = query.filter(filter_value)

        return query

    def _get_user_id(self) -> Optional[int]:
        """
        Get current user ID.

        Returns:
            Optional[int]: User ID or None if not authenticated
        """
        try:
            return g.user.id if hasattr(g, 'user') and g.user else None
        except Exception:
            return None

    def _user_has_role(self, role_name: str) -> bool:
        """
        Check if current user has a role.

        Args:
            role_name: Role name to check

        Returns:
            bool: True if user has the role, False otherwise
        """
        try:
            if hasattr(g, 'user') and g.user:
                return self.appbuilder.sm.has_role(g.user, role_name)
        except Exception:
            pass

        return False

    def _get_user_roles(self) -> List[str]:
        """
        Get current user roles.

        Returns:
            List[str]: List of role names
        """
        try:
            if hasattr(g, 'user') and g.user:
                return [r.name for r in g.user.roles]
        except Exception:
            pass

        return []

    def _run_event_handlers(self, handlers: List[Callable], *args, **kwargs) -> None:
        """
        Run registered event handlers.

        Args:
            handlers: List of handler functions
            *args: Arguments to pass to handlers
            **kwargs: Keyword arguments to pass to handlers
        """
        for handler in handlers:
            try:
                handler(*args, **kwargs)
            except Exception as e:
                log.error(f"Error in event handler {handler.__name__}: {str(e)}")

def get_redirect(self) -> str:
        """
        Get redirect URL.

        Returns:
            str: Redirect URL
        """
        if request.args.get('next'):
            return request.args.get('next')

        return url_for(f'{self.__class__.__name__}.list')

    # Custom Actions
    @action("merge_selected", "Merge Records", "Are you sure you want to merge these records?", "fa-compress")
    @handle_errors
    def merge_selected(self, items: List[Any]) -> Response:
        """
        Merge selected records.

        Args:
            items: List of records to merge

        Returns:
            Response: Redirect with status message
        """
        if len(items) < 2:
            flash(_("Select at least two records to merge"), "warning")
            return redirect(self.get_redirect())

        # Get primary record (first selected)
        primary_record = items[0]
        other_records = items[1:]

        if request.method == 'POST':
            # Get field values from form
            field_values = request.form.getlist('field_values')
            field_sources = request.form.getlist('field_sources')

            try:
                # Update primary record with selected values
                for field, source_idx in zip(field_values, field_sources):
                    source_idx = int(source_idx)
                    if source_idx == 0:  # Keep primary record value
                        continue
                    elif source_idx > 0 and source_idx <= len(other_records):  # Use value from other record
                        source_record = other_records[source_idx - 1]
                        setattr(primary_record, field, getattr(source_record, field))

                # Process the primary record
                self.pre_update(primary_record)

                # Save changes
                self.datamodel.edit(primary_record)

                # Post-process
                self.post_update(primary_record)

                # Delete other records
                for record in other_records:
                    self.pre_delete(record)
                    self.datamodel.delete(record)
                    self.post_delete(record)

                flash(_("Records merged successfully"), "success")
                return redirect(self.get_redirect())

            except Exception as e:
                flash(_(f"Error merging records: {str(e)}"), "error")
                log.exception(f"Error merging records: {str(e)}")

        # Prepare data for merge form
        merge_data = self._prepare_merge_data(primary_record, other_records)

        return self.render_template(
            'merge_records.html',
            title=_("Merge Records"),
            primary_record=primary_record,
            other_records=other_records,
            merge_data=merge_data,
            label_columns=self.label_columns
        )

    def _prepare_merge_data(self, primary_record: Any, other_records: List[Any]) -> List[Dict[str, Any]]:
        """
        Prepare data for merge form.

        Args:
            primary_record: Primary record for merge
            other_records: Other records to merge into primary

        Returns:
            List[Dict[str, Any]]: List of merge data entries
        """
        merge_data = []

        # Skip ID and read-only fields
        exclude_fields = [self._get_primary_key(), 'created_at', 'updated_at', 'created_by_fk', 'changed_by_fk']

        for field in self.edit_columns:
            if field in exclude_fields:
                continue

            # Get values from all records
            values = []
            values.append(getattr(primary_record, field))
            for record in other_records:
                values.append(getattr(record, field))

            # Check if values differ
            if len(set([str(v) for v in values])) > 1:
                field_data = {
                    'field': field,
                    'label': self.label_columns.get(field, field),
                    'values': values
                }
                merge_data.append(field_data)

        return merge_data

