        API endpoint for documentation.

        Returns:
            Response: HTML response with API documentation
        """
        if not self.has_api:
            return self.response(404, {'message': 'API not enabled for this resource'})

        return self.render_template(
            'api_docs.html',
            title=f"API Documentation for {self.model_name}",
            model=self.model_name,
            schema=self.api_schema,
