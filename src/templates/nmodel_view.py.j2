    def _validate_api_data(self, data: Dict[str, Any], is_update: bool) -> Dict[str, List[str]]:
        """
        Validate API request data against schema.

        Args:
            data: Request data
            is_update: Whether this is an update operation

        Returns:
            Dict[str, List[str]]: Dictionary of validation errors or empty dict if valid
        """
        errors = {}

        # Get schema properties
        model_columns = self._get_model_columns()

        # Validate each field
        for field_name, value in data.items():
            # Skip validation for primary key in updates
            if field_name == self._get_primary_key() and is_update:
                continue

            # Skip fields that don't exist in the model
            if field_name not in model_columns:
                errors[field_name] = [f"Unknown field: {field_name}"]
                continue

            # Validate field
            field_errors = self._validate_api_field(field_name, value)
            if field_errors:
                errors[field_name] = field_errors

        # Check required fields
        if not is_update:
            for field_name, column in model_columns.items():
                # Skip primary key and columns with defaults
                if field_name == self._get_primary_key() or column.default is not None:
                    continue

                # Check if field is required
                if not column.nullable and field_name not in data:
                    if field_name not in errors:
                        errors[field_name] = []
                    errors[field_name].append(f"{self.label_columns.get(field_name, field_name)} is required")

        return errors

    def _validate_api_field(self, field_name: str, value: Any) -> List[str]:
        """
        Validate a single field in API request data.

        Args:
            field_name: Field name
            value: Field value

        Returns:
            List[str]: List of validation errors or empty list if valid
        """
        errors = []

        try:
            # Check for None value on non-nullable fields
            column = getattr(self.datamodel.obj.__table__.columns, field_name, None)
            if column and not column.nullable and value is None:
                errors.append(f"{self.label_columns.get(field_name, field_name)} cannot be null")
                return errors

            # Skip further validation for None values
            if value is None:
                return errors

            # Validate based on field type
            field_errors = self._validate_field_type(field_name, value)
            if field_errors:
                errors.extend(field_errors)

            # Check unique constraints if configured
            field_config = self._get_field_config(field_name)
            if field_config.get('unique', False):
                unique_errors = self._check_unique_constraint(field_name, value)
                if unique_errors:
                    errors.extend(unique_errors)

            # Apply additional validators from configuration
            custom_errors = self._validate_custom_constraints(field_name, value)
            if custom_errors:
                errors.extend(custom_errors)

        except Exception as e:
            errors.append(f"Error validating {field_name}: {str(e)}")

        return errors

def _validate_custom_constraints(self, field_name: str, value: Any) -> List[str]:
        """
        Apply custom validation constraints to a field.

        Args:
            field_name: Field name
            value: Field value

        Returns:
            List[str]: List of validation errors or empty list if valid
        """
        errors = []

        # Get custom validators from config
        field_config = self._get_field_config(field_name)
        validators = field_config.get('validators', [])

        # Apply each validator
        for validator in validators:
            try:
                if isinstance(validator, str):
                    # Check for built-in validator method
                    validator_method = getattr(self, f'validate_{validator}', None)
                    if validator_method:
                        result = validator_method(field_name, value)
                        if isinstance(result, str):
                            errors.append(result)
                        elif result is False:
                            errors.append(f"Validation failed for {field_name}")
                else:
                    # Custom validator function
                    result = validator(field_name, value)
                    if isinstance(result, str):
                        errors.append(result)
                    elif result is False:
                        errors.append(f"Validation failed for {field_name}")
            except Exception as e:
                errors.append(str(e))

        return errors

    def _get_model_columns(self) -> Dict[str, Any]:
        """
        Get a dictionary of model columns.

        Returns:
            Dict[str, Any]: Dictionary of column name to column object mappings
        """
        try:
            return {c.name: c for c in self.datamodel.obj.__table__.columns}
        except Exception as e:
            log.warning(f"Error getting model columns: {str(e)}")
            return {}

    def _check_item_permissions(self, item: Any, operation: str) -> bool:
        """
        Check item-level permissions.

        Args:
            item: Item to check permissions for
            operation: Operation type ('read', 'edit', 'delete')

        Returns:
            bool: True if operation is allowed, False otherwise
        """
        # Check model-level method if it exists
        if hasattr(item, 'has_permission'):
            return item.has_permission(operation, self._get_user_id())

        # Check if item has an owner field
        owner_field = None
        for field in ['created_by_fk', 'owner_id', 'user_id']:
            if hasattr(item, field):
                owner_field = field
                break

        if owner_field:
            # Allow owner to perform operations
            owner_id = getattr(item, owner_field, None)
            user_id = self._get_user_id()

            if owner_id == user_id:
                return True

        # Check for admin role which can do everything
        if self._user_has_role('Admin'):
            return True

        # Default to allowing read operations but not edit/delete
        return operation == 'read'

