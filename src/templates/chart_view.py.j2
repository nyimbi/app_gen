import logging
from flask import current_app
from sqlalchemy import func, case, cast, Integer, desc, and_, or_
from flask_appbuilder.charts.views import ChartView
from flask_appbuilder.models.sqla.interface import SQLAInterface
from flask_appbuilder.models.group import aggregate_sum, aggregate_count, aggregate_avg
from flask_appbuilder.widgets import ListWidget, ShowWidget, FormWidget
from flask_appbuilder.fieldwidgets import (
     BS3TextFieldWidget,
     BS3PasswordFieldWidget,
     BS3TextAreaFieldWidget,
     Select2Widget,
     Select2ManyWidget,
     DatePickerWidget,
     DateTimePickerWidget,
