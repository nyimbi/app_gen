     # BS3FileUploadFieldWidget
 )
from flask_babel import lazy_gettext as _
from app import appbuilder, db
from ..models import {{ table_name|capitalize }}
log = logging.getLogger(__name__)

class {{ table_name|capitalize }}ChartView(ChartView):
    datamodel = SQLAInterface({{ table_name|capitalize }})
    chart_title = _("{{ table_name|capitalize }} Statistics")
    chart_type = "PieChart"
    chart_3d = True
    custom_template = ""

    # Define group by columns
    group_by_columns = ['{{ date_columns[0].name }}']

    # Define chart series
    definitions = [
        {
            "group": "{{ date_columns[0].name }}",
            "series": [(aggregate_count, "id")]
        }
    ]

    # Add formatters
    formatters_columns = {
        "{{ date_columns[0].name }}": lambda x: x.strftime("%Y-%m-%d") if x else "Unknown",
        "count": lambda x: f"{x:,.0f}"
    }

    label_columns = {
        "{{ date_columns[0].name }}": _("Date"),
        "count": _("Total Count")
    }

    # Remove the problematic base_filters and handle NULL values in get_data
    # base_filters = [['{{ date_columns[0].name }}', 'is not', None]]  # Remove this line

    # Chart layout configuration
    chart_width = 400
    chart_height = 400
    chart_orientation = "horizontal"

    # Search columns for filtering
    search_columns = ["{{ date_columns[0].name }}"]

    # Base order
    base_order = ("{{ date_columns[0].name }}", "asc")

    def get_data(self):
        """Get chart data with error handling and NULL value handling"""
        try:
            query = self.datamodel.session.query(
                self.datamodel.obj.{{ date_columns[0].name }},
                func.count(self.datamodel.obj.id).label('count')
            ).filter(
                self.datamodel.obj.{{ date_columns[0].name }}.isnot(None)
            ).group_by(
                self.datamodel.obj.{{ date_columns[0].name }}
            ).order_by(
                self.datamodel.obj.{{ date_columns[0].name }}
            )

            results = query.all()

            data = []
            for result in results:
                date_val = result[0]
                count_val = result[1]
                if date_val:  # Only include non-null dates
                    data.append({
                        'name': self.formatters_columns['{{ date_columns[0].name }}'](date_val),
                        'value': count_val
                    })

            return data

        except Exception as e:
            current_app.logger.error(f"Error getting chart data: {str(e)}")
            return []

    chart_options = {
        "colors": ["#3366CC", "#DC3912", "#FF9900", "#109618", "#990099"],
        "legend": {"position": "bottom"},
        "tooltip": {"trigger": "selection"},
        "height": 400,
        "width": 600,
        "orientation": "horizontal",
        "is3D": True,
        "pieHole": 0.4,
        "sliceVisibilityThreshold": 0.01,
        "chartArea": {
            "left": 50,
            "top": 50,
            "width": "90%",
            "height": "80%"
        }
    }

    def __init__(self, **kwargs):
        """Initialize the chart view"""
        super({{ table_name|capitalize }}ChartView, self).__init__(**kwargs)
        self.title = _("{{ table_name|capitalize }} Statistics")

    def pre_process_data(self, data):
        """Pre-process data before rendering"""
        try:
            processed_data = []
            for item in data:
                if item.get('name') and item.get('value') is not None:
                    processed_data.append({
                        'name': str(item['name']),
                        'value': float(item['value'])
                    })
            return processed_data
        except Exception as e:
            current_app.logger.error(f"Error pre-processing data: {str(e)}")
            return []


