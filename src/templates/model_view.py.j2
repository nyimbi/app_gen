        """Pre-process item before deletion"""
        self._check_delete_constraints(item)
        if self.has_versioning:
            self._archive_version(item)

    def _process_fields(self, item: Any) -> None:
        """Process all fields based on their types"""
        for field_name in self.add_columns:
            value = getattr(item, field_name, None)
            if value is not None:
                processed_value = self._process_form_field(field_name, value)
                setattr(item, field_name, processed_value)

    # File Handling
    @require_feature('file_upload')
    def _handle_file_upload(self, field_name: str, file_data: Any) -> str:
        """Handle file upload with proper validation and processing"""
        if not file_data:
            return None

        filename = secure_filename(file_data.filename)
        ext = filename.rsplit('.', 1)[1].lower()

        # Validate file type
        field_config = self._get_field_config(field_name)
        allowed_types = field_config.get('allowed_extensions',
                                       self.upload_config['allowed_extensions']['document'])

        if ext not in allowed_types:
            raise ValueError(f"Invalid file type. Allowed: {allowed_types}")

        # Validate file size
        if file_data.content_length > self.upload_config['max_size']:
            raise ValueError(f"File too large. Max size: {self.upload_config['max_size']} bytes")

        # Generate unique filename
        if not self.upload_config['preserve_filename']:
            filename = f"{datetime.now().strftime('%Y%m%d_%H%M%S')}_{filename}"

        # Save file
        file_path = os.path.join(self.upload_config['upload_folder'], filename)
        file_data.save(file_path)

        # Process image if necessary
        if field_name.endswith(('_img', '_photo')):
            self._process_image(file_path)

        return filename

    def _process_image(self, file_path: str) -> None:
        """Process uploaded image (resize, create thumbnail, etc.)"""
        try:
            from PIL import Image
            img = Image.open(file_path)

            # Create thumbnail
            thumb_size = self.upload_config['thumbnail_size']
            img.thumbnail(thumb_size)

            # Save thumbnail
            thumb_path = file_path.rsplit('.', 1)[0] + '_thumb.' + file_path.rsplit('.', 1)[1]
            img.save(thumb_path)
        except Exception as e:
            log.warning(f"Error processing image {file_path}: {str(e)}")

    # Workflow Management
@require_feature('workflow')
def _handle_workflow_state(self, item: Any, action: str) -> None:
    """Handle workflow state transitions"""
    if not hasattr(item, 'state'):
        return

    if action == 'create':
        initial_state = next(
            (state for state in self.workflow.states if state.is_initial),
            None
        )
        if initial_state:
            item.state = initial_state.name
    elif action == 'update':
        self._validate_workflow_transition(item)

@require_feature('workflow')
def _validate_workflow_transition(self, item: Any) -> None:
    """Validate workflow state transition"""
    if not hasattr(item, '_original_state'):
        return

    current_state = item._original_state
    new_state = item.state

    if current_state == new_state:
        return

    # Find valid transition
    transition = next(
        (t for t in self.workflow.transitions
         if current_state in t.source and t.dest == new_state),
        None
    )

    if not transition:
        raise ValueError(
            f"Invalid state transition: {current_state} -> {new_state}"
        )

    # Check permissions
    if not self._check_transition_permissions(transition):
        raise ValueError("You don't have permission for this transition")

def _check_transition_permissions(self, transition: Transition) -> bool:
    """Check if user has permission for workflow transition"""
    if not transition.required_roles:
        return True

    return any(
        self.appbuilder.sm.has_role(role)
        for role in transition.required_roles
    )

    @expose('/transition/<pk>/<trigger>')
    @has_access
    @handle_errors
    def transition_state(self, pk: Any, trigger: str) -> Response:
        """Handle workflow state transition"""
        item = self.datamodel.get(pk)
        if not item:
            abort(404)

        # Find transition
        transition = next(
            (t for t in self.workflow.transitions
            if t.trigger == trigger and item.state in t.source),
            None
        )

        if not transition or not self._check_transition_permissions(transition):
            flash(_('Transition not allowed'), 'error')
            return redirect(self.get_redirect())

        try:
            # Execute transition
            result = item.trigger_event(trigger, g.user)
            if result:
                flash(_('State updated successfully'), 'success')
            else:
                flash(_('State update failed'), 'error')
        except Exception as e:
            flash(str(e), 'error')

        return redirect(self.get_redirect())

    @expose('/transition/<pk>/<transition>')
    @has_access
    @handle_errors
    def transition_state(self, pk: Any, transition: str) -> Response:
        """Handle workflow state transition"""
        item = self.datamodel.get(pk)
        if not item:
            abort(404)

        if not self._can_transition(item, transition):
            flash(_('Transition not allowed'), 'error')
            return redirect(self.get_redirect())

        try:
            new_state = self.workflow_config['transitions'][transition]['to']
            item.state = new_state
            self.datamodel.session.commit()

            self._log_action('transition', item)
            flash(_('State updated successfully'), 'success')
        except Exception as e:
            flash(str(e), 'error')

        return redirect(self.get_redirect())

    # Version Control
    @require_feature('versioning')
    def _init_version(self, item: Any) -> None:
        """Initialize version tracking for new item"""
        item.version = 1
        item.version_date = datetime.now()
        item.version_user_id = g.user.id if hasattr(g, 'user') else None

    @require_feature('versioning')
    def _track_changes(self, item: Any) -> None:
        """Track changes for version control"""
        changes = self._get_changes(item)
        if changes:
            self._create_version(item, changes)

    def _get_changes(self, item: Any) -> dict:
        """Get changes between current and previous state"""
        if not hasattr(item, '_original_state'):
            return {}

        changes = {}
        for field in self.edit_columns:
            old_value = getattr(item._original_state, field, None)
            new_value = getattr(item, field, None)
            if old_value != new_value:
                changes[field] = {
                    'old': old_value,
                    'new': new_value
                }
        return changes

    @require_feature('versioning')
    def _create_version(self, item: Any, changes: dict) -> None:
        """Create new version record"""
        version_cls = self._get_version_class()
        version = version_cls(
            item_id=item.id,
            version=item.version + 1,
            changes=changes,
            created_at=datetime.now(),
            created_by=g.user.id if hasattr(g, 'user') else None
        )
        self.datamodel.session.add(version)
        item.version = version.version
        item.version_date = version.created_at


    # API Endpoints
    @expose('/api', methods=['GET'])
    @has_access_api
    @handle_errors
    def api_list(self) -> Response:
        """API endpoint for list view"""
        query = self._get_base_query()
        query = self._apply_filters(query)
        query = self._apply_search(query)
        query = self._apply_ordering(query)

        # Pagination
        page = request.args.get('page', 1, type=int)
        page_size = request.args.get('page_size', self.page_size, type=int)
        total_count = query.count()
        items = query.offset((page - 1) * page_size).limit(page_size).all()

        return self.response(200, {
            'data': [self._serialize_item(item) for item in items],
            'total_count': total_count,
            'page': page,
            'page_size': page_size,
            'total_pages': (total_count + page_size - 1) // page_size
        })

    def response(self, code: int, data: dict) -> Response:
        """Standardized API response"""
        return Response(
            json.dumps(data),
            status=code,
            mimetype="application/json"
        )

    def error_response(self, message: str, code: int = 400) -> Response:
        """Standardized error response"""
        return self.response(code, {"message": message})

    @expose('/api/<pk>', methods=['GET'])
    @has_access_api
    @handle_errors
    def api_show(self, pk: Any) -> Response:
        """API endpoint for show view"""
        item = self.datamodel.get(pk)
        if not item:
            return self.response(404, {'message': 'Not found'})
        return self.response(200, self._serialize_item(item))

    @expose('/api', methods=['POST'])
    @has_access_api
    @handle_errors
    def api_add(self) -> Response:
        """API endpoint for adding items"""
        if not request.is_json:
            return self.response(400, {'message': 'JSON required'})

        data = request.get_json()
        try:
            item = self.datamodel.obj(**data)
            self.pre_add(item)
            self.datamodel.add(item)
            self.post_add(item)
            return self.response(201, self._serialize_item(item))
        except Exception as e:
            return self.response(400, {'message': str(e)})

    @expose('/api/<pk>', methods=['PUT'])
    @has_access_api
    @handle_errors
    def api_edit(self, pk: Any) -> Response:
        """API endpoint for editing items"""
        if not request.is_json:
            return self.response(400, {'message': 'JSON required'})

        item = self.datamodel.get(pk)
        if not item:
            return self.response(404, {'message': 'Not found'})

        data = request.get_json()
        try:
            for key, value in data.items():
                setattr(item, key, value)
            self.pre_update(item)
            self.datamodel.edit(item)
            self.post_update(item)
            return self.response(200, self._serialize_item(item))
        except Exception as e:
            return self.response(400, {'message': str(e)})

    @expose('/api/<pk>', methods=['DELETE'])
    @has_access_api
    @handle_errors
    def api_delete(self, pk: Any) -> Response:
        """API endpoint for deleting items"""
        item = self.datamodel.get(pk)
        if not item:
            return self.response(404, {'message': 'Not found'})

        try:
            self.pre_delete(item)
            self.datamodel.delete(item)
            self.post_delete(item)
            return self.response(200, {'message': 'Deleted successfully'})
        except Exception as e:
            return self.response(400, {'message': str(e)})

    def _serialize_item(self, item: Any) -> dict:
        """Serialize item for API response"""
        data = {}
        for column in self.show_columns:
            value = getattr(item, column, None)
            formatter = self.formatters_columns.get(column)
            if formatter:
                value = formatter(value)
            data[column] = value
        return data

    @expose('/api/docs')
    @has_access_api
    def api_docs(self) -> Response:
        """Generate API documentation"""
        return self.render_template(
            'api_docs.html',
            endpoints=self._get_api_endpoints(),
            model=self.datamodel.obj,
            filters=self._get_filter_definitions()
        )


    # Import/Export Functionality
    @expose('/import', methods=['GET', 'POST'])
    @has_access
    @handle_errors
    def import_data(self) -> Response:
        """Import data from file"""
        if request.method == 'POST':
            if 'file' not in request.files:
                flash(_('No file uploaded'), 'error')
                return redirect(url_for(f'.{self.import_data.__name__}'))

            file = request.files['file']
            try:
                results = self._process_import_file(file)
                return self.render_template(
                    'import_review.html',
                    results=results,
                    config=self.import_config
                )
            except Exception as e:
                flash(str(e), 'error')

        return self.render_template(
            'import.html',
            config=self.import_config
        )

    def _process_import_file(self, file: Any) -> List[dict]:
        """Process import file based on format"""
        filename = secure_filename(file.filename)
        ext = filename.rsplit('.', 1)[1].lower()

        if ext == 'csv':
            return self._process_csv_import(file)
        elif ext == 'xlsx':
            return self._process_excel_import(file)
        elif ext == 'json':
            return self._process_json_import(file)
        else:
            raise ValueError(f"Unsupported file format: {ext}")

    def _process_csv_import(self, file: Any) -> List[dict]:
        """Process CSV import file"""
        results = []
        reader = csv.DictReader(file.stream.read().decode('utf-8').splitlines())

        for row in reader:
            try:
                processed_row = self._process_import_row(row)
                results.append({
                    'row': row,
                    'status': 'success',
                    'processed': processed_row
                })
            except Exception as e:
                results.append({
                    'row': row,
                    'status': 'error',
                    'error': str(e)
                })

        return results

    def _process_import_row(self, row: dict) -> dict:
        """Process single import row"""
        processed = {}
        for field, value in row.items():
            field_name = field.lower().strip()
            if field_name in self.add_columns:
                processed[field_name] = self._process_import_field(field_name, value)
        return processed

    def _process_import_field(self, field_name: str, value: Any) -> Any:
        """Process single import field"""
        if not value:
            return None

        field_config = self._get_field_config(field_name)
        field_type = field_config.get('type', 'string')

        try:
            if field_type == 'integer':
                return int(value)
            elif field_type == 'float':
                return float(value)
            elif field_type == 'boolean':
                return value.lower() in ('true', 'yes', '1', 'on')
            elif field_type == 'date':
                return parse(value).date()
            elif field_type == 'datetime':
                return parse(value)
            elif field_type == 'json':
                return json.loads(value)
            else:
                return str(value)
        except Exception as e:
            raise ValueError(f"Error processing field {field_name}: {str(e)}")

    @expose('/export/<export_type>')
    @has_access
    @handle_errors
    def export(self, export_type: str) -> Response:
        """Export data to file"""
        query = self._get_base_query()
        query = self._apply_filters(query)
        query = self._apply_search(query)
        query = self._apply_ordering(query)

        items = query.limit(self.export_max_rows).all()

        if export_type == 'csv':
            return self._export_csv(items)
        elif export_type == 'xlsx':
            return self._export_excel(items)
        elif export_type == 'json':
            return self._export_json(items)
        else:
            abort(400, f"Unsupported export type: {export_type}")

    def _export_csv(self, items: List[Any]) -> Response:
        """Export data to CSV"""
        output = io.StringIO()
        writer = csv.writer(output)

        # Write headers
        writer.writerow([self.label_columns.get(col, col) for col in self.list_columns])

        # Write data
        for item in items:
            row = []
            for column in self.list_columns:
                value = getattr(item, column, None)
                formatter = self.formatters_columns.get(column)
                if formatter:
                    value = formatter(value)
                row.append(str(value) if value is not None else '')
            writer.writerow(row)

        output.seek(0)
        return send_file(
            io.BytesIO(output.getvalue().encode('utf-8')),
            mimetype='text/csv',
            as_attachment=True,
            download_name=f'{self.__class__.__name__}_export_{datetime.now():%Y%m%d_%H%M%S}.csv'
        )


    def _export_json(self, items: List[Any]) -> Response:
        """Export to JSON"""
        data = [self._serialize_item(item) for item in items]
        return send_file(
            io.BytesIO(json.dumps(data, indent=2).encode()),
            mimetype='application/json',
            as_attachment=True,
            download_name=f'{self.__class__.__name__}_{datetime.now():%Y%m%d}.json'
        )

    def _export_yaml(self, items: List[Any]) -> Response:
        """Export to YAML"""
        data = [self._serialize_item(item) for item in items]
        return send_file(
            io.BytesIO(yaml.dump(data).encode()),
            mimetype='application/x-yaml',
            as_attachment=True,
            download_name=f'{self.__class__.__name__}_{datetime.now():%Y%m%d}.yaml'
        )


    # Advanced Search Functionality
    def _apply_search(self, query: Any) -> Any:
        """Apply search filters to query"""
        search_value = request.args.get('search', None)
        if search_value:
            search_queries = []
            for column in self.search_columns:
                col_obj = getattr(self.datamodel.obj, column, None)
                if col_obj is not None:
                    search_queries.extend(
                        self._build_search_queries(col_obj, search_value)
                    )
            if search_queries:
                query = query.filter(or_(*search_queries))
        return query

    def _build_search_queries(self, column: Any, search_value: str) -> List[Any]:
        """Build search queries based on column type"""
        queries = []
        if isinstance(column.type, (String, Text)):
            if not self.search_case_sensitive:
                queries.append(
                    func.lower(column).like(f"%{search_value.lower()}%")
                )
            else:
                queries.append(column.like(f"%{search_value}%"))
        elif isinstance(column.type, (Integer, Numeric)):
            try:
                val = float(search_value)
                queries.append(column == val)
            except ValueError:
                pass
        elif isinstance(column.type, (Date, DateTime)):
            try:
                date_val = parse(search_value)
                queries.append(column == date_val)
            except ValueError:
                pass
        return queries

    # Event Handlers
    def _init_event_handlers(self) -> None:
        """Initialize event handlers"""
        self.before_request_handlers = []
        self.after_request_handlers = []
        self.before_create_handlers = []
        self.after_create_handlers = []
        self.before_update_handlers = []
        self.after_update_handlers = []
        self.before_delete_handlers = []
        self.after_delete_handlers = []

    def before_request(self, f: Callable) -> Callable:
        """Decorator to register before request handler"""
        self.before_request_handlers.append(f)
        return f

    def after_request(self, f: Callable) -> Callable:
        """Decorator to register after request handler"""
        self.after_request_handlers.append(f)
        return f

    def _run_event_handlers(self, handlers: List[Callable], *args, **kwargs) -> None:
        """Run registered event handlers"""
        for handler in handlers:
            try:
                handler(*args, **kwargs)
            except Exception as e:
                log.error(f"Error in event handler {handler.__name__}: {str(e)}")

    # Audit Logging
    def _log_action(self, action_type: str, item: Any) -> None:
        """Log model changes"""
        if not hasattr(self.datamodel.obj, 'audit_log'):
            return

        try:
            log_entry = {
                'action': action_type,
                'timestamp': datetime.now(),
                'user_id': g.user.id if hasattr(g, 'user') else None,
                'item_id': getattr(item, 'id', None),
                'changes': self._get_changes(item),
                'table_name': self.datamodel.obj.__tablename__,
                'ip_address': request.remote_addr,
                'user_agent': request.user_agent.string,
            }

            audit_log = self.datamodel.obj.audit_log(**log_entry)
            self.datamodel.session.add(audit_log)
            self.datamodel.session.commit()
        except Exception as e:
            log.error(f"Error logging action: {str(e)}")

    # Cache Management
    def _get_cache_key(self, *args, **kwargs) -> str:
        """Generate cache key"""
        key_parts = [
            self.__class__.__name__,
            request.path,
            str(sorted(request.args.items())),
            str(args),
            str(sorted(kwargs.items()))
        ]
        return ':'.join(key_parts)

    def _get_cached_data(self, cache_key: str, callback: Callable) -> Any:
        """Get or set cached data"""
        if not current_app.config.get('CACHE_ENABLED', False):
            return callback()

        cached = current_app.cache.get(cache_key)
        if cached is not None:
            return cached

        data = callback()
        current_app.cache.set(
            cache_key,
            data,
            timeout=current_app.config.get('CACHE_DEFAULT_TIMEOUT', 300)
        )
        return data

    def _invalidate_cache(self, *patterns: str) -> None:
        """Invalidate cache entries matching patterns"""
        if not current_app.config.get('CACHE_ENABLED', False):
            return

        try:
            for pattern in patterns:
                current_app.cache.delete_pattern(pattern)
        except Exception as e:
            log.error(f"Error invalidating cache: {str(e)}")

    # Custom Actions
    @action("merge_selected", "Merge Records", "Are you sure you want to merge these records?", "fa-compress")
    @handle_errors
    def merge_selected(self, items: List[Any]) -> Response:
        """Merge selected records"""
        if len(items) < 2:
            flash(_("Select at least two records to merge"), "error")
            return redirect(self.get_redirect())

        if request.method == 'POST':
            try:
                primary_record = items[0]
                for item in items[1:]:
                    self._merge_records(primary_record, item)
                flash(_("Records merged successfully"), "success")
            except Exception as e:
                flash(str(e), "error")
            return redirect(self.get_redirect())

        return self.render_template(
            'merge_records.html',
            items=items,
            columns=self.edit_columns
        )

    def _merge_records(self, primary: Any, secondary: Any) -> None:
        """Merge two records"""
        for column in self.edit_columns:
            primary_value = getattr(primary, column, None)
            secondary_value = getattr(secondary, column, None)

            if primary_value is None and secondary_value is not None:
                setattr(primary, column, secondary_value)

        self.datamodel.session.delete(secondary)
        self.datamodel.session.commit()

    # Error Handlers
    @handle_errors
    def _handle_view_exception(self, exception: Exception) -> Response:
        """Handle view exceptions"""
        log.error(f"View exception: {str(exception)}")

        if isinstance(exception, PermissionError):
            flash(_("You don't have permission to perform this action"), "error")
        elif isinstance(exception, ValueError):
            flash(str(exception), "error")
        else:
            flash(_("An error occurred while processing your request"), "error")

        return redirect(self.get_redirect())


    # Security Methods
    def _check_permission(self, permission_name: str) -> bool:
        """Check user permission"""
        return self.appbuilder.sm.has_access(
            permission_name,
            self.class_permission_name
        )

    def _get_user_roles(self) -> List[str]:
        """Get current user roles"""
        return [role.name for role in g.user.roles]

    def _check_item_permissions(self, item: Any) -> bool:
        """Check item-level permissions"""
        if hasattr(item, 'check_permission'):
            return item.check_permission(g.user)
        return True

    def _log_action(self, action: str, item: Any, changes: dict = None) -> None:
        """Log model changes"""
        try:
            log_entry = {
                'action': action,
                'model': self.__class__.__name__,
                'item_id': getattr(item, 'id', None),
                'user_id': g.user.id,
                'timestamp': datetime.utcnow(),
                'changes': changes or {},
                'ip_address': request.remote_addr,
                'user_agent': request.user_agent.string
            }

            # Log to database
            AuditLog.create(**log_entry)

            # Log to application logger
            logging.info(f"Audit: {json.dumps(log_entry)}")

        except Exception as e:
            logging.error(f"Audit logging error: {str(e)}")

    # Helper Methods
    def _get_field_value(self, item: Any, field_name: str) -> Any:
        """Get field value with proper formatting"""
        value = getattr(item, field_name, None)
        formatter = self.formatters_columns.get(field_name)
        if formatter and value is not None:
            return formatter(value)
        return value

    def _set_field_value(self, item: Any, field_name: str, value: Any) -> None:
        """Set field value with proper processing"""
        try:
            processed_value = self._process_form_field(field_name, value)
            setattr(item, field_name, processed_value)
        except Exception as e:
            raise ValueError(f"Error setting {field_name}: {str(e)}")

    def _get_related_model(self, field_name: str) -> Optional[Any]:
        """Get related model for a field"""
        try:
            column = getattr(self.datamodel.obj, field_name)
            if hasattr(column, 'property') and hasattr(column.property, 'mapper'):
                return column.property.mapper.class_
        except Exception:
            pass
        return None


    def process_form_post(self, form: Any, is_created: bool = False) -> None:
        """Process form after submission"""
        try:
            self._validate_form(form, not is_created)
            self._process_relationships(form)
            self._handle_file_uploads(form)
            self._update_audit_fields(form)
        except Exception as e:
            raise ValueError(f"Form processing error: {str(e)}")

    def _process_relationships(self, form: Any) -> None:
        """Process relationship fields"""
        for col in self.edit_columns:
            if hasattr(form, col):
                field = getattr(form, col)
                if hasattr(field, 'process_relationships'):
                    field.process_relationships()

    def _handle_file_uploads(self, form: Any) -> None:
        """Process file upload fields"""
        if not self.has_file_upload:
            return

        for field_name in self.upload_columns:
            field = getattr(form, field_name, None)
            if field and field.data:
                self._process_file_field(field_name, field.data)



    @staticmethod
    def _get_user_id() -> Optional[int]:
        """Get current user ID safely"""
        try:
            return g.user.id if hasattr(g, 'user') else None
        except Exception:
            return None

    def is_editable(self, item: Any) -> bool:
        """Check if item is editable"""
        if not self.can_edit:
            return False

        if hasattr(item, 'is_editable'):
            return item.is_editable()

        if hasattr(item, 'created_by_id'):
            return item.created_by_id == self._get_user_id()

        return True

    def is_deletable(self, item: Any) -> bool:
        """Check if item is deletable"""
        if not self.can_delete:
            return False

        if hasattr(item, 'is_deletable'):
            return item.is_deletable()

        if hasattr(item, 'created_by_id'):
            return item.created_by_id == self._get_user_id()

        return True

