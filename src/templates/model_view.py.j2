# Decorators
def handle_errors(f):
    """Enhanced error handling decorator"""
    @wraps(f)
    def wrapper(self, *args, **kwargs):
        try:
            return f(self, *args, **kwargs)
        except PermissionError as e:
            flash(str(e), "danger")
            logging.error(f"Permission error in {f.__name__}: {str(e)}")
            return redirect(self.get_redirect())
        except ValueError as e:
            flash(str(e), "warning")
            logging.warning(f"Validation error in {f.__name__}: {str(e)}")
            return redirect(self.get_redirect())
        except Exception as e:
            flash(str(e), "error")
            logging.error(f"Error in {f.__name__}: {str(e)}")
            return redirect(self.get_redirect())
    return wrapper

def require_feature(feature_name):
    """Decorator to check if feature is enabled"""
    def decorator(f):
        @wraps(f)
        def wrapper(self, *args, **kwargs):
            if not getattr(self, f'has_{feature_name}', False):
                flash(f"{feature_name} feature is not enabled", "warning")
                return redirect(self.get_redirect())
            return f(self, *args, **kwargs)
        return wrapper
    return decorator

def audit_log(action_type):
    """Decorator to log actions"""
    def decorator(f):
        @wraps(f)
        def wrapper(self, *args, **kwargs):
            result = f(self, *args, **kwargs)
            self._log_action(action_type, args[0] if args else None)
            return result
        return wrapper
    return decorator

