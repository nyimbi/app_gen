    def __init__(self, **kwargs):
        """Initialize the view with proper validation and feature detection"""
        super().__init__(**kwargs)
        self._validate_required_configs()
        self._init_features()
        self._init_formatters()
        self._init_validators()

    def _validate_required_configs(self):
        """Validate that required configurations are present"""
        required = ['list_columns', 'label_columns']
        for config in required:
            if not hasattr(self, config):
                raise ValueError(f"Missing required configuration: {config}")

    def _init_features(self):
        """Initialize enabled features"""
        self.has_file_upload = hasattr(self, 'upload_config')
        self.has_workflow = hasattr(self, 'workflow_config')
        self.has_versioning = hasattr(self, 'versioning_config')
        self.has_dynamic_forms = hasattr(self, 'dynamic_form_config')

    def _init_formatters(self):
        """Initialize field formatters"""
        self.formatters_columns = {}
        for column in self.list_columns:
            formatter = self._get_formatter(column)
            if formatter:
                self.formatters_columns[column] = formatter

    def _init_validators(self):
        """Initialize field validators"""
        self.validators_columns = {}
        for column in self.add_columns + self.edit_columns:
            validators = self._get_validators(column)
            if validators:
                self.validators_columns[column] = validators

    # Field Type Utils
    def _get_field_config(self, field_name: str) -> dict:
        """Get field configuration with fallbacks"""
        try:
            return self.field_type_config.get(field_name, {})
        except AttributeError:
            return {}

    def _get_formatter(self, field_name: str) -> Optional[Callable]:
        """Get field formatter with fallback"""
        try:
            field_config = self._get_field_config(field_name)
            formatter = field_config.get('formatter')
            if formatter:
                return getattr(self, formatter, None) or formatter
        except Exception as e:
            log.warning(f"Error getting formatter for {field_name}: {str(e)}")
        return None

    def _get_validators(self, field_name: str) -> List[Callable]:
        """Get field validators"""
        validators = []
        try:
            field_config = self._get_field_config(field_name)
            field_validators = field_config.get('validators', [])
            for validator in field_validators:
                if isinstance(validator, str):
                    validator_func = getattr(validators, validator, None)
                    if validator_func:
                        validators.append(validator_func())
                else:
                    validators.append(validator)
        except Exception as e:
            log.warning(f"Error getting validators for {field_name}: {str(e)}")
        return validators

    # Form Processing
    def _process_form_field(self, field_name: str, value: Any) -> Any:
        """Process form field value based on field type"""
        field_config = self._get_field_config(field_name)
        field_type = field_config.get('type')

        if field_type == 'json':
            return self._process_json_field(value)
        elif field_type == 'file':
            return self._process_file_field(field_name, value)
        elif field_type == 'date':
            return self._process_date_field(value)
        elif field_type == 'datetime':
            return self._process_datetime_field(value)

        return value

    @handle_errors
    def _process_json_field(self, value: str) -> dict:
        """Process JSON field value"""
        if not value:
            return None
        return json.loads(value)

    @handle_errors
    def _process_file_field(self, field_name: str, file_data: Any) -> str:
        """Process file upload field"""
        if not file_data:
            return None

        if not self.has_file_upload:
            raise ValueError("File upload not configured")

        return self._handle_file_upload(field_name, file_data)

    @handle_errors
    def _process_date_field(self, value: str) -> date:
        """Process date field value"""
        if not value:
            return None
        return parse(value).date()

    @handle_errors
    def _process_datetime_field(self, value: str) -> datetime:
        """Process datetime field value"""
        if not value:
            return None
        return parse(value)

    # Form Validation
    def _validate_form(self, form: Any, is_edit: bool = False) -> None:
        """Validate form data"""
        self._validate_required_fields(form)
        self._validate_field_types(form)
        self._validate_unique_constraints(form, is_edit)
        self._validate_custom_rules(form)

    def _validate_required_fields(self, form: Any) -> None:
        """Validate required fields"""
        for field_name in self.add_columns:
            field_config = self._get_field_config(field_name)
            if field_config.get('required', False):
                if not getattr(form, field_name).data:
                    raise ValueError(f"{field_name} is required")

    def _validate_field_types(self, form: Any) -> None:
        """Validate field types"""
        for field_name in self.add_columns:
            value = getattr(form, field_name).data
            if value is not None:
                self._validate_field_type(field_name, value)

    def _validate_unique_constraints(self, form: Any, is_edit: bool) -> None:
        """Validate unique constraints"""
        for field_name in self.add_columns:
            field_config = self._get_field_config(field_name)
            if field_config.get('unique', False):
                value = getattr(form, field_name).data
                if value is not None:
                    self._check_unique_constraint(field_name, value, is_edit)

    def _validate_custom_rules(self, form: Any) -> None:
        """Validate custom business rules"""
        for validator in self.validators_columns.get(form.name, []):
            validator(form)


    # CRUD Operations
    @handle_errors
