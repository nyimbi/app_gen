from flask import Blueprint, current_app
from flask_appbuilder import AppBuilder, has_access
from flask_appbuilder.views import ModelView, MultipleView, BaseView

{%- if single_file %}
from .views import *
{% else %}
# Import views based on table requirements
{%- for view in views_info %}
# Imports for {{ view.name }}
{%- if view.has_model_view %}
from .{{ view.name|lower }}_model_view import {{ view.capitalize_name }}ModelView
{%- endif %}
{%- if view.has_multiple_view %}
from .{{ view.name|lower }}_multiple_view import {{ view.capitalize_name }}MultipleView
{%- endif %}
{%- if view.has_chart_view %}
from .{{ view.name|lower }}_chart_view import {{ view.capitalize_name }}ChartView
{%- endif %}
{%- if view.has_wizard_view %}
from .{{ view.name|lower }}_wizard_view import {{ view.capitalize_name }}WizardView
{%- endif %}
{%- if view.has_calendar_view %}
from .{{ view.name|lower }}_calendar_view import {{ view.capitalize_name }}CalendarView
{%- endif %}
{%- if view.has_report_view %}
from .{{ view.name|lower }}_report_view import {{ view.capitalize_name }}ReportView
{%- endif %}
{%- if view.has_api_view %}
from .{{ view.name|lower }}_api import {{ view.capitalize_name }}Api
{%- endif %}
{%- endfor %}
{%- endif %}

def register_views(appbuilder: AppBuilder):
    """
    Register views with AppBuilder.
    This function is called by the blueprint's init_app function.
    """
    registered_views = {}

    # Register Model Views first
    {%- for view in views_info %}
    {% if view.has_model_view %}
    registered_views['{{ view.capitalize_name }}ModelView'] = {{
    view.capitalize_name }}ModelView
    appbuilder.add_view(
        {{ view.capitalize_name }}ModelView,
        "{{ view.capitalize_name }}",
        icon="fa-folder-open-o",
        category="Master Data",
        category_icon="fa-database"
    )
    {% endif %}
    {%- endfor %}

    # Then register Multiple Views (which depend on Model Views)
    {%- for view in views_info %}
    {% if view.has_multiple_view %}
    multiple_view = {{ view.capitalize_name }}MultipleView
    # Set related views using registered view classes
    multiple_view.related_views = [
        # registered_views[view_name] for view_name in [
            {%- for related in view.relationships %}
            "{{ related.referred_table|capitalize }}ModelView",
            {%- endfor %}
        #]
    ]
    appbuilder.add_view(
        multiple_view,
        "{{ view.capitalize_name }} Multiple",
        icon="fa-dashboard",
        category="Multiple Views",
        category_icon="fa-list"
    )
    {% endif %}
    {%- endfor %}

    # Register other views
    {%- for view in views_info %}
    {% if view.has_chart_view %}
    appbuilder.add_view(
        {{ view.capitalize_name }}ChartView,
        "{{ view.capitalize_name }} Charts",
        icon="fa-bar-chart",
        category="Charts",
        category_icon="fa-bar-chart"
    )
    {% endif %}

    {% if view.has_wizard_view %}
    appbuilder.add_view(
        {{ view.capitalize_name }}WizardView,
        "{{ view.capitalize_name }} Wizard",
        icon="fa-magic",
        category="Wizards",
        category_icon="fa-magic",
        href="/{{ view.capitalize_name.lower() }}_wizard/"
    )
    {% endif %}

    {% if view.has_calendar_view %}
    appbuilder.add_view(
        {{ view.capitalize_name }}CalendarView,
        "{{ view.capitalize_name }} Calendar",
        icon="fa-calendar",
        category="Calendars",
        category_icon="fa-calendar"
    )
    {% endif %}

    {% if view.has_report_view %}
    appbuilder.add_view(
        {{ view.capitalize_name }}ReportView,
        "{{ view.capitalize_name }} Reports",
        icon="fa-file-text-o",
        category="Reports",
        category_icon="fa-files-o"
    )
    {% endif %}

    {% if view.has_api_view %}
    appbuilder.add_api({{ view.capitalize_name }}Api)
    {% endif %}
    {%- endfor %}
