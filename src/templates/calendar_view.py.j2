class {{ table_name | capitalize }}CalendarView(ModelView):
    datamodel = SQLAInterface({{ table_name | capitalize}})
    base_order = ('{{ date_columns[0] }}', 'asc')
    custom_template = ""

    date_columns = [{% for col in date_columns %}'{{ col }}'{% if not loop.last %}, {% endif %}{% endfor %}]
    default_date_column = '{{ date_columns[0] }}'

    list_title = '{{ table_name }} Calendar'
    show_title = 'Event Details'

    # Columns configuration
    list_columns = [{%- for col in columns %}{%- if not col.primary_key %}'{{ col.name }}'{%- if not loop.last %}, {%- endif -%}{%- endif -%}{%- endfor -%}]
    edit_columns = [{%- for col in columns %}{%- if not col.primary_key %}'{{ col.name }}'{%- if not loop.last %}, {%- endif -%}{%- endif -%}{%- endfor -%}]
    show_columns = [{%- for col in columns %}{%- if not col.primary_key %}'{{ col.name }}'{%- if not loop.last %}, {%- endif -%}{%- endif -%}{%- endfor -%}]

    @expose('/calendar/')
    @has_access
    def calendar(self):
        widgets = self._get_calendar_widget()
        return render_template(
            'calendar_view.html',
            title=self.list_title,
            widgets=widgets,
            appbuilder=self.appbuilder,
            date_columns=self.date_columns,
            default_date_column=self.default_date_column
        )

    @expose('/calendar/events/')
    @has_access
    def calendar_events(self):
        start_date = request.args.get('start', '')
        end_date = request.args.get('end', '')
        date_column = request.args.get('date_column', self.default_date_column)

        if start_date and end_date:
            query = self.datamodel.session.query({{ table_name }}).filter(
                getattr({{ table_name }}, date_column) >= start_date,
                getattr({{ table_name }}, date_column) <= end_date
            )
            events = []
            for item in query.all():
                event = {
                    'id': item.id,
                    'title': getattr(item, 'name', str(item)),  # More meaningful representation
                    'start': getattr(item, date_column).isoformat(),
                    'url': f"{request.script_root}{self.show_url}?id={item.id}"
                }
                if hasattr(item, 'end_date'):
                    event['end'] = item.end_date.isoformat()
                events.append(event)
            return jsonify(events)
        return jsonify([])

    def _get_calendar_widget(self):
        date_column_form = FormWidget()
        date_column_form.template = 'calendar_date_column_form.html'
        date_column_form.date_column = SelectField(
            'Date Column',
            choices=[(col, col.capitalize()) for col in self.date_columns],
            validators=[DataRequired()]
        )
        return {
            'date_column_form': date_column_form
        }

    @expose('/calendar/today/')
    @has_access
    def calendar_today_events(self):
        today = datetime.now().date()
        tomorrow = today + timedelta(days=1)
        date_column = request.args.get('date_column', self.default_date_column)

        query = self.datamodel.session.query({{ table_name }}).filter(
            getattr({{ table_name }}, date_column) >= today,
            getattr({{ table_name }}, date_column) < tomorrow
        )
        events = [
            {
                'id': item.id,
                'title': getattr(item, 'name', str(item)),
                'start': getattr(item, date_column).isoformat(),
                'url': f"{request.script_root}{self.show_url}?id={item.id}"
            } for item in query.all()
        ]
        return jsonify(events)

    @expose('/calendar/month/')
    @has_access
    def calendar_month_summary(self):
        year = int(request.args.get('year', datetime.now().year))
        month = int(request.args.get('month', datetime.now().month))
        date_column = request.args.get('date_column', self.default_date_column)

        first_day = datetime(year, month, 1)
        last_day = first_day.replace(day=calendar.monthrange(year, month)[1])

        query = self.datamodel.session.query({{ table_name }}).filter(
            getattr({{ table_name }}, date_column) >= first_day,
            getattr({{ table_name }}, date_column) <= last_day
        )

        events_count = query.count()
        return jsonify({
            'year': year,
            'month': month,
            'events_count': events_count
        })

    @expose('/calendar/add_event/', methods=['POST'])
    @has_access
    def add_event(self):
        """
        Endpoint to add an event to the calendar.
        """
        try:
            data = request.get_json()
            new_event = {{ table_name }}(**data)
            self.datamodel.add(new_event, raise_exception=True)
            db.session.commit()
            return jsonify({"status": "success"}), 201
        except Exception as e:
            db.session.rollback()
            return jsonify({"error": str(e)}), 400

    @expose('/calendar/event/<pk>/', methods=['GET'])
    @has_access
    def get_event_details(self, pk):
        """
        Endpoint to get detailed information for a specific event.
        """
        try:
            event = self.datamodel.get(pk, raise_exception=True)
            return jsonify(event.to_dict()), 200
        except Exception as e:
            return jsonify({"error": str(e)}), 400

