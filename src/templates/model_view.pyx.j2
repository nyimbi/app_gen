    def _can_transition(self, item, transition):
        """Check if state transition is allowed"""
        if not self.workflow_config['enabled']:
            return True

        current_state = getattr(item, 'state', None)
        if not current_state:
            return False

        transition_config = self.workflow_config['transitions'].get(transition)
        if not transition_config:
            return False

        if current_state != transition_config['from']:
            return False

        permission = transition_config.get('permission')
        if permission and not self.appbuilder.sm.has_access(permission):
            return False

        return True

    @expose('/transition/<pk>/<transition>')
    @has_access
    def transition_state(self, pk, transition):
        """Handle state transition"""
        item = self.datamodel.get(pk)
        if not item:
            abort(404)

        if not self._can_transition(item, transition):
            flash(_('Transition not allowed'), 'error')
            return redirect(self.get_redirect())

        try:
            self._perform_transition(item, transition)
            flash(_('State updated successfully'), 'success')
        except Exception as e:
            flash(str(e), 'error')

        return redirect(self.get_redirect())

