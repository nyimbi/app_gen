    def _process_dynamic_form(self, form):
        """Process dynamic form fields"""
        if not self.dynamic_form_config['enabled']:
            return form

        for field, config in self.dynamic_form_config['conditional_fields'].items():
            dependent_value = form.get(config['depends_on']).data
            if config['show_if'](dependent_value):
                if config.get('required_if', lambda x: False)(dependent_value):
                    form.get(field).validators.append(DataRequired())
            else:
                form._fields.pop(field, None)

        for field, config in self.dynamic_form_config['calculated_fields'].items():
            values = [form.get(f).data for f in config['depends_on']]
            form.get(field).data = config['calculate'](*values)

        return form

