class FilterMixin:
    """Mixin class to add advanced filtering capabilities to views

    This mixin provides methods to:
    1. Apply role-based filters
    2. Handle client context filtering
    3. Apply user-specific filters
    4. Manage filter combinations
    5. Handle filter persistence

    Attributes:
        base_filter_roles (dict): Mapping of roles to their base filters
        default_filters (list): List of default filters to always apply
        filter_converter (dict): Custom filter type conversions
        persist_filters (bool): Whether to persist filters across sessions
    """

    base_filter_roles = {
        'Admin': [],
        'Client': [('client_id', FilterEqualFunction, lambda: get_filter_client_id())],
        'User': [('user_id', FilterEqualFunction, lambda: get_filter_user_id())]
    }
    default_filters = []
    filter_converter = {}
    persist_filters = True

    def get_base_filters(self):
        """Get base filters based on user role and context

        Returns:
            list: List of filter tuples to apply
        """
        filters = []

        # Add role-based filters
        if not is_admin():
            if hasattr(self.datamodel.obj, 'client_id'):
                client_ids = get_user_clients()
                if client_ids:
                    filters.append(('client_id', 'in', client_ids))

            if hasattr(self.datamodel.obj, 'user_id'):
                filters.append(('user_id', FilterEqualFunction, get_filter_user_id))

        # Add default filters
        filters.extend(self.default_filters)

        return filters

    def apply_filters(self, query):
        """Apply all filters to query

        Args:
            query: SQLAlchemy query object

        Returns:
            Modified query with filters applied
        """
        filters = self.get_base_filters()
        for filter_name, filter_func, filter_arg in filters:
            if callable(filter_arg):
                filter_arg = filter_arg()
            if filter_arg is not None:
                query = query.filter(filter_func(getattr(self.datamodel.obj, filter_name), filter_arg))
        return query

    def pre_update(self, item):
        """Check permissions before update

        Args:
            item: Model instance being updated

        Raises:
            PermissionError: If user doesn't have permission
        """
        if not is_admin():
            if hasattr(item, 'client_id'):
                client_ids = get_user_clients()
                if client_ids and item.client_id not in client_ids:
                    raise PermissionError("You don't have permission to update this item")

    def get_user_filters(self):
        """Get filters specific to current user

        Returns:
            list: User-specific filters
        """
        filters = []
        for role in current_user.roles:
            role_filters = self.base_filter_roles.get(role.name, [])
            filters.extend(role_filters)
        return filters

    def combine_filters(self, base_filters, user_filters):
        """Combine different types of filters

        Args:
            base_filters (list): Base filters from view
            user_filters (list): User-specific filters

        Returns:
            list: Combined and deduplicated filters
        """
        all_filters = []
        seen = set()

        for f in base_filters + user_filters:
            filter_key = (f[0], str(f[1]))
            if filter_key not in seen:
                all_filters.append(f)
                seen.add(filter_key)

        return all_filters


