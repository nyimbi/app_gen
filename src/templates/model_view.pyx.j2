    def render_form(self, form, **kwargs):
        self._init_vars()
        form._fields = self._get_fields_in_fieldset_order(form._fields)
        kwargs['fieldset_display_config'] = self.fieldset_display_config
        return super().render_form(form, **kwargs)

    def _get_fields_in_fieldset_order(self, fields):
        """Reorder form fields according to fieldset order"""
        ordered_fields = {}
        fieldset_order = (
            self.add_fieldset_order
            if self.action == 'add'
            else self.edit_fieldset_order
        )

        # First add fields in fieldset order
        for section in fieldset_order:
            if section in self.fieldsets:
                for field_name in self.fieldsets[section]['fields']:
                    if field_name in fields:
                        ordered_fields[field_name] = fields[field_name]

        # Add any remaining fields
        for field_name, field in fields.items():
            if field_name not in ordered_fields:
                ordered_fields[field_name] = field

        return ordered_fields


