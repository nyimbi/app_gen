    @action("toggle_active", "Toggle Active", "Are you sure you want to toggle the active status?", "fa-check")
    def toggle_active(self, items):
        for item in items:
            item.active = not item.active
            db.session.add(item)
        db.session.commit()
        flash("Toggled active status for selected items", "success")
        return redirect(self.get_redirect())

    @action("batch_update", "Batch Update", "Are you sure you want to update these items?", "fa-edit")
    def batch_update(self, items):
        """Batch update selected items"""
        if not items:
            flash("No items selected", "warning")
            return redirect(self.get_redirect())

        # Get common editable fields
        editable_cols = set(self.edit_columns)
        for item in items:
            editable_cols &= set(item.__table__.columns.keys())

        if request.method == 'POST':
            # Process form data
            for field in editable_cols:
                value = request.form.get(field)
                if value:
                    for item in items:
                        setattr(item, field, value)

            db.session.commit()
            flash(f"Updated {len(items)} items", "success")
            return redirect(self.get_redirect())

        # Show batch update form
        return self.render_template(
            'batch_update.html',
            items=items,
            editable_columns=list(editable_cols)
        )

    def _json_formatter(self, value):
        """Format JSON fields for display"""
        if value is None:
            return ""
        try:
            if isinstance(value, str):
                value = json.loads(value)
            return Markup(f"<pre>{json.dumps(value, indent=2)}</pre>")
        except:
            return str(value)

    def _json_edit_field(self, field_name):
        """Create a custom field for editing JSON data"""
        return {
            "field_name": field_name,
            "widget": BS3TextAreaFieldWidget(),
            "validators": [
                lambda form, field: self._validate_json(form, field)
            ],
            "description": _("Enter valid JSON data")
        }

    def _validate_json(self, form, field):
        """Validate JSON input"""
        if field.data:
            try:
                json.loads(field.data)
            except json.JSONDecodeError as e:
                raise validators.ValidationError(f"Invalid JSON: {str(e)}")

