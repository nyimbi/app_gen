        # Write headers
        headers = [self.label_columns.get(col, col) for col in self.list_columns]
        for col, header in enumerate(headers):
            worksheet.write(0, col, header)

        # Write data
        for row, item in enumerate(items, start=1):
            for col, column in enumerate(self.list_columns):
                value = getattr(item, column, '')
                if column in self.formatters_columns:
                    value = self.formatters_columns[column](value)
                worksheet.write(row, col, value)

        workbook.close()
        output.seek(0)

        return send_file(
            output,
            mimetype='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
            as_attachment=True,
            download_name=f'{self.__class__.__name__}_export_{datetime.now():%Y%m%d_%H%M%S}.xlsx'
        )

    def _apply_custom_filters(self, query):
        """Apply custom filters to query"""
        for filter_name, filter_func in self.custom_filters.items():
            filter_value = request.args.get(filter_name)
            if filter_value:
                query = filter_func(query, filter_value)
        return query

    def _apply_custom_ordering(self, query):
        """Apply custom ordering to query"""
        order_column = request.args.get('order_column', self.base_order[0])
        order_direction = request.args.get('order_direction', self.base_order[1])

        if order_column in self.custom_ordering:
            query = self.custom_ordering[order_column](query, order_direction)
        return query

