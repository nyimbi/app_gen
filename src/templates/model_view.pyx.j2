    # Enhanced CSV export functionality
    @action("export_csv", "Export CSV", "Export selected records to CSV?", "fa-file-text")
    def export_csv(self, items):
        if not items:
            flash("No records selected for export", "warning")
            return redirect(self.get_redirect())

        # Create in-memory file
        output = io.StringIO()
        writer = csv.writer(output)

        # Write headers
        columns = self.list_columns
        writer.writerow([self.label_columns.get(col, col) for col in columns])

        # Write data
        for item in items:
            row = []
            for col in columns:
                value = getattr(item, col, None)

                # Apply formatters for special data types
                if col in self.formatters_columns:
                    if isinstance(self.formatters_columns[col], types.FunctionType):
                        value = self.formatters_columns[col](value)
                    else:
                        value = self.formatters_columns[col].format(value)

                # Handle specific data types
                if isinstance(value, (datetime, date)):
                    value = value.isoformat()
                elif isinstance(value, (dict, list)):
                    value = json.dumps(value)

                row.append(str(value) if value is not None else '')

            writer.writerow(row)

        # Prepare response
        output.seek(0)
        return send_file(
            io.BytesIO(output.getvalue().encode('utf-8')),
            mimetype='text/csv',
            as_attachment=True,
            download_name=f'{self.__class__.__name__}_{datetime.now().strftime("%Y%m%d_%H%M%S")}.csv'
        )

    # Field type detection and configuration
    def _get_field_widget(self, column_name, column_type):
        """Get appropriate widget based on field type"""
        if isinstance(column_type, (JSON, JSONB)):
            return self._json_edit_field(column_name)
        return super()._get_field_widget(column_name, column_type)

    # Add filter setup
    def _init_filters(self):
        """Initialize filters based on column types"""
        super()._init_filters()

        for column in self.datamodel.obj.__table__.columns:
            if isinstance(column.type, (JSON, JSONB)):
                self.filter_converter.add_filter(
                    type(column.type),
                    FilterContains,
                    FilterNotEqual,
                    FilterStartsWith,
                    FilterEndsWith
                )

    def _apply_search_filter(self, query, search_value):
        """Apply search filter across multiple columns"""
        if not search_value:
            return query

        search_queries = []
        for column in self.search_columns:
            col_obj = getattr(self.datamodel.obj, column, None)
            if col_obj is not None:
                if isinstance(col_obj.type, (String, Text)):
                    search_queries.append(col_obj.ilike(f"%{search_value}%"))
                elif isinstance(col_obj.type, (Integer, Numeric)):
                    try:
                        val = float(search_value)
                        search_queries.append(col_obj == val)
                    except ValueError:
                        continue

        if search_queries:
            query = query.filter(or_(*search_queries))
        return query

    def show(self, pk):
        """Override show method to handle formatters"""
        item = self.datamodel.get(pk)
        if not item:
            abort(404)
        widgets = self._get_show_widget(pk)
        self._apply_formatters(widgets)
        return self._show(pk, widgets)

    def _apply_formatters(self, widgets):
        """Apply formatters to widgets based on field type"""
        for widget in widgets:
            if widget.name in self.formatters_columns:
                widget.formatter = self.formatters_columns[widget.name]

    def pre_update(self, item):
        """Pre-process data before update"""
        for column in self.datamodel.obj.__table__.columns:
            if isinstance(column.type, (JSON, JSONB)):
                value = getattr(item, column.name, None)
                if isinstance(value, str):
                    try:
                        setattr(item, column.name, json.loads(value))
                    except json.JSONDecodeError:
                        flash(f"Invalid JSON in field {column.name}", "error")
                        raise Exception(f"Invalid JSON in field {column.name}")

    def process_form_post(self, form):
        """Process form data after POST"""
        form_data = super().process_form_post(form)

        # Process JSON fields
        for column in self.datamodel.obj.__table__.columns:
            if isinstance(column.type, (JSON, JSONB)) and column.name in form_data:
                try:
                    if form_data[column.name]:
                        form_data[column.name] = json.loads(form_data[column.name])
                    else:
                        form_data[column.name] = None
                except json.JSONDecodeError:
                    flash(f"Invalid JSON in field {column.name}", "error")
                    raise Exception(f"Invalid JSON in field {column.name}")

        return form_data

    template_macros = {
        'render_json': lambda value: Markup(f"<pre>{json.dumps(value, indent=2)}</pre>") if value else "",
        'render_currency': lambda value: currency_filter(value),
        'render_number': lambda value: number_filter(value),
        'render_datetime': lambda value: datetime_filter(value),
        'render_date': lambda value: value.strftime('%Y-%m-%d') if value else "",
    }


    def _init_related_fields(self):
        """Initialize related fields based on foreign keys"""
        for column in self.datamodel.obj.__table__.columns:
            if column.foreign_keys:
                fk = list(column.foreign_keys)[0]
                referred_table = fk.column.table.name
