    enable_conditional_steps = {{ config.get("enable_conditional_steps", False) if config else False }}

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.session_key = f'{self.endpoint}_wizard_data'
        self.current_step = 1
        self.total_steps = len(self.steps_config)

    def get_session_data(self):
        """Get wizard data from session"""
        return session.get(self.session_key, {})

    def save_session_data(self, data):
        """Save wizard data to session"""
        session[self.session_key] = data
        session.modified = True

    def clear_session_data(self):
        """Clear wizard data from session"""
        session.pop(self.session_key, None)
        session.modified = True

    def render_wizard_template(self, form=None, widgets=None):
        """Helper method to render wizard template with common context"""

        progress = (self.current_step / self.total_steps) * 100 if self.total_steps > 0 else 0

        context = {
            'form': form,
            'form_title': self.form_title,
            'modelview_name': self.__class__.__name__,
            'current_step': self.current_step,
            'total_steps': self.total_steps,
            'progress': progress,
            'previous_step': self.current_step - 1 if self.current_step > 1 else None,
            'next_step': self.current_step + 1 if self.current_step < self.total_steps else 'submit',
            'step_description': f"Step {self.current_step} of {self.total_steps}",
            'show_progress': self.show_progress,
            'progress_template': self.progress_template,
            'allow_previous': self.allow_previous and self.current_step > 1,
            'is_last_step': self.is_last_step(),
            'is_optional_step': self.is_step_optional(self.current_step),
            'base_template': "appbuilder/base.html",
            'widgets': widgets or {},
            'steps_config': self.steps_config,
            'session_key': self.session_key
        }

        return self.render_template(
            self.form_template,
            **context
        )

        @expose('/step/<int:step>', methods=['GET', 'POST'])
        @has_access
        def step(self, step):
            """Handle individual wizard steps"""
            if not (1 <= step <= self.total_steps):
                flash(_('Invalid step'), 'error')
                return redirect(url_for(f'.step', step=1))  # Redirect to first step instead of this_form_get

            self.current_step = step
            form = self.generate_form(self.current_step)

            if request.method == 'POST':
                if form.validate():
                    self.update_session_data(form)

                    if self.is_last_step():
                        if self.process_final_step():
                            flash(self.success_message, 'info')
                            return self.get_redirect()  # Direct return instead of redirect
                        else:
                            flash(self.error_message, 'error')
                            return self.render_wizard_template(form=form)

                    # Move to next step
                    next_step = self.current_step + 1
                    return redirect(url_for(f'.step', step=next_step))
                else:
                    flash(_('Form validation failed'), 'error')

            # GET request or form validation failed
            return self.render_wizard_template(form=form)


    def generate_form(self, step):
        """Generate a form instance for the current step with enhanced validation"""
        class StepForm(FlaskForm):
            class Meta:
                csrf = True

            def validate(self):
                """Enhanced validation with custom error handling"""
                if not super().validate():
                    # Add form-wide error message if needed
                    if not self.errors.get('_error'):
                        self.errors['_error'] = ['Please correct the highlighted fields below.']
                    return False
                return True

        for column in self.steps_config[step - 1]:
            field_config = self.get_field_config(column)

            if len(field_config) == 6:  # For foreign key fields
                field_type, widget, validators, query_func, label_func, description = field_config
                setattr(StepForm, column['name'], field_type(
                    _(column['name'].capitalize()),
                    query_factory=query_func,
                    get_label=label_func,
                    widget=widget(),
                    validators=validators,
                    description=description
                ))
            elif len(field_config) == 5:  # For fields with choices
                field_type, widget, validators, choices, description = field_config
                setattr(StepForm, column['name'], field_type(
                    _(column['name'].capitalize()),
                    choices=choices,
                    widget=widget(),
                    validators=validators,
                    description=description
                ))
            else:  # For regular fields
                field_type, widget, validators, description = field_config
                setattr(StepForm, column['name'], field_type(
                    _(column['name'].capitalize()),
                    widget=widget(),
                    validators=validators,
                    description=description
                ))

        form = StepForm()
        form.process(request.form)  # Process form data if any
        return form

    def get_field_config(self, column):
        """Configure form field settings based on column definition

        Args:
            column (dict): Column configuration containing type, constraints, etc.

        Returns:
            tuple: Contains field_type, widget, validators, and additional configs
            based on field type (e.g. query functions for foreign keys)
        """
        field_type = StringField
        widget = BS3TextFieldWidget
        validators = []
        description = column.get('description', '')
        is_required = not column.get('nullable', True) or column.get('required', False)

        # Build detailed validation message with required field marker
        required_msg = f"{column['name'].capitalize()} is required"
        if is_required:
            validators.append(DataRequired(message=f"{required_msg} *"))
            description = f"* {description}" if description else "* Required"
        else:
            validators.append(Optional())
            description = f"(Optional) {description}" if description else "(Optional)"

        # Handle foreign keys first with enhanced label handling
        if 'foreign_key' in column:
            field_type = QuerySelectField
            widget = Select2Widget
            ref_table = column['foreign_key'].split('.')[0]
            ref_model = self._get_referenced_model(ref_table)

            def get_query():
                return db.session.query(ref_model).order_by(ref_model.name)

            def get_label(obj):
                # Try common display attributes
                display_attrs = ['display_name', 'name', 'title', 'label',
                               'description', 'id']
                for attr in display_attrs:
                    if hasattr(obj, attr):
                        return getattr(obj, attr)
                return str(obj)

            description = f"{description} (Select from list)"
            return field_type, widget, validators, get_query, get_label, description

        # Enhanced boolean field handling
        if column['type'] == 'Boolean':
            field_type = BooleanField
            widget = CheckboxWidget
            description = f"{description} (Check for Yes)" if description else "Check for Yes"
            return field_type, widget, validators, description

        # Enhanced enum handling with default option
        if column['type'] == 'Enum':
            field_type = SelectField
            widget = Select2Widget
            choices = column.get('choices', [])
            if choices and not is_required:
                choices.insert(0, ('', '-- Select an option --'))
            description = f"{description} (Select one)" if description else "Select one"
            return field_type, widget, validators, choices, description

        # Enhanced length validation
        if 'max_length' in column:
            max_len = column['max_length']
            validators.append(Length(
                max=max_len,
                message=f"{column['name'].capitalize()} must be {max_len} characters or less"
            ))
            description = f"{description} (Max {max_len} characters)"

        # Enhanced numeric field handling
        if column['type'] in ('Integer', 'BigInteger'):
            field_type = IntegerField
            min_val = column.get('min', -2147483648)
            max_val = column.get('max', 2147483647)
            validators.append(NumberRange(
                min=min_val, max=max_val,
                message=f"Enter a number between {min_val} and {max_val}"
            ))
            description = f"{description} (Whole number)" if description else "Enter a whole number"

        elif column['type'] in ('Float', 'Numeric', 'Decimal'):
            field_type = FloatField
            if 'precision' in column:
                description = f"{description} (Number with up to {column['precision']} decimal places)"
            else:
                description = f"{description} (Decimal number)" if description else "Enter a decimal number"

        elif column['type'] == 'Date':
            field_type = DateField
            widget = DatePickerWidget
            description = f"{description} (YYYY-MM-DD)" if description else "Format: YYYY-MM-DD"

        elif column['type'] == 'Text':
            field_type = TextAreaField
            widget = BS3TextAreaFieldWidget
            min_len = column.get('min_length', 0)
            if min_len > 0:
                validators.append(Length(
                    min=min_len,
                    message=f"Must be at least {min_len} characters"
                ))
                description = f"{description} (Min {min_len} characters)"

        # Enhanced email validation
        if 'email' in column['name'].lower():
            validators.append(Email(message="Please enter a valid email address"))
            description = f"{description} (e.g. user@example.com)" if description else "e.g. user@example.com"

        # Enhanced password field
        if 'password' in column['name'].lower():
            widget = BS3PasswordFieldWidget
            validators.extend([
                Length(min=8, message="Password must be at least 8 characters"),
                # Add custom password complexity validator
                validators.Regexp(r'.*[A-Z]', message="Must contain uppercase letter"),
                validators.Regexp(r'.*[a-z]', message="Must contain lowercase letter"),
                validators.Regexp(r'.*[0-9]', message="Must contain number")
            ])
            description = "Must be 8+ chars with upper, lower & number"

        return field_type, widget, validators, description

    def _get_referenced_model(self, table_name):
        """Helper method to get the model class for a given table name"""
        for view in appbuilder.baseviews:
            if hasattr(view, 'datamodel') and hasattr(view.datamodel, 'obj'):
                if view.datamodel.obj.__tablename__ == table_name:
                    return view.datamodel.obj
        raise ValueError(f"Could not find model for table {table_name}")
        def form_get(self, form):
            if 'wizard_data' in session:
                for field in form:
                    if field.name in session['wizard_data']:
                        field.data = session['wizard_data'][field.name]

    def form_post(self, form):
        self.update_session_data(form)

        if self.is_last_step():
            if self.process_final_step():
                flash(self.success_message, 'info')
                return redirect(self.get_redirect())
        else:
            self.next_step()

        return redirect(url_for(self.endpoint))


    def update_session_data(self, form):
        """Update session with form data with improved handling"""
        current_data = self.get_session_data()

        if 'wizard_data' not in session:
            session['wizard_data'] = {}

        form_data = {}
        for field in form:
            if field.name != 'csrf_token':
                # Handle different field types appropriately
                if hasattr(field, 'data'):
                    if isinstance(field.data, (datetime.date, datetime.datetime)):
                        form_data[field.name] = field.data.isoformat() if field.data else None
                    else:
                        form_data[field.name] = field.data if field.data else None
                else:
                    form_data[field.name] = None

        current_data.update(form_data)
        self.save_session_data(current_data)

        # Save last active step
        session[f'{self.session_key}_last_step'] = self.current_step

        session['wizard_data'].update(form_data)
        session.modified = True
        logger.debug(f"Updated session data: {session['wizard_data']}")

    @expose('/', methods=['GET', 'POST'])
    @has_access
    def this_form_get(self):
        """Initial entry point for the wizard"""
        last_step = session.get(f'{self.session_key}_last_step', 1)
        return redirect(url_for(f'{self.endpoint}.wizard', step=last_step))

    def is_last_step(self):
        return self.current_step == self.total_steps

    def process_final_step(self):
        """Process the final step and create database entry"""
        try:
            # Create new instance of the model
            new_item = self.model()

            # Debug logging
            logger.info(f"Processing final step with data: {session.get('wizard_data', {})}")

            # Get wizard data from session
            wizard_data = session.get('wizard_data', {})
            if not wizard_data:
                logger.error("No wizard data found in session")
                return False

            # Set attributes on the model instance
            for key, value in wizard_data.items():
                if hasattr(new_item, key) and key != 'csrf_token':
                    try:
                        setattr(new_item, key, value)
                        logger.debug(f"Set attribute {key}={value}")
                    except Exception as e:
                        logger.error(f"Error setting attribute {key}: {str(e)}")
                        raise

            # Add and commit to database
            db.session.add(new_item)
            db.session.commit()

            # Clear wizard data from session
            session.pop('wizard_data', None)

            logger.info(f"Successfully created new {self.model.__name__} with id {new_item.id}")
            return True

        except Exception as e:
            db.session.rollback()
            logger.error(f"Error saving data: {str(e)}")
            flash(f"Error saving data: {str(e)}", 'error')
            return False

    def next_step(self):
        self.current_step += 1
        if self.enable_conditional_steps:
            self.current_step = self.get_next_step()
        self.form = self.generate_form(self.current_step)

    def previous_step(self):
        if self.allow_previous and self.current_step > 1:
            self.current_step -= 1
            if self.enable_conditional_steps:
                self.current_step = self.get_previous_step()
            self.form = self.generate_form(self.current_step)

    def get_next_step(self):
        # Implement your conditional logic here
        return self.current_step + 1

    def get_previous_step(self):
        # Implement your conditional logic here
        return self.current_step - 1

    def is_step_optional(self, step):
        return self.enable_optional_steps and step in self.optional_steps

    def handle_file_upload(self, file):
        if file and self.allowed_file(file.filename):
            filename = secure_filename(file.filename)
            file_path = os.path.join(self.upload_folder, filename)
            file.save(file_path)
            return file_path
        return None

    def allowed_file(self, filename):
        return '.' in filename and \
               filename.rsplit('.', 1)[1].lower() in self.allowed_extensions

    @expose('/wizard/<int:step>', methods=['GET', 'POST'])
    @has_access
    def wizard(self, step):
        """Handle wizard steps with improved error handling"""
        if not (1 <= step <= self.total_steps):
            flash(_('Invalid step'), 'error')
            return redirect(url_for(f'{self.endpoint}.wizard', step=1))

        self.current_step = step
        form = self.generate_form(self.current_step)

        # Pre-fill form with saved data
        if request.method == 'GET':
            saved_data = self.get_session_data()
            for field in form:
                if field.name in saved_data:
                    field.data = saved_data[field.name]

        if request.method == 'POST':
            if form.validate():
                # Update session with form data
                self.update_session_data(form)

                if self.is_last_step():
                    if self.process_final_step():
                        flash(self.success_message, 'success')
                        # Clear session data after successful processing
                        self.clear_session_data()
                        return self.get_redirect()
                    else:
                        flash(self.error_message, 'error')
                        return self.render_wizard_template(form=form)

                # Move to next step
                next_step = self.current_step + 1
                return redirect(url_for(f'{self.endpoint}.wizard', step=next_step))
            else:
                error_fields = ', '.join(form.errors.keys())
                flash(_(f'Please correct the errors in the following fields: {error_fields}'), 'error')

        return self.render_wizard_template(form=form)

    # Add a method to clear incomplete wizards after a certain time
    def cleanup_old_sessions(self):
        """Clean up old wizard sessions"""
        cleanup_threshold = datetime.utcnow() - timedelta(days=7)  # Adjust as needed
        FlaskSession.query.filter(FlaskSession.modified < cleanup_threshold).delete()
        db.session.commit()

    # Add a method to save progress explicitly
    @expose('/save-progress', methods=['POST'])
    @has_access
    def save_progress(self):
        """Explicitly save current progress"""
        form = self.generate_form(self.current_step)
        if form.validate():
            self.update_session_data(form)
            flash(_('Progress saved successfully'), 'success')
        return redirect(url_for(f'{self.endpoint}.wizard', step=self.current_step))

    # Add a method to resume progress
    @expose('/resume', methods=['GET'])
    @has_access
    def resume_progress(self):
        """Resume from last saved step"""
        last_step = session.get(f'{self.session_key}_last_step', 1)
        return redirect(url_for(f'{self.endpoint}.wizard', step=last_step))

    # Custom action hooks
    def pre_process(self):
        # Implement any pre-processing logic here
        pass

    def post_process(self):
        # Implement any post-processing logic here
        pass

    def get_redirect(self):
        """Return the redirect URL after successful completion"""
        try:
            return redirect(url_for('{{ table_name.lower() }}.list'))
        except Exception as e:
            logger.error(f"Error in redirect: {str(e)}")
            return redirect(url_for(f'{self.endpoint}.wizard', step=1))

    @expose('/debug', methods=['GET'])
    @has_access
    def debug_session(self):
        """Debug endpoint to view session data"""
        return str(session.get('wizard_data', {}))

