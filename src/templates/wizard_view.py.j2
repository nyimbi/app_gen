    error_message = _("An error occurred while processing your request.")
    steps_config = {{ steps }}  # List of lists, each inner list represents a step

    allow_previous = {{ config.get("allow_previous", True) if config else True }}
    show_progress = {{ config.get("show_progress", True) if config else True }}
    progress_template = '{{ config.get("progress_template", "wizard_progress.html") if config else "wizard_progress.html" }}'
    enable_file_upload = {{ config.get("enable_file_upload", False) if config else False }}
    upload_folder = '{{ config.get("upload_folder", "uploads/") if config else "uploads/" }}'
    allowed_extensions = {{ config.get("allowed_extensions", ["txt", "pdf", "png", "jpg", "jpeg", "gif"]) if config else ["txt", "pdf", "png", "jpg", "jpeg", "gif"] }}
    max_content_length = {{ config.get("max_content_length", 16 * 1024 * 1024) if config else 16 * 1024 * 1024 }}
    enable_optional_steps = {{ config.get("enable_optional_steps", False) if config else False }}
