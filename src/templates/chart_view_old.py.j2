log = logging.getLogger(__name__)

class {{ table_name|capitalize }}ChartView(ChartView):
    datamodel = SQLAInterface({{ table_name|capitalize }})
    endpoint = "{{ table_name|capitalize }}"
    route_base = "/{{ table_name|capitalize }}"
    chart_title = _("{{ table_name|capitalize }} Statistics")
    chart_type = "PieChart"
    chart_3d = True
    custom_template = ""
    default_view = "chart"
    chart_template = "chart_widget.html"

    # Define group by columns
    group_by_columns = ['{{ date_columns[0].name }}']

    # Define chart series
    definitions = [
        {
            "group": "{{ date_columns[0].name }}",
            "formatter": lambda x: x.strftime("%Y-%m-%d") if x else "Unknown",
            "series": [(aggregate_count, "id")]
        }
    ]

    # Add formatters
    formatters_columns = {
        "{{ date_columns[0].name }}": lambda x: x.strftime("%Y-%m-%d") if x else "Unknown",
        "count": lambda x: f"{x:,.0f}"
    }

    label_columns = {
        "{{ date_columns[0].name }}": _("Date"),
        "count": _("Total Count")
    }

    # Remove the problematic base_filters and handle NULL values in get_data
    # base_filters = [['{{ date_columns[0].name }}', 'is not', None]]  # Remove this line

    # Chart layout configuration
    chart_width = 400
    chart_height = 400
    chart_orientation = "horizontal"

    # Search columns for filtering
    search_columns = ["{{ date_columns[0].name }}"]

    # Base order
    base_order = ("{{ date_columns[0].name }}", "asc")

    def __init__(self, **kwargs):
        """Initialize the chart view"""
        super({{ table_name|capitalize }}ChartView, self).__init__(**kwargs)
        self.title = _("{{ table_name|capitalize }} Statistics")


    def chart(self):
        try:
            query = self.datamodel.session.query(
                case(
                    (self.datamodel.obj.{{ date_columns[0].name }}.isnot(None),
                     func.date_trunc('day', self.datamodel.obj.{{ date_columns[0].name }})),
                    else_=None
                ).label('date'),
                func.count(self.datamodel.obj.id).label('count')
            ).group_by(
                case(
                    (self.datamodel.obj.{{ date_columns[0].name }}.isnot(None),
                     func.date_trunc('day', self.datamodel.obj.{{ date_columns[0].name }})),
                    else_=None
                )
            )

            results = query.all()

            chart_data = []
            for result in results:
                date_val = result.date
                count_val = result.count

                formatted_date = "Unknown" if date_val is None else date_val.strftime("%Y-%m-%d")
                chart_data.append({
                    'name': formatted_date,
                    'value': count_val
                })

            chart_data.sort(key=lambda x: (x['name'] == "Unknown", x['name']))

            chart_options = {
                "colors": ["#3366CC", "#DC3912", "#FF9900", "#109618", "#990099"],
                "legend": {"position": "bottom"},
                "tooltip": {"trigger": "selection"},
                "height": 400,
                "width": 600,
                "is3D": True,
                "pieHole": 0.4,
                "sliceVisibilityThreshold": 0.01,
                "chartArea": {
                    "left": 50,
                    "top": 50,
                    "width": "90%",
                    "height": "80%"
                }
            }

            return render_template(
                self.chart_template,
                chart_title=self.chart_title,
                chart_type=self.chart_type,
                data=chart_data,
                chart_options=chart_options
            )

        except Exception as e:
            log.error(f"Error in chart view: {str(e)}")
            return render_template(
                self.chart_template,
                chart_title=self.chart_title,
                error=_("Error loading chart data")
            )

    def query_transform(self, query):
        """Transform the query to handle NULL values"""
        return query.filter(or_(
            self.datamodel.obj.{{ date_columns[0].name }}.isnot(None),
            self.datamodel.obj.{{ date_columns[0].name }}.is_(None)
        ))

    def get_data(self):
        """Custom data retrieval method with NULL handling"""
        try:
            query = self.datamodel.session.query(
                case(
                    (self.datamodel.obj.{{ date_columns[0].name }}.isnot(None),
                     self.datamodel.obj.{{ date_columns[0].name }}),
                    else_="Unknown"
                ).label('{{ date_columns[0].name }}'),
                func.count(self.datamodel.obj.id).label('count')
            ).group_by(
                case(
                    (self.datamodel.obj.{{ date_columns[0].name }}.isnot(None),
                     self.datamodel.obj.{{ date_columns[0].name }}),
                    else_="Unknown"
                )
            ).order_by(
                case(
                    (self.datamodel.obj.{{ date_columns[0].name }}.isnot(None),
                     self.datamodel.obj.{{ date_columns[0].name }}),
                    else_="Unknown"
                )
            )

            results = query.all()

            data = []
            for result in results:
                date_val = result[0]
                count_val = result[1]

                # Format date if it's not "Unknown"
                formatted_date = (
                    date_val.strftime("%Y-%m-%d")
                    if isinstance(date_val, (datetime.date, datetime.datetime))
                    else str(date_val)
                )

                data.append({
                    'name': formatted_date,
                    'value': count_val
                })

            return data

        except Exception as e:
            current_app.logger.error(f"Error getting chart data: {str(e)}")
            return []

    chart_options = {
        "colors": ["#3366CC", "#DC3912", "#FF9900", "#109618", "#990099"],
        "legend": {"position": "bottom"},
        "tooltip": {"trigger": "selection"},
        "height": 400,
        "width": 600,
        "is3D": True,
        "pieHole": 0.4,
        "sliceVisibilityThreshold": 0.01,
        "chartArea": {
            "left": 50,
            "top": 50,
            "width": "90%",
            "height": "80%"
        }
    }


    def pre_process_data(self, data):
        """Pre-process data with better error handling"""
        try:
            processed_data = []
            for item in data:
                if item and isinstance(item, dict):
                    name = str(item.get('name', 'Unknown'))
                    value = float(item.get('value', 0))
                    processed_data.append({
                        'name': name,
                        'value': value
                    })
            return processed_data or []
        except Exception as e:
            current_app.logger.error(f"Error pre-processing data: {str(e)}")
            return []


