{% if not single_file %}
from flask_appbuilder.charts.views import ChartView
from flask_appbuilder.models.sqla.interface import SQLAInterface
from flask_appbuilder.models.group import aggregate_sum, aggregate_count, aggregate_avg
from flask_babel import lazy_gettext as _
from . import appbuilder
from .models import {{ table_name|capitalize }}
{% endif %}

class {{ table_name|capitalize }}ChartView(ChartView):
    datamodel = SQLAInterface({{ table_name|capitalize }})
    chart_title = _("{{ table_name|capitalize }} Statistics")
    chart_type = "PieChart"
    chart_3d = True
    
    definitions = [
        {
            "group": "{{ date_columns[0].name }}",
            "series": [(aggregate_count, "{{ numeric_columns[0].name }}")],
        }
    ]

    label_columns = {
        "{{ date_columns[0].name }}": _("Date"),
        "{{ numeric_columns[0].name }}": _("Count"),
    }

    # Chart layout configuration
    chart_width = 400
    chart_height = 400
    chart_orientation = "horizontal"

    # Search columns for filtering
    search_columns = ["{{ date_columns[0].name }}", "{{ numeric_columns[0].name }}"]

    # Base query for data retrieval
    base_order = ("{{ date_columns[0].name }}", "asc")
    base_filters = [["{{ numeric_columns[0].name }}", ">", 0]]

    # Custom method for data processing
    def get_data(self):
        data = super().get_data()
        # Add custom data processing logic here
        return data

    # Additional chart options
    chart_options = {
        "colors": ["#FF0000", "#00FF00", "#0000FF"],  # Custom color scheme
        "legend": {"position": "bottom"},
        "tooltip": {"trigger": "selection"},
    }

    # Time series configuration
    chart_time_series = True
    chart_time_series_format = "%Y-%m-%d"

    # Specific configurations for different chart types
    # Uncomment and modify as needed

    # # Pie Chart specific options
    # chart_type = "PieChart"
    # chart_3d = True
    # pie_chart_options = {
    #     "pieHole": 0.4,
    #     "slices": {
    #         0: {"offset": 0.2},
    #         1: {"offset": 0.1},
    #     },
    # }

    # # Bar Chart specific options
    # chart_type = "BarChart"
    # chart_is_stacked = True
    # bar_chart_options = {
    #     "bars": "horizontal",
    #     "isStacked": True,
    # }

    # # Line Chart specific options
    # chart_type = "LineChart"
    # line_chart_options = {
    #     "curveType": "function",
    #     "pointSize": 5,
    # }

    # Export functionality
    enable_export = True
    export_formats = ["csv", "xlsx", "pdf"]

{% if not single_file %}
# Register the ChartView with AppBuilder
appbuilder.add_view(
    {{ table_name|capitalize }}ChartView,
    "{{ table_name|capitalize }} Charts",
    icon="{{ config.get('icon', 'fa-bar-chart') }}",
    category="Charts",
    category_icon="fa-chart-pie"
)
{% endif %}

